# Unreal and art binaries go through Git LFS (plan §7, M2), configured before the first one is
# committed. Images and videos under assets/ (screenshots, demo recordings) stay in plain git.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
art/**/*.png filter=lfs diff=lfs merge=lfs -text
art/**/*.tga filter=lfs diff=lfs merge=lfs -text
art/**/*.exr filter=lfs diff=lfs merge=lfs -text
art/**/*.psd filter=lfs diff=lfs merge=lfs -text
art/**/*.tif filter=lfs diff=lfs merge=lfs -text

# The generated C header is compared byte for byte by a test; keep its line ends as generated.
kernel/crates/civ-ffi/include/tce_kernel.h text eol=lf
