// The Civilization Engine save schema: payloads of commons-persist sections (ADR-0002).
//
// This is the durable world model, deliberately separate from the boundary schema: it stores
// authoritative state only. Derived data (drainage area, presentation shading, geometry) is
// rebuilt on load. Same evolution rules as tce_wire.fbs; a section's version in the container
// manifest names the encoding of its payload.

namespace tce.save;

// Section "meta": who and what this world is, and how it was made.
table Param {
  name: string (id: 0);
  value: double (id: 1);
}

table Meta {
  world_name: string (id: 0);
  seed: ulong (id: 1);
  preset_id: string (id: 2);
  generator_version: uint (id: 3);
  width: uint (id: 4);
  height: uint (id: 5);
  cell_size_m: float (id: 6);
  sea_level_m: float (id: 7);
  created_unix_ms: long (id: 8);
  // Effective generation parameters, by name (provenance; terrain is not regenerated from them).
  params: [Param] (id: 9);
  precipitation_mm_per_yr: float (id: 10);
  evapotranspiration_mm_per_yr: float (id: 11);
  lake_evaporation_mm_per_yr: float (id: 12);
  // Schema 12 (M3a slice K, ADR-0007): the content id of the world's property regime (absent in
  // older saves, which load under the content's default regime).
  regime_id: string (id: 13);
}

// Section "clock": simulation time and the scheduler's state.
table Clock {
  minute: long (id: 0);
  paused: bool (id: 1);
  speed: float (id: 2);
  scheduler_seq: ulong (id: 3);
  tiebreak_state: [ulong] (id: 4);
  next_permanent_id: ulong (id: 5);
}

// Section "content": what content the world was made with.
table Pack {
  id: string (id: 0);
  version: string (id: 1);
  artifact_fingerprint: [ubyte] (id: 2);
}

table Content {
  fingerprint: [ubyte] (id: 0);
  packs: [Pack] (id: 1);
}

// Section "raster", one chunk per tile and layer.
enum Layer : ubyte { Elevation = 0, Receivers = 1, Water = 2, LakeId = 3 }

table RasterTile {
  layer: Layer (id: 0);
  x0: uint (id: 1);
  y0: uint (id: 2);
  width: uint (id: 3);
  height: uint (id: 4);
  // Little-endian samples, row-major: f32 elevation, u8 receivers, u8 water, u32 lake ids.
  data: [ubyte] (id: 5);
}

// Section "hydro": lakes, river reaches and boundary inflows.
table Lake {
  id: uint (id: 0);
  level_m: float (id: 1);
  spill_m: float (id: 2);
  closed: bool (id: 3);
  cell_count: uint (id: 4);
  area_m2: double (id: 5);
  volume_m3: double (id: 6);
  catchment_m2: double (id: 7);
  // -1 = none.
  outlet_cell: long (id: 8);
  centroid_x_m: float (id: 9);
  centroid_y_m: float (id: 10);
}

enum Terminus : ubyte { Junction = 0, Lake = 1, Outlet = 2, Sink = 3 }

table Reach {
  id: uint (id: 0);
  cells: [uint] (id: 1);
  // -1 = none.
  downstream: long (id: 2);
  terminus: Terminus (id: 3);
  terminus_lake: uint (id: 4);
  order: ubyte (id: 5);
  discharge_m3s: float (id: 6);
  width_m: float (id: 7);
  drainage_area_km2: float (id: 8);
}

table Inflow {
  cell: uint (id: 0);
  area_m2: double (id: 1);
}

table Hydro {
  lakes: [Lake] (id: 0);
  reaches: [Reach] (id: 1);
  inflows: [Inflow] (id: 2);
}

// ---- People and land (ADR-0003, ADR-0004; schema versions 2 to 4) -------------------------
//
// Permanent ids are ulong, 0 meaning "none". Times are minutes since the calendar origin.
// Activities, resources and goods are referred to by content id through a per-section dictionary,
// so a world still loads after content adds, removes or reorders them. Fields marked "schema 2"
// are written by schema-2 saves only and read to migrate them; fields marked "schema 3" are new
// in version 3 (M1 slice B: goods), "schema 4" in version 4 (M1 slice C: fields).

struct Point {
  x: float;
  y: float;
}

// Section "land": the habitat patch grid and its wild stocks.
table Land {
  cols: uint (id: 0);
  rows: uint (id: 1);
  patch_cells: uint (id: 2);
  cell_size_m: float (id: 3);
  // Habitat ids at save time; `class` indexes this list.
  habitats: [string] (id: 4);
  class: [ubyte] (id: 5);
  richness: [float] (id: 6);
  // Resource ids at save time; `stocks` holds one run of patches per resource, in this order.
  resources: [string] (id: 7);
  stocks: [float] (id: 8);
  stock_day: long (id: 9);
  // Before schema 24: the yearly climate factor, its year and its standard-normal deviate. Not
  // written since; an older save's weather starts with the deviate as its slow anomaly.
  climate_year: long (id: 10);
  climate_deviate: double (id: 11);
  climate_factor: double (id: 12);
  // Schema 3: the good and the kilograms of it per unit of each saved resource, in the order of
  // `resources`. A resource's stocks carry over only if both are unchanged; otherwise its units
  // may mean something else, and it starts at equilibrium.
  resource_goods: [string] (id: 13);
  resource_unit_kg: [double] (id: 14);
  // Schema 24 (M3c slice U, ADR-0012 §1): the weather. Absent in older saves, whose weather
  // starts from `climate_deviate` with the soil at field capacity and no snow.
  weather: Weather (id: 15);
  // Schema 72 (M6a slice AY, ADR-0021 §2): water under the ground and the rivers' runoff store.
  // Absent in older saves, whose heads are settled where the landscape's mean recharge holds
  // them, the store holding what that mean keeps in it.
  water: Groundwater (id: 16);
}

// Schema 72: the water table's head in each patch, metres, in the patches' order, and the water
// in the runoff store after the day's outflow, mm over the map's land.
table Groundwater {
  heads: [double] (id: 0);
  runoff_mm: double (id: 1);
}

// Schema 24 (ADR-0012 §1): one day's weather at the height the normals are for.
table WeatherDay {
  day: long (id: 0);
  // The day is wet (the chain's state).
  wet: bool (id: 1);
  // Rain and snow, mm of water.
  precip_mm: float (id: 2);
  mean_c: float (id: 3);
  min_c: float (id: 4);
  max_c: float (id: 5);
  // Schema 87 (M6b slice BC; ADR-0022 §2): the day's mean wind, m/s, the direction it blows
  // from (degrees clockwise from north), its strongest gust, m/s, and the water exposed fuel
  // holds as a share of its dry mass. All 0 before: they are drawn afresh on loading.
  wind_ms: float (id: 6);
  wind_from_deg: float (id: 7);
  gust_ms: float (id: 8);
  fuel_moisture: float (id: 9);
}

// Schema 24: one month's weather as it was, at the height the normals are for.
table WeatherMonth {
  year: long (id: 0);
  // 0 for January.
  month: ubyte (id: 1);
  // Days recorded; the last month of the list is the month in progress.
  days: ubyte (id: 2);
  precip_mm: float (id: 3);
  wet_days: ubyte (id: 4);
  // The days' mean temperatures summed, °C.
  temp_sum_c: float (id: 5);
  min_c: float (id: 6);
  max_c: float (id: 7);
  frost_days: ubyte (id: 8);
  snow_days: ubyte (id: 9);
  // The reference soil's water as a share of what it holds, summed over the days.
  soil_sum: float (id: 10);
  // Schema 84 (M6a slice BA, step five; ADR-0021 §8): the observer's drought held its weather
  // on one of its days.
  held: bool (id: 11);
}

// Schema 24: the weather's state. Today's weather (the day after the land's last), what
// tomorrow depends on, snow lying in bands of 100 m, the soil under the wild cover, and each
// month's record.
table Weather {
  today: WeatherDay (id: 0);
  // Today's temperature anomaly and this month's slow anomaly, in standard deviations.
  anomaly: double (id: 1);
  slow: double (id: 2);
  // Bottom of the lowest snow band, metres, and the snow lying in each band, mm of water.
  snow_base_m: float (id: 3);
  snow_mm: [float] (id: 4);
  // Water in the reference soil, mm, and the wild cover's ease of drawing it, smoothed.
  soil_mm: double (id: 5);
  cover_ease: double (id: 6);
  months: [WeatherMonth] (id: 7);
  // Schema 84: the observer's drought, the slow anomaly held at `hold_slow` until day
  // `hold_until` (not including it); 0 (and absent before) when none holds.
  hold_slow: double (id: 8);
  hold_until: long (id: 9);
  // Schema 87: today's wind along and across the prevailing direction, as anomalies in standard
  // deviations (0 before).
  wind_along: double (id: 10);
  wind_across: double (id: 11);
  // Schema 170 (M9c slice DM, ADR-0032 §9): the observer's forcings on the climate, in the order
  // set (none before).
  forcings: [ClimateForcing] (id: 12);
}

// Schema 170: an offset to every temperature normal, °C, and a factor on wet days' amounts, each
// reached linearly over `ramp_days` from `from_day` and held after.
table ClimateForcing {
  from_day: long (id: 0);
  ramp_days: long (id: 1);
  offset_c: double (id: 2);
  wet_factor: double (id: 3);
}

// Section "settle": settlements.
table Settlement {
  id: ulong (id: 0);
  name: string (id: 1);
  founded: long (id: 2);
  hearth: Point (id: 3);
  // Schema 3: its food has run short and not yet recovered (for the chronicle).
  food_short: bool (id: 4);
  // Schema 4: grain threshed from its fields since its last harvest was noted, kilograms.
  harvest_kg: double (id: 5);
  // Schema 50 (ADR-0018 §1): the settlement its founders came from (0: none), how it was founded
  // (civ_land::Founding's code; 255 in older saves, where the first settlement was the founding
  // band's and any later one a family the observer sent), and when it was abandoned.
  parent: ulong (id: 6);
  founding: ubyte = 255 (id: 7);
  abandoned: bool (id: 8);
  abandoned_at: long (id: 9);
}

table Settlements {
  settlements: [Settlement] (id: 0);
}

// Section "people": living people and what they are doing.
// Field (schema 4) names a field by `target_id`; NewField is new ground weighed in a decision.
// Building (schema 5) names a building by `target_id`; NewBuilding is a home not yet begun,
// weighed in a decision.
// Schema 14 adds Technique: the technique a session of trying works toward, by index into
// People.techniques (in a decision receipt, into the content's techniques when it was saved).
// Douse (schema 91, M6b slice BD, step three): `index` where the water is drawn (a source's cell,
// or 4294967295 the household's store), `id` the building it is thrown on.
enum TargetKind : ubyte { None = 0, Home = 1, Hearth = 2, Patch = 3, Water = 4, Field = 5, NewField = 6, Household = 7, Building = 8, NewBuilding = 9, Firm = 10, NewFirm = 11, Technique = 12, Deposit = 13, Crossing = 14, Well = 15, Douse = 16, Bank = 17, Ditch = 18, Enclosure = 19, Boat = 20, Way = 21, Mill = 22 }

// Schema 185 (M10b slice DX, fourth part): Ride, a ride on a line's train to its end at `cell`.
enum StepKind : ubyte { Walk = 0, Work = 1, Deposit = 2, Wait = 3, Paddle = 4, Handle = 5, Haul = 6, Ride = 7 }

table Step {
  kind: StepKind (id: 0);
  // Walk destination; schema 145 (M8b slice CP): a haul's door.
  to: Point (id: 1);
  // Work or wait length.
  minutes: uint (id: 2);
  // Schema 143 (M8b slice CO): a paddle's bank cell; a handling's unloading.
  cell: uint (id: 3);
  unload: bool (id: 4);
}

table Activity {
  // Index into People.activities.
  def: uint (id: 0);
  target_kind: TargetKind (id: 1);
  target_index: uint (id: 2);
  steps: [Step] (id: 3);
  step: ubyte (id: 4);
  started: long (id: 5);
  step_started: long (id: 6);
  step_ends: long (id: 7);
  version: uint (id: 8);
  // Schema 4: the permanent id a Field target names.
  target_id: ulong (id: 9);
}

// Schema 141 (M8b slice CN, ADR-0029 §4): the next bottleneck a walk reaches. `kind` 0 a
// crossing (`id` its id), 1 a gate (`id` its enclosure, `sector` its sector); `dir` the way it
// is passed (2 one file shared both ways); where its approach is reached, metres, and when,
// minutes after setting off; the polyline point after which; a point just inside it; and the
// seconds between walkers that way.
table TripAheadSave {
  kind: ubyte (id: 0);
  id: ulong (id: 1);
  sector: ushort (id: 2);
  dir: ubyte (id: 3);
  x: float (id: 4);
  y: float (id: 5);
  at_min: float (id: 6);
  seg: uint (id: 7);
  ix: float (id: 8);
  iy: float (id: 9);
  headway_s: float (id: 10);
}

table Trip {
  id: ulong (id: 0);
  rev: uint (id: 1);
  depart: long (id: 2);
  points: [Point] (id: 3);
  minutes: [float] (id: 4);
  ahead: TripAheadSave (id: 5);
  // Schema 143 (M8b slice CO): gone by boat.
  afloat: bool (id: 6);
}

enum Sex : ubyte { Female = 0, Male = 1 }

// Schema 6: where a woman is in the reproductive cycle.
enum Repro : ubyte { Open = 0, Pregnant = 1, Recovering = 2 }

table Person {
  id: ulong (id: 0);
  given: string (id: 1);
  sex: Sex (id: 2);
  born: long (id: 3);
  mother: ulong (id: 4);
  father: ulong (id: 5);
  household: ulong (id: 6);
  // Openness, conscientiousness, extraversion, agreeableness, neuroticism, risk.
  traits: [float] (id: 7);
  pos: Point (id: 8);
  energy_kcal: float (id: 9);
  satiety_until: long (id: 10);
  sleep_pressure: float (id: 11);
  relatedness: float (id: 12);
  needs_at: long (id: 13);
  burn_kcal_min: float (id: 14);
  asleep: bool (id: 15);
  company: float (id: 16);
  activity: Activity (id: 17);
  // Absent while not walking.
  trip: Trip (id: 18);
  // Schema 2: food carried, kcal.
  carry_food_kcal: float (id: 19);
  carry_water_l: float (id: 20);
  draws: ulong (id: 21);
  // Schema 3: the good carried, as an index into People.goods, or -1; and how much, kilograms.
  carry_good: int = -1 (id: 22);
  carry_kg: float (id: 23);
  // Schema 6: their partner (0 = none); a woman's place in the reproductive cycle (pregnant
  // since `conceived` by `pregnancy_father` (0 = unknown), ending at `repro_until` in a loss if
  // `loss`; or recovering until `repro_until`); her lasting fecundability; the child she nurses
  // (0 = none).
  partner: ulong (id: 24);
  repro: Repro (id: 25);
  conceived: long (id: 26);
  repro_until: long (id: 27);
  pregnancy_father: ulong (id: 28);
  loss: bool (id: 29);
  fecundity: float = 1.0 (id: 30);
  nursing: ulong (id: 31);
  // Schema 9: skill levels, 0-1, by index into People.skills; skills never practised are absent.
  skills: [SkillLevel] (id: 32);
  // Schema 13: what they know, are learning or have heard of (ADR-0008 §2).
  knows: [Knowing] (id: 33);
  // Schema 14: when their last session of trying toward a technique ended (-1 = never).
  tried: long = -1 (id: 34);
  // Schema 31: their objection to taking, 0-1, and the chance they believe a taker runs of being
  // seen, 0-1 (ADR-0015 §2). -1: not kept (an older save); drawn and set on load.
  objection: float = -1.0 (id: 35);
  risk_seen: float = -1.0 (id: 36);
  // The household whose store they last turned back or fled from (0 = none), and until when they
  // wait before weighing taking again (minutes).
  guarded: ulong (id: 37);
  guarded_at: long (id: 38);
}

// Schema 13: what a person knows of one technique, by index into People.techniques. `known`:
// they can do and teach it; otherwise `hours` learnt so far (0: only heard of it). `source`: 0
// brought it, 1 brought up with it by `source_person`, 2 taught by `source_person`, 3 found it,
// 4 introduced by the observer.
struct Knowing {
  since: long;
  used: long;
  source_person: ulong;
  hours: float;
  technique: ushort;
  known: bool;
  source: ubyte;
}

// Schema 9: a person's level in one skill.
struct SkillLevel {
  skill: ushort;
  level: float;
}


table People {
  // Activity content ids at save time; Activity.def indexes this list.
  activities: [string] (id: 0);
  people: [Person] (id: 1);
  // The last trip id handed out.
  next_trip: ulong (id: 2);
  // Schema 3: good content ids at save time; Person.carry_good indexes this list.
  goods: [string] (id: 3);
  // Schema 9: skill content ids at save time; SkillLevel.skill indexes this list.
  skills: [string] (id: 4);
  // Schema 13: technique content ids at save time; Knowing.technique indexes this list.
  techniques: [string] (id: 5);
}

// Section "houses": households.
// Schema 2: a patch's remembered return of the one gathered resource (forgotten on migration:
// its units no longer apply).
struct KnownPatch {
  patch: uint;
  rate: float;
  seen_day: long;
}

// Schema 3: what was seen of a place where a resource is gathered (an index into
// Households.resources): the mean return of the hours worked there, and those hours as of the
// last visit.
struct KnownResource {
  seen_day: long;
  patch: uint;
  rate: float;
  hours: float;
  resource: ushort;
}

table Household {
  id: ulong (id: 0);
  members: [ulong] (id: 1);
  home: Point (id: 2);
  settlement: ulong (id: 3);
  // Schema 2: the household's food, kcal.
  food_kcal: double (id: 4);
  water_l: double (id: 5);
  water_at: long (id: 6);
  // Schema 2.
  known: [KnownPatch] (id: 7);
  // Schema 3: goods in store at `stores_at`, kilograms, indexed like Households.goods.
  stores: [double] (id: 8);
  stores_at: long (id: 9);
  known_resources: [KnownResource] (id: 10);
  // Schema 10: what the household offers, and on what terms.
  offers: [Offer] (id: 11);
  // Schema 22 (M3b slice R): its taste in building, roof pitch in hundredths of a degree and
  // eaves and overhang in centimetres, and the building that moved it most (0 for none).
  taste: [float] (id: 12);
  admired: ulong (id: 13);
  // Schema 27 (M3c slice V): its midden, kilograms as it stood at `midden_at`. Absent in older
  // saves: begun empty when the save is loaded.
  midden_kg: double (id: 14);
  midden_at: long (id: 15);
  // Schema 73 (M6a slice AY, ADR-0021 §1): litres each of its people uses a day, set by the walk
  // to the water they last fetched; 0 (and absent in older saves) for the people profile's.
  water_use_l: double (id: 16);
  // Schema 83 (M6a slice BA, step four): minutes of the walk from home to the water its people
  // last fetched, one way; 0 (and absent in older saves) until they fetch again.
  water_walk_min: float (id: 17);
  // Schema 93 (M6b slice BF, ADR-0022 §13): memory of deepest water at home and fields (cm) and day.
  flood_home_cm: ushort (id: 18);
  flood_field_cm: ushort (id: 19);
  flood_day: long (id: 20);
  // Schema 102 (M6b slice BG): what floods cost the household itself, as it saw, oldest first;
  // absent before.
  flood_losses: [FloodLossSave] (id: 21);
  // Schema 106 (M6b slice BG): what each hour of digging its ditch is worth to it; 0 before.
  ditch_worth: float (id: 22);
  // Schema 107 (M6b slice BH): buildings it lost to fire or its people saw burn, oldest first;
  // absent before.
  fire_losses: [FireLossSave] (id: 23);
  // Schema 108 (M6b slice BH): buildings of its settlement it heard gave way, oldest first;
  // absent before.
  gave_way: [GaveWaySave] (id: 24);
  // Schema 171 (M10a slice DP): batches it started that run unattended, oldest first; absent
  // before.
  batches: [BatchSave] (id: 25);
  // Schema 174 (M10a slice DR): what it had made by water-powered ways' outputs when it last
  // weighed a mill; absent before its first review.
  mill_seen: MillSeenSave (id: 26);
  // Schema 205 (M10c slice EE, third part): the day its midden was last carried from the water
  // under a law clearing middens (-1 never), and where to, metres.
  midden_carried: long = -1 (id: 27);
  midden_x: float (id: 28);
  midden_y: float (id: 29);
}

// A household's count at a mill review (schema 174): the day and the kilograms it had made in
// all its years of the goods a water-powered way makes.
table MillSeenSave {
  day: long (id: 0);
  kg: double (id: 1);
}

// A batch a household started (schema 171, M10a slice DP): its recipe by content id, the units
// started, the worth of the tools it makes in standard tools each, and the first day it may be
// opened. Its inputs were taken when it was started.
table BatchSave {
  recipe: string (id: 0);
  units: double (id: 1);
  quality: double (id: 2);
  ends_day: long (id: 3);
}

// A building a household heard gave way (schema 108, M6b slice BH): the day, the building,
// whether it was the household's own, the kind of its walls, and the work putting it right
// would take (hours).
table GaveWaySave {
  day: long (id: 0);
  building: ulong (id: 1);
  own: bool (id: 2);
  wall_kind: ubyte (id: 3);
  hours: float (id: 4);
  // Its storeys and whether its mass walls were tied at each floor (schema 163, M8d slice DB);
  // before, a storey untied.
  storeys: ubyte = 1 (id: 5);
  tied: bool (id: 6);
}

// A building a household lost to fire or saw burn (schema 107, M6b slice BH): the day the fire
// burnt out, the building, whether it was the household's own and whether its roof burns, and
// the work putting it right would take (hours).
table FireLossSave {
  day: long (id: 0);
  building: ulong (id: 1);
  own: bool (id: 2);
  burnable: bool (id: 3);
  hours: float (id: 4);
}

// One day's loss to a flood at one place of a household's own (schema 102, M6b slice BG): the
// day, the cell the water stood in, how deep (cm), the food lost (kcal) and the work lost (hours).
table FloodLossSave {
  day: long (id: 0);
  cell: uint (id: 1);
  depth_cm: ushort (id: 2);
  kcal: float (id: 3);
  hours: float (id: 4);
}

// Schema 10: one row of a household's posted terms (ADR-0006 §4). Goods are indexed like
// Households.goods.
table Offer {
  good: uint (id: 0);
  payment: uint (id: 1);
  // Units of the payment asked for a unit of the good.
  price: float (id: 2);
  // Units of the good offered.
  units: float (id: 3);
  // What a unit is worth to the seller behind these terms, hours of its own work.
  ask_h: float (id: 4);
}

table Households {
  households: [Household] (id: 0);
  // Schema 3: good and resource content ids at save time.
  goods: [string] (id: 1);
  resources: [string] (id: 2);
}

// Section "history": everyone who ever lived here, and the chronicle. Kept forever.
enum Origin : ubyte { Founder = 0, Born = 1, Spawned = 2 }

// Collapse (3): a building gave way around them (slice P's second step, ADR-0009 §5).
// Schema 88 (M6b slice BC): Burned, caught asleep in a building fully involved.
enum Cause : ubyte { Unspecified = 0, Starvation = 1, Childbirth = 2, Collapse = 3, Violence = 4, Fell = 5, Disease = 6, Burned = 7 }

table PersonRecord {
  id: ulong (id: 0);
  given: string (id: 1);
  sex: Sex (id: 2);
  born: long (id: 3);
  died: bool (id: 4);
  died_at: long (id: 5);
  cause: Cause (id: 6);
  mother: ulong (id: 7);
  father: ulong (id: 8);
  origin: Origin (id: 9);
  // Schema 6: they left the world alive (their household gave up and left the valley).
  left: bool (id: 10);
  left_at: long (id: 11);
  // Schema 50 (ADR-0018 §2): where they have lived, oldest first. Older saves have none; they
  // are inferred as the world loads.
  residence: [Stay] (id: 12);
}

// One stay in someone's residence history (schema 50).
table Stay {
  // The settlement (0: off the map).
  settlement: ulong (id: 0);
  since: long (id: 1);
  // civ_agents::ResidenceWhy's code.
  why: ubyte (id: 2);
}

table ChronicleEntry {
  seq: ulong (id: 0);
  at: long (id: 1);
  // civ_agents::ChronicleKind, numbered append-only.
  kind: ushort (id: 2);
  people: [ulong] (id: 3);
  settlement: ulong (id: 4);
  has_place: bool (id: 5);
  place: Point (id: 6);
  number: double (id: 7);
  name: string (id: 8);
  // Schema 11: the firm the entry is about (0 = none).
  firm: ulong (id: 9);
}

// Schema 6: a couple, kept forever.
table Union {
  woman: ulong (id: 0);
  man: ulong (id: 1);
  since: long (id: 2);
  ended: bool (id: 3);
  ended_at: long (id: 4);
}

table History {
  records: [PersonRecord] (id: 0);
  chronicle: [ChronicleEntry] (id: 1);
  // Schema 6: every couple there has been, oldest first.
  unions: [Union] (id: 2);
}

// Section "receipts": why people chose what they did, a bounded ring per person.
struct Term {
  reason: ushort;
  points: float;
}

table Scored {
  // Index into Receipts.activities.
  def: uint (id: 0);
  target_kind: TargetKind (id: 1);
  target_index: uint (id: 2);
  total: float (id: 3);
  terms: [Term] (id: 4);
  // Schema 4: the permanent id a Field target names.
  target_id: ulong (id: 5);
}

struct OtherOption {
  def: uint;
  total: float;
}

struct Exclusion {
  def: uint;
  reason: ushort;
}

table Receipt {
  at: long (id: 0);
  chosen: Scored (id: 1);
  runner_up: Scored (id: 2);
  others: [OtherOption] (id: 3);
  excluded: [Exclusion] (id: 4);
  probability: float (id: 5);
  temperature: float (id: 6);
  // Hunger, sleep drive, loneliness, days of food, days of water.
  needs: [float] (id: 7);
}

table PersonReceipts {
  person: ulong (id: 0);
  receipts: [Receipt] (id: 1);
}

table Receipts {
  // Activity content ids at save time.
  activities: [string] (id: 0);
  people: [PersonReceipts] (id: 1);
}

// Section "fields" (schema 4): ground households work for a crop (ADR-0004 §3).
enum FieldStage : ubyte { Fallow = 0, Prepared = 1, Sown = 2, Reaped = 3 }

// Schema 26 (ADR-0012 §3): what held a harvest back, and one harvest of a field: its calendar
// year, the grain it gave a hectare and its limit.
enum HarvestLimit : ubyte { Season = 0, Soil = 1 }

struct HarvestRecord {
  year: int;
  kg_per_ha: float;
  limit: HarvestLimit;
}

table Field {
  id: ulong (id: 0);
  household: ulong (id: 1);
  // Integer centimetres from the map's north-west corner: west and north edges, width, height.
  x_cm: int (id: 2);
  y_cm: int (id: 3);
  w_cm: int (id: 4);
  h_cm: int (id: 5);
  // Index into Fields.crops.
  crop: ushort (id: 6);
  stage: FieldStage (id: 7);
  stage_since: long (id: 8);
  work_h: float (id: 9);
  tended_h: float (id: 10);
  ground: float (id: 11);
  sown_day: long (id: 12);
  sheaves_kg: float (id: 13);
  harvests: ushort (id: 14);
  // Work to clear its ground before it is first broken, person-hours per hectare (0 = open).
  clear_h_per_ha: float (id: 15);
  // The ground has been broken for a first crop.
  broken: bool (id: 16);
  // Schema 12 (M3a slice K, ADR-0007): who holds it, a household or (holder_settlement) a
  // settlement. Absent in older saves: the household that works it holds it.
  holder: ulong (id: 17);
  holder_settlement: bool (id: 18);
  // A lease from its holder to the household that works it (schema 12, ADR-0007 §3): when it
  // began and ends, and the holder's share of the grain threshed from it.
  leased: bool (id: 19);
  lease_since: long (id: 20);
  lease_until: long (id: 21);
  lease_share: float (id: 22);
  // Schema 24 (ADR-0012 §2): its growing crop's root-zone water, and the water the crop has
  // needed and had this season, mm. Absent in older saves: at field capacity, unstressed so far.
  water_mm: float (id: 23);
  need_mm: float (id: 24);
  got_mm: float (id: 25);
  // Schema 26 (ADR-0012 §3): its soil's nitrogen, kilograms a hectare: the fast and slow pools
  // of organic nitrogen and this year's mineral supply; and its last harvests, oldest first.
  // Absent in older saves: rebuilt by replaying its harvests from native ground.
  fast_n: float (id: 26);
  slow_n: float (id: 27);
  supply_n: float (id: 28);
  record: [HarvestRecord] (id: 29);
  // Schema 93 (M6b slice BF, ADR-0022 §13): flood depth (cm) and days standing under water.
  last_flood_depth_cm: ushort (id: 30);
  submerged_days: ushort (id: 31);
  // Schema 159 (M8c slice CU, fifth part): the plan law that reserved its ground (0 = none).
  reserved: ulong (id: 32);
}

table Fields {
  // Crop content ids at save time.
  crops: [string] (id: 0);
  fields: [Field] (id: 1);
}

// Section "plots" (schema 5): ground households have claimed (ADR-0004 §3). A plot outlives
// its building.
// Schema 15 (M3b slice O, ADR-0009 §7): stores and workshops beside dwellings.
enum PlotUse : ubyte { Dwelling = 0, Store = 1, Work = 2, Hall = 3, Tower = 4, Sickhouse = 5 }

table Plot {
  id: ulong (id: 0);
  household: ulong (id: 1);
  // Integer centimetres from the map's north-west corner: west and north edges, width, height.
  x_cm: int (id: 2);
  y_cm: int (id: 3);
  w_cm: int (id: 4);
  h_cm: int (id: 5);
  purpose: PlotUse (id: 6);
  since: long (id: 7);
  // Schema 155 (M8c slice CS, second part): why its household chose it among others: how many it
  // weighed (0: no receipt), and the hours the chosen and the next best would cost it.
  receipt_weighed: ushort (id: 8);
  receipt_hours: float (id: 9);
  receipt_next: float (id: 10);
  // Schema 158 (M8c slice CU, first part): the parcel of a plan it was given, if it was: the
  // plan's law (0: none), the parcel's index in its layout, and the rule's code (0 by need).
  allot_law: ulong (id: 11);
  allot_parcel: ushort (id: 12);
  allot_rule: ubyte (id: 13);
}

table Plots {
  plots: [Plot] (id: 0);
}

// Section "builds" (schema 5): buildings as their builders designed them, and how far their
// construction has gone (ADR-0004 §2). The design is authoritative; its parts, outline and
// needs are expanded from it with the grammar version it records.
// Schema 15 (M3b slice O, ADR-0009 §2): rectangular footprints for frame buildings.
enum FootprintKind : ubyte { Round = 0, Rect = 1 }

table BuildingSpec {
  // The program's content id, for example `core:building/hut`.
  program: string (id: 0);
  // The grammar version it was designed under.
  version: ushort (id: 1);
  footprint: FootprintKind (id: 2);
  // The centre, integer centimetres; Round: the radius of the wall line.
  x_cm: int (id: 3);
  y_cm: int (id: 4);
  radius_cm: int (id: 5);
  storeys: ubyte (id: 6);
  // Integer parameters, the grammar's to name: eight before schema 15 (a hut uses its first
  // three: eave height, roof pitch, door direction), up to sixteen since (ADR-0009 §2).
  params: [int] (id: 7);
  // The good each material slot is made of, as content ids.
  materials: [string] (id: 8);
  style_seed: ulong (id: 9);
  // Schema 15, Rect: the length and width between the wall lines, integer centimetres, and the
  // direction the length runs, 1/65,536 of a turn from east toward south.
  length_cm: int (id: 10);
  width_cm: int (id: 11);
  angle: ushort (id: 12);
}

// Schema 17 (M3b slice P): how one component group of a building stands (ADR-0009 §4).
enum GroupState : ubyte { Sound = 0, Symptom = 1, Failed = 2 }

table GroupCondition {
  // The group's semantic id in its building's expansion.
  group: uint (id: 0);
  // Its quality: a share of what sound members of its sizes carry, drawn once.
  quality: float (id: 1);
  // The share of its members' effective section lost, or of a covering worn.
  loss: float (id: 2);
  // When it was put in place, and last repaired (minutes).
  installed: long (id: 3);
  repaired: long (id: 4);
  state: GroupState (id: 5);
}

// Schema 17: how a building stands as a whole.
enum BuildingState : ubyte { Standing = 0, Damaged = 1, Ruin = 2 }

// Schema 17: upkeep under way on one of a building's groups, renewing a share of it.
table RepairState {
  group: uint (id: 0);
  share: float (id: 1);
  // Person-hours done on it.
  work_h: float (id: 2);
}

table Building {
  id: ulong (id: 0);
  household: ulong (id: 1);
  plot: ulong (id: 2);
  spec: BuildingSpec (id: 3);
  // The stage under way (0 foundation .. 4 finish); 5 once finished.
  stage: ubyte (id: 4);
  // Person-hours done on the stage under way.
  work_h: float (id: 5);
  started: long (id: 6);
  stage_since: long (id: 7);
  // Schema 16 (M3b slice O): the firm it is the workshop of, 0 for none.
  firm: ulong (id: 8);
  // Schema 17 (M3b slice P): the condition of each of its groups in place (ADR-0009 §4), how it
  // stands, the person-hours of the stage under way each times its builder's building skill, and
  // the upkeep under way. An earlier save has none of them: its groups in place are put there
  // sound on loading, as if built at middling skill.
  condition: [GroupCondition] (id: 9);
  state: BuildingState (id: 10);
  skill_h: float (id: 11);
  repair: RepairState (id: 12);
  // Schema 22 (M3b slice R): the building its builders' taste followed (0 for none).
  style_from: ulong (id: 13);
  // Schema 93 (M6b slice BF, ADR-0022 §13): flood depth (cm) and days standing wet.
  last_flood_depth_cm: ushort (id: 14);
  days_wet: ushort (id: 15);
  demolition: DemolitionSave (id: 16);
  // Schema 165 (M8d slice DC): the polity that raised and owns it, 0 for none.
  polity: ulong (id: 17);
}

// Schema 98: physical demolition work, not inferred from historical interventions.
table DemolitionSave {
  fire: uint (id: 0);
  needed_h: float (id: 1);
  work_h: float (id: 2);
  last_minute: long = -1 (id: 3);
}

table Builds {
  buildings: [Building] (id: 0);
}

// Section "wear" (schema 7): ground worn by walking (ADR-0004 §4), in 64 × 64-cell tiles where
// people have walked. Before schema 23 each tile was faded to the day saved and rounded, and the
// routing view and the trails were drawn again on load. From schema 23 (M3c slice S, ADR-0011
// §5) each tile is kept exactly as it stood, at its own day, with the routing view people plan
// on, so a world lived on from a save matches one never saved; the trails are traced from it.
table WearTile {
  // Tile row × tiles per row + tile column.
  index: uint (id: 0);
  // Before schema 23: wear of each cell, row by row, 0-65535 for 0-1, faded to the day saved.
  wear: [ushort] (id: 1);
  // Whether each cell is trail, one bit per cell, row by row (bit k of word k / 64).
  trail: [ulong] (id: 2);
  // Schema 23: the day the tile's wear stands at, and the wear of each cell, row by row.
  day: long (id: 3);
  wear_exact: [float] (id: 4);
}

// Schema 23: one tile of the routing view, as surveyed.
table WearViewTile {
  index: uint (id: 0);
  // Wear of each cell, row by row, 0-255 for 0-1.
  cells: [ubyte] (id: 1);
  // Trail bits as surveyed, as in WearTile.
  trail: [ulong] (id: 2);
}

table Wear {
  tiles: [WearTile] (id: 0);
  // Schema 23: the day of the last survey and the routing view it drew (absent before).
  surveyed: long (id: 1);
  view: [WearViewTile] (id: 2);
}

// Section "market" (schema 10): each settlement's market (ADR-0006 §4). Tallies are indexed like
// Markets.goods; they fade with a half-life from `day`.
table LastTerms {
  good: uint (id: 0);
  payment: uint (id: 1);
  // Paid per unit.
  price: float (id: 2);
}

enum TradeChannel : ubyte { Barter = 5, Sale = 6 }

table TradeRecord {
  at: long (id: 0);
  seller: ulong (id: 1);
  buyer: ulong (id: 2);
  good: uint (id: 3);
  units: float (id: 4);
  payment: uint (id: 5);
  paid: float (id: 6);
  channel: TradeChannel = Barter (id: 7);
  // Schema 56 (M5b slice AP, ADR-0019 §4): the buyer's settlement when it is not the market's
  // own (0 when it is).
  from: ulong (id: 8);
}

// A month of trade in one good: a line of the price history. `month` counts months from the
// calendar's origin; `good` is indexed like Markets.goods.
struct MonthOfTrade {
  month: uint;
  good: uint;
  trades: uint;
  units: float;
  // What the payments were worth to the sellers, hours of their own work.
  paid_h: float;
}

table MarketState {
  settlement: ulong (id: 0);
  day: long (id: 1);
  paid_h: [double] (id: 2);
  sold: [double] (id: 3);
  unmet: [double] (id: 4);
  unmet_h: [double] (id: 5);
  trades: double (id: 6);
  last: [LastTerms] (id: 7);
  recent: [TradeRecord] (id: 8);
  history: [MonthOfTrade] (id: 9);
}

// Schema 208 (M10d slice EF, first part; ADR-0035 §12): what a money is worth to a household from
// its use as money, as of the last midnight. `good` is indexed like Markets.goods.
table MoneyBelief {
  household: ulong (id: 0);
  good: uint (id: 1);
  // Hours of its own work a unit bought, and units paid, faded by the markets' memory.
  bought_h: double (id: 2);
  paid: double (id: 3);
  // Payments in it taken, and sellers of what it wanted who did not take it, faded to `day`.
  taken: float (id: 4);
  refused: float (id: 5);
  day: long (id: 6);
}

table Markets {
  markets: [MarketState] (id: 0);
  // Good content ids at save time.
  goods: [string] (id: 1);
  // Schema 208: each household's beliefs of each money, by household and money.
  beliefs: [MoneyBelief] (id: 2);
}

// Section "firms" (schema 11): every firm there has been, open and closed (ADR-0006 §5). Goods are
// indexed like Firms.goods.
struct BookLine {
  good: uint;
  amount: float;
  // civ_agents::firm::BookKind.
  kind: ubyte;
}

table BookEntry {
  at: long (id: 0);
  // civ_agents::firm::BookKind.
  kind: ubyte (id: 1);
  good: uint (id: 2);
  amount: float (id: 3);
  // The household on the other side (0 = none).
  other: ulong (id: 4);
}

table MonthStatement {
  // Months since the calendar's origin.
  month: uint (id: 0);
  lines: [BookLine] (id: 1);
  owner_h: float (id: 2);
  hired_h: float (id: 3);
  income_h: float (id: 4);
  costs_h: float (id: 5);
  stock_h: float (id: 6);
}

table FirmState {
  id: ulong (id: 0);
  owner: ulong (id: 1);
  owner_since: long (id: 2);
  founder: ulong (id: 3);
  settlement: ulong (id: 4);
  founded: long (id: 5);
  closed: bool (id: 6);
  closed_at: long (id: 7);
  // civ_agents::firm::Exit.
  exit: ubyte (id: 8);
  lines: [uint] (id: 9);
  stores: [double] (id: 10);
  stores_at: long (id: 11);
  offers: [Offer] (id: 12);
  sold: bool (id: 13);
  last_sale: long (id: 14);
  entries: [BookEntry] (id: 15);
  months: [MonthStatement] (id: 16);
  // What it pays for work, when it has posted a wage (none in a save that has no field).
  wage: WageOfferState (id: 17);
  // Schema 16 (M3b slice O): the most people seen working for it at once lately, and the day
  // that was seen (0 and 0 in an earlier save).
  most_at_once: ubyte (id: 18);
  most_at_once_day: long (id: 19);
  // Schema 172 (M10a slice DQ): its batches under way, as a household's (none before).
  batches: [BatchSave] (id: 20);
}

table WageOfferState {
  // Index into the catalog's activities at save time, by content id in Firms.activities.
  activity: uint (id: 0);
  // Indexed like Firms.goods.
  pay: uint (id: 1);
  per_hour: float (id: 2);
  hour_h: float (id: 3);
  hours: float (id: 4);
  taken: float (id: 5);
  reviewed: long (id: 6);
  // Schema 178 (M10a slice DT): its works' bell, the minute of the day its shift begins and the
  // shift's minutes (0 and 0, no bell, before).
  bell_min: ushort (id: 7);
  shift_min: ushort (id: 8);
}

table Firms {
  firms: [FirmState] (id: 0);
  // Good content ids at save time.
  goods: [string] (id: 1);
  // Activity content ids at save time (for wage offers).
  activities: [string] (id: 2);
}

// Section "wealth" (schema 12, written from M3a slice K's wealth measures on; an earlier save has
// none): each settlement's wealth measures at the end of each year, oldest first (ADR-0007 §4).
// Derived measures, never inputs to behaviour.
table WealthYear {
  // The year that ended.
  year: long (id: 0);
  settlement: ulong (id: 1);
  households: uint (id: 2);
  people: uint (id: 3);
  gini_goods: double (id: 4);
  gini_held: double (id: 5);
  gini_worked: double (id: 6);
  gini_floor: double (id: 7);
  top_tenth_goods: double (id: 8);
  holding_none: double (id: 9);
  working_none: double (id: 10);
  goods_h_per_head: double (id: 11);
  worked_ha_per_head: double (id: 12);
  floor_m2_per_house: double (id: 13);
  common_ha: double (id: 14);
  // Schema 16 (M3b slice O): floor under every roof a household has, homes, stores and
  // workshops, square metres, and room for goods under them, kilograms, a household (0 in an
  // earlier save).
  roofed_m2_per_house: double (id: 15);
  storage_kg_per_house: double (id: 16);
}

table Wealth {
  years: [WealthYear] (id: 0);
}

// Section "knowledge" (schema 13): each settlement's record of when it came to know a technique
// and when it lost one, oldest first (ADR-0008 §2). `kind`: 0 known (by `person`, `source` as in
// Knowing, from `source_person`), 1 lost (`person` knew it last). From schema 60 a person's source
// 5 is "seen" (M5b slice AR), its `source_person` the settlement it was seen in.
struct KnowledgeEntry {
  at: long;
  settlement: ulong;
  person: ulong;
  source_person: ulong;
  technique: ushort;
  kind: ubyte;
  source: ubyte;
}

// Schema 18: what a settlement has seen of a technique's buildings (ADR-0009 §6): failures (a
// death in one counting for more) and building-years of standing, both faded to `at`.
struct TrustEntry {
  at: long;
  settlement: ulong;
  failures: double;
  years: double;
  technique: ushort;
}

// Schema 94: fire losses and building-years by covering and wall kind (ADR-0022 §7).
struct FireTrustEntry {
  at: long;
  settlement: ulong;
  losses: double;
  years: double;
  tile: bool;
  wall_kind: ubyte;
}

// Schema 193: an enrolment: who teaches, who learns, the household that pays, the technique, the
// food a day of study costs, kcal (0 from kin), the day enrolled and the last day paid (-1 not yet).
struct EnrolmentSave {
  teacher: ulong;
  learner: ulong;
  payer: ulong;
  technique: ushort;
  fee_kcal: float;
  since: long;
  paid: long;
}

// Schema 194: a household that could not hold the fee to send a child to learn a technique, and
// the day.
struct UntaughtSave {
  household: ulong;
  technique: ushort;
  day: long;
}

// Schema 195: a written record of a technique: its id, the household holding it, who wrote it and
// the day.
struct RecordSave {
  id: ulong;
  holder: ulong;
  maker: ulong;
  technique: ushort;
  made: long;
}

// Schema 193: someone's minutes of sessions of a technique today, teaching or studying.
struct SessionSave {
  person: ulong;
  technique: ushort;
  minutes: float;
}

table Knowledge {
  // Technique content ids at save time; KnowledgeEntry.technique and TrustEntry.technique index
  // this list.
  techniques: [string] (id: 0);
  entries: [KnowledgeEntry] (id: 1);
  // Schema 18: each settlement's trust in each technique's buildings, in the order first seen.
  trust: [TrustEntry] (id: 2);
  // Schema 60 (M5b slice AR): for each entry, in order, another settlement it concerns (0 for
  // none): for a known entry, the settlement its knower came from; for a lost one, a settlement
  // where it is still known that someone left there has kin or a tie in. Written only when an
  // entry has one.
  elsewhere: [ulong] (id: 3);
  fire_trust: [FireTrustEntry] (id: 4);
  // Schema 193 (M10c slice EB, second part; ADR-0035 §5): learners enrolled to learn a technique
  // from someone of another household, in the order enrolled, and today's minutes of teaching and
  // of study, credited at midnight; `technique` indexes `techniques`.
  enrolments: [EnrolmentSave] (id: 5);
  taught: [SessionSave] (id: 6);
  studied: [SessionSave] (id: 7);
  // Schema 194 (M10c slice EB, third part): households that could not hold the fee to send a
  // child to learn within the year, oldest first; `technique` indexes `techniques`.
  untaught: [UntaughtSave] (id: 8);
  // Schema 195 (M10c slice EC): written records of techniques, in the order written, and the
  // minutes each writer has written toward the record they are writing; `technique` indexes
  // `techniques`.
  writings: [RecordSave] (id: 9);
  written: [SessionSave] (id: 10);
  // Schema 196 (M10c slice EC, second part): for each record, in order, the building it is kept
  // in (0 for none).
  writings_kept: [ulong] (id: 11);
}

// Section "deposits" (schema 19): bodies in the ground (ADR-0010 §1), in the order they were
// placed, with what has been taken from each. `good` indexes `goods`, the good content ids at save
// time; a body whose good the loaded content no longer has is dropped.
struct DepositBody {
  x_cm: long;
  y_cm: long;
  id: ulong;
  initial_kg: double;
  taken_kg: double;
  radius_cm: int;
  top_cm: int;
  thickness_cm: int;
  quality: float;
  good: ushort;
  exposed: bool;
}

// Each settlement's knowledge of a deposit: who found it and when, in the order they were found.
struct DepositKnownEntry {
  at: long;
  settlement: ulong;
  deposit: ulong;
  finder: ulong;
}

table Deposits {
  goods: [string] (id: 0);
  bodies: [DepositBody] (id: 1);
  known: [DepositKnownEntry] (id: 2);
}

// Section "earth" (schema 20): earthworks and what they have done to the ground (ADR-0010 §2-3).
// `kind` 0 a platform; `plot` 0 for none. Tiles are 64 by 64 cells, row by row across the map;
// each cell is the change in its mean height, metres.
struct EarthworkRecord {
  id: ulong;
  household: ulong;
  plot: ulong;
  begun: long;
  cut_m3: float;
  done: float;
  level_cm: int;
  x_cm: int;
  y_cm: int;
  w_cm: int;
  h_cm: int;
  side_run_cm: ushort;
  version: ushort;
  // 0 a platform; schema 21: 1 a pit, 2 its spoil heap; schema 100: 3 a bank. Append only.
  kind: ubyte;
}

// Schema 21 (M3b slice Q): a pit's or heap's links, by earthwork id: the deposit the pit is dug
// for, and the pit's heap (0 for none).
struct EarthLink {
  work: ulong;
  deposit: ulong;
  heap: ulong;
}

table GroundTile {
  index: uint (id: 0);
  rev: uint (id: 1);
  cells: [float] (id: 2);
}

// Schema 100: linear banks and their explicit borrow source. Field meanings are versioned
// by the world schema; legacy platform/pit expansion remains version 1.
struct BankSegmentRecord {
  work: ulong;
  borrow: ulong;
  ax: double;
  ay: double;
  bx: double;
  by: double;
  height_m: double;
  crest_width_m: double;
  side_run: double;
  compacted_per_bank: double;
  settlement_m: double;
  erosion_m: double;
  breached: bool;
}

// Schema 101: soil washed off a bank, held in its washed-sediment account.
struct BankSedimentRecord {
  work: ulong;
  compacted_m3: double;
}

// Seepage damage held against a bank so far, 0 to 1 (schema 103, M6b slice BG); a bank with
// none has no record.
struct BankPipingRecord {
  work: ulong;
  damage: double;
}

// Compacted earth laid back on a finished bank from its borrow pit to make up its crest
// (schema 104, M6b slice BG); a bank never mended has no record.
struct BankRefillRecord {
  work: ulong;
  compacted_m3: double;
}

table Earth {
  works: [EarthworkRecord] (id: 0);
  tiles: [GroundTile] (id: 1);
  links: [EarthLink] (id: 2);
  banks: [BankSegmentRecord] (id: 3);
  bank_sediment: [BankSedimentRecord] (id: 4);
  bank_piping: [BankPipingRecord] (id: 5);
  bank_refill: [BankRefillRecord] (id: 6);
  ditches: [DitchRecord] (id: 7);
  ditch_flows: [DitchFlowRecord] (id: 8);
  // Schema 173 (M10a slice DR): water-power installations, absent while there are none.
  installations: [InstallationRecord] (id: 9);
  // Schema 175 (M10a slice DS): water standing in pits, absent while no pit has taken any in.
  pit_water: [PitWaterRecord] (id: 10);
  // Schema 176 (M10a slice DS, third part): engines set at pits, absent while there are none.
  engines: [EngineRecord] (id: 11);
  // Schema 177 (M10a slice DS, fourth part): hours bailed by hand at pits, absent while none.
  pit_bailing: [PitBailingRecord] (id: 12);
}

// Hours bailed by hand at a pit since its first bailing (schema 177, M10a slice DS; ADR-0033 §7):
// the pit by earthwork id, the hours, and when the first was (minutes).
struct PitBailingRecord {
  work: ulong;
  hours: double;
  since: long;
}

// An engine set at a pit (schema 176, M10a slice DS; ADR-0033 §7): its id, the pit it pumps by
// earthwork id, the household that set it, and its rated kilowatts and efficiency.
struct EngineRecord {
  id: ulong;
  pit: ulong;
  owner: ulong;
  rated_kw: double;
  efficiency: double;
}

// Water standing in a pit when last worked out (schema 175, M10a slice DS; ADR-0033 §7): the pit
// by earthwork id, cubic metres, and when (minutes).
struct PitWaterRecord {
  work: ulong;
  water_m3: double;
  at: long;
}

// A water-power installation (schema 173, M10a slice DR; ADR-0033 §5): its wheel's place in
// metres, the reach it takes from, its fall and headrace in metres and m³/s, the wheel's
// efficiency and rated kilowatts, its owner, and the building it drives (0 for none). Its power is
// worked out each day and never saved.
struct InstallationRecord {
  id: ulong;
  reach: uint;
  at_x: double;
  at_y: double;
  head_m: double;
  race_m3s: double;
  efficiency: double;
  rated_kw: double;
  owner: ulong;
  building: ulong;
}

// Section "ties" (schema 28): what each person remembers of others (ADR-0014 §1), by holder and
// then by whom each tie is of. `good` and `bad` are the evidence by domain (provision, craft, word,
// counsel), the prior included; `reason` is the act that last moved the tie (an `Act` code; 255
// for none), on `reason_day`, `reason_times` times running.
struct TieRecord {
  holder: ulong;
  to: ulong;
  day: long;
  reason_day: long;
  familiarity: float;
  warmth: float;
  good_provision: float;
  good_craft: float;
  good_word: float;
  good_counsel: float;
  bad_provision: float;
  bad_craft: float;
  bad_word: float;
  bad_counsel: float;
  fear: float;
  help_h: float;
  reason_times: ushort;
  reason: ubyte;
}

// Each adult's standing in their settlement as worked out on `standing_day` (ADR-0014 §3-4): the
// esteem their settlement's other adults hold for them by domain, how many count them among those
// they esteem most, and whether they are a notable. Saved so a load continues exactly; a save
// without it works it out afresh.
struct StandingRecord {
  person: ulong;
  settlement: ulong;
  esteem_provision: float;
  esteem_craft: float;
  esteem_word: float;
  esteem_counsel: float;
  influence: uint;
  notable: bool;
}

table Ties {
  ties: [TieRecord] (id: 0);
  standing: [StandingRecord] (id: 1);
  standing_day: long (id: 2);
}

// Section "polity" (schema 29): each settlement's polity (ADR-0013), its body as values, its common
// store, every law proposed there with its whole history, and the gathering called, if any. Laws
// name their template by index into `policies`, the policy content ids at save time; a save naming
// one the loaded content lacks is refused (ADR-0013 §2). Codes: `members` (0 adults), `pass` (0
// more for than against), law `status` (0 proposed, 1 in force, 2 rejected, 3 lapsed: schema 30),
// `issue` (0 food short, 1 store unkept: schema 30), `outcome` (0 passed, 1 failed, 2 tied, 3 no
// quorum; 255 none yet), stance (0 support, 1 oppose, 2 abstain). `holder` (schema 30) is the one
// a law names (who keeps the store), 0 for none.
struct StanceSave {
  person: ulong;
  household: ulong;
  gain: float;
  regard: float;
  stance: ubyte;
}

struct KnownSave {
  person: ulong;
  day: long;
}

struct StakeSave {
  household: ulong;
  points: float;
}

table LawSave {
  id: ulong (id: 0);
  policy: uint (id: 1);
  levy_share: float (id: 2);
  relief_days: float (id: 3);
  status: ubyte (id: 4);
  sponsor: ulong (id: 5);
  // Minutes.
  proposed: long (id: 6);
  issue: ubyte (id: 7);
  meets_day: long (id: 8);
  decided: bool (id: 9);
  // Minutes, when `decided`.
  decided_at: long (id: 10);
  outcome: ubyte = 255 (id: 11);
  eligible: uint (id: 12);
  stances: [StanceSave] (id: 13);
  known: [KnownSave] (id: 14);
  complied: uint (id: 15);
  could_not: uint (id: 16);
  evaded: uint (id: 17);
  unaware: uint (id: 18);
  levied_kg: double (id: 19);
  withheld_kg: double (id: 20);
  relieved: uint (id: 21);
  relief_kg: double (id: 22);
  unanswered: uint (id: 23);
  holder: ulong (id: 24);
  // Schema 32: for a law against taking, what it adds to giving back what was taken, days of the
  // taker's household's food (M4b slice AB).
  compensation_days: float (id: 25);
  fine_days: float (id: 26);
  exile: bool (id: 27);
  // A watch's record (saves 33): rounds walked, minutes on them, cases it brought, the night of
  // its latest round and the rounds walked that night, and where its next round begins.
  watch_rounds: uint (id: 28);
  watch_minutes: double (id: 29);
  watch_cases: uint (id: 30);
  watch_night: long (id: 31);
  watch_tonight: ubyte (id: 32);
  watch_next: uint (id: 33);
  // A curfew's hours, from and to (0 and 0 for other laws), and the times someone broke it
  // knowing of it and not (schema 34).
  from_hour: ubyte (id: 34);
  to_hour: ubyte (id: 35);
  broken: uint (id: 36);
  broken_unaware: uint (id: 37);
  // For an amendment of the custom (schema 36, M4c slice AF): the body it would make, its
  // membership code (255 for a law that is no amendment), quorum share and rule code.
  body_members: ubyte = 255 (id: 38);
  body_quorum: float (id: 39);
  body_pass: ubyte (id: 40);
  // What talk at the hearth added to each stance, points, in `stances` order (schema 37, M4c
  // slice AG); absent before.
  stance_opinions: [float] (id: 41);
  // What what they hold dear added to each stance, points, in `stances` order (schema 39, M4c
  // slice AG); absent before.
  stance_values: [float] (id: 42);
  // The law in force it would replace when passed, 0 for none (schema 42, M4c slice AH: a
  // petition's demand).
  ends: ulong (id: 43);
  // Levies kept back openly in a faction's refusal, and the grain (schema 43, M4c slice AH).
  refused: uint (id: 44);
  refused_kg: double (id: 45);
  // The agreement with another polity this law decides, 0 for none (schema 65, M5c slice AU,
  // ADR-0020 §6).
  agreement: ulong (id: 46);
  // What views of the other polity added to each stance on an agreement, points, in `stances`
  // order (schema 66, M5c slice AU step three); absent when none did, and before.
  stance_views: [float] (id: 47);
  // For a band sent by law, the settlement it goes against, 0 for none (schema 112, M6c slice BJ).
  target: ulong (id: 48);
  // The council seats of the body it was put to, packed as `PolitySave.seats` (schema 121); 0
  // for a body of all its members, and before.
  body_seats: ulong (id: 49);
  // A store's keeper's diversions and the food, kilograms; asks answered by favour and passed
  // over (schema 131, M7c slice BY).
  diverted: uint (id: 50);
  diverted_kg: double (id: 51);
  favoured: uint (id: 52);
  passed_over: uint (id: 53);
  // A duty's collector's assessments, payments asked and paid, and the food paid (schema 131,
  // M7c slice BY).
  assessed: uint (id: 54);
  asked: uint (id: 55);
  bribed: uint (id: 56);
  bribe_kg: double (id: 57);
  // What each household owed the sponsor for gifts before a gathering added to each stance,
  // points, in `stances` order (schema 131, M7c slice BY); absent when none did, and before.
  stance_owed: [float] (id: 58);
  // A plan's bundle (schema 161): the building found is taken down, or may stand for a yearly
  // payment.
  remove: bool (id: 59);
  yearly_days: float (id: 60);
}

// `law` 0: called on cases only (M4b slice AB).
table GatheringSave {
  law: ulong (id: 0);
  day: long (id: 1);
  stakes: [StakeSave] (id: 2);
  present: [ulong] (id: 3);
  // Case numbers, in the order brought.
  cases: [uint] (id: 4);
}

// A version of a polity's custom (schema 36, ADR-0017 §1): its body, since when (minutes), and the
// amendment that made it (0 for the founding custom).
struct CustomVersionSave {
  members: ubyte;
  pass: ubyte;
  quorum_share: float;
  since: long;
  law: ulong;
}

table PolitySave {
  id: ulong (id: 0);
  settlement: ulong (id: 1);
  // Minutes.
  founded: long (id: 2);
  members: ubyte (id: 3);
  quorum_share: float (id: 4);
  pass: ubyte (id: 5);
  // By good, in `Polities.goods` order.
  stores: [double] (id: 6);
  // Minutes.
  stores_at: long (id: 7);
  laws: [LawSave] (id: 8);
  gathering: GatheringSave (id: 9);
  reviewed: long (id: 10);
  // Every version of its custom, oldest first (schema 36); older saves have the founding custom
  // alone.
  versions: [CustomVersionSave] (id: 11);
  // For each version, in `versions` order, who called those who took it from the gathering, 0
  // for one made by the custom's procedure (schema 44, M4c slice AI); absent before.
  seized_by: [ulong] (id: 12);
  // The places its laws claim, by law (schema 62, M5c slice AT, ADR-0020 §5); absent before.
  claimed: [PlaceClaimSave] (id: 13);
  // Where its laws to build a crossing would build one (schema 70, M5c slice AW step three);
  // absent before.
  sites: [CrossingSiteSave] (id: 14);
  // The sources of water its laws to close one name, by law (schema 82, M6a slice BA step four),
  // each of kind 2; absent before.
  closed: [PlaceClaimSave] (id: 15);
  // Where its laws to dig a well together would dig one (schema 83, M6a slice BA step four);
  // absent before.
  wells: [PublicWellSave] (id: 16);
  // Where its laws to build a flood bank would build one (schema 102, M6b slice BG); absent
  // before.
  banks: [BankSiteSave] (id: 17);
  // What each household reckoned, when it was proposed, a law's bank would save it a year, hours
  // (schema 102); absent before.
  bank_saves: [BankShareSave] (id: 18);
  // The hours each household has given to a law's bank (schema 102); absent before.
  bank_given: [BankShareSave] (id: 19);
  // The banks its laws built whose giving way its chronicle has told, by their earthwork id
  // (schema 103); absent before.
  banks_failed: [ulong] (id: 20);
  // Schema 104: which bank each law keeping one keeps, in the order made.
  bank_keeps: [BankKeepRecord] (id: 21);
  // Schema 114 (M6c slice BK): where its laws to raise a palisade would raise one, and what each
  // household reckoned, when it was proposed, the palisade would keep it a year, hours (as
  // `bank_saves`); absent before.
  enclosures: [EnclosureSiteSave] (id: 22);
  enclosure_saves: [BankShareSave] (id: 23);
  // Schema 118 (M6c slice BM): the settlements it holds besides its seat, in the order taken;
  // and, once another polity took it in, the day, that polity and how (`ended_how` 255 while it
  // still decides). Absent before: it holds its seat alone and still decides.
  held: [HeldSettlementSave] (id: 24);
  ended_day: long = -1 (id: 25);
  ended_by: ulong (id: 26);
  ended_how: ubyte = 255 (id: 27);
  // Schema 120 (M7a slice BN, ADR-0024 §2): its office laws held for a term, by law: the day
  // each ends, and how many put their names in when it was filled by lot.
  terms: [TermSave] (id: 28);
  // Schema 121 (M7a slice BO, ADR-0024 §1, §3): its body's council seats, packed (n, then the
  // electorate's, method's and term's codes; see `civ_agents::seats::Seats::pack`), 0 for a body
  // of all its members; each custom version's, parallel to `versions`; its seats held now; and
  // its elections, oldest first. Absent before: no council, no elections.
  seats: ulong (id: 29);
  version_seats: [ulong] (id: 30);
  seated: [SeatSave] (id: 31);
  elections: [ElectionSave] (id: 32);
  // Schema 131 (M7c slice BY): gifts its sponsors gave before its gatherings, oldest first,
  // within memory; absent before.
  patron_gifts: [PatronGiftSave] (id: 33);
  // Schema 150 (M8b slice CQ, third part): where its laws would clear passing places, what each
  // household reckoned they would spare it a year, and the hours each has given; absent before.
  ways: [WaySiteSave] (id: 34);
  way_saves: [BankShareSave] (id: 35);
  way_given: [BankShareSave] (id: 36);
  // Schema 156 (M8c slice CT, second part): the plans its laws lay, as realised when proposed,
  // and what it saw of its settlements' ground within memory, oldest first; absent before.
  plans: [PlanSave] (id: 37);
  ground_seen: [GroundSeenSave] (id: 38);
  // Schema 157 (M8c slice CT, third part): the buildings begun on ground a plan in force
  // reserves, in the order begun; absent before.
  encroachments: [EncroachmentSave] (id: 39);
  // Schema 160 (M8c slice CV, first part): who saw each encroachment begun, by its index in
  // `encroachments`, in order; absent before.
  encroachment_seen: [EncroachmentSeenSave] (id: 40);
  // What a finding ordered for each encroachment (schema 161).
  encroachment_orders: [EncroachmentOrderSave] (id: 41);
  // Schema 164 (M8d slice DC): what its settlements measured of the losses a public building
  // would answer, a year each, oldest first; absent before.
  measured: [MeasuredSave] (id: 42);
  // Schema 165 (M8d slice DC): where its laws would raise a building in common, the hours each
  // household has given to one, and the storehouse that shelters its common store; absent
  // before.
  raises: [RaiseSiteSave] (id: 43);
  raise_given: [BankShareSave] (id: 44);
  storehouse: ulong (id: 45);
  // Schema 166 (M8d slice DC): the hall its gatherings meet in (0 when none), and the losses
  // measured beside `measured`, a year each, in its order; absent before.
  hall: ulong (id: 46);
  measured_losses: [MeasuredLossSave] (id: 47);
  // Schema 167 (M8d slice DC): the watch tower its watch looks out from (0 when none).
  tower: ulong (id: 48);
  // Schema 207 (M10c slice EE, fourth part): the sickhouse it raised that stands finished (0 when
  // none).
  sickhouse: ulong (id: 49);
}

// A year's measured losses beside `MeasuredSave` (schema 166, M8d slice DC): the year, and the
// hours those who came gave to gatherings in the open that a wet day left without a quorum; from
// schema 167, the hours of work the fires that burned unseen awhile cost (0 before).
table MeasuredLossSave {
  year: long (id: 0);
  wet_lost_h: double (id: 1);
  late_fire_h: double (id: 2);
  // Schema 206 (M10c slice EE, fourth part): days a severe case of its households lay ill with
  // nobody tending them.
  untended_days: double (id: 3);
}

// A building a law would raise in common (schema 165, M8d slice DC): the law, the program by
// content index, the hours of a capable adult's work it takes, and the building once laid out
// (0 before).
table RaiseSiteSave {
  law: ulong (id: 0);
  program: ushort (id: 1);
  labour_h: double (id: 2);
  building: ulong (id: 3);
  // Schema 168: when it was laid out, last worked on, first used and finished, and when it
  // stalled, minutes (-1 for not yet, and before).
  begun: long = -1 (id: 4);
  last_work: long = -1 (id: 5);
  first_use: long = -1 (id: 6);
  finished: long = -1 (id: 7);
  stalled: long = -1 (id: 8);
}

// A year's measured losses (schema 164, M8d slice DC): the year, the food its common store lost
// to spoiling (kcal), the gatherings it held and how many on a wet day, and the fires that reached
// a roof.
struct MeasuredSave {
  year: long;
  spoiled_kcal: double;
  gatherings: uint;
  wet_gatherings: uint;
  roof_fires: uint;
}

// A plan a law lays (schema 156, M8c slice CT, second part; ADR-0030 §2): its version, its
// origin (metres) and axis (0 east and west, 1 north and south), the grid laid (a block's sides
// along and across, a parcel's frontage and depth, the streets' width, metres; blocks along and
// across; whether the origin block is a square), and the layout as realised, in integer
// centimetres from the map's north-west corner: street stretches and crossings, public sites (use
// 0: a square), parcels with their block, and how many of each the ground refused.
table PlanSave {
  law: ulong (id: 0);
  version: ushort (id: 1);
  origin_x: float (id: 2);
  origin_y: float (id: 3);
  axis: ubyte (id: 4);
  block_along: float (id: 5);
  block_across: float (id: 6);
  frontage: float (id: 7);
  depth: float (id: 8);
  street: float (id: 9);
  blocks_along: ubyte (id: 10);
  blocks_across: ubyte (id: 11);
  square: bool (id: 12);
  streets: [PlanRectSave] (id: 13);
  sites: [PlanSiteSave] (id: 14);
  parcels: [PlanParcelSave] (id: 15);
  refused_streets: uint (id: 16);
  refused_sites: uint (id: 17);
  refused_parcels: uint (id: 18);
  // Schema 158 (M8c slice CU, first part): the hours its keeper has spent staking parcels.
  staked_h: float (id: 19);
  // Schema 159 (M8c slice CU, fifth part): fields under its ground whose holders refused its pay.
  refused_fields: [ulong] (id: 20);
}

struct PlanRectSave {
  x: int;
  y: int;
  w: int;
  h: int;
}

struct PlanSiteSave {
  x: int;
  y: int;
  w: int;
  h: int;
  kind: ubyte;
}

struct PlanParcelSave {
  x: int;
  y: int;
  w: int;
  h: int;
  block: ushort;
}

// What a polity saw of its settlements' ground (schema 156): the day, the settlement, the
// household, and the issue it raises, by its code in `IssueKind::ALL`.
struct GroundSeenSave {
  day: long;
  settlement: ulong;
  household: ulong;
  issue: ubyte;
}

// A building begun on ground a plan in force reserves (schema 157): the day, the plan's law, the
// household that began it, and the building.
struct EncroachmentSave {
  day: long;
  law: ulong;
  household: ulong;
  building: ulong;
}

// What a finding under a plan ordered for an encroachment (schema 161): its index in the
// polity's encroachments; 1 to be taken down on `day`, 2 taken down on `day`, 3 may stand, owing
// `kcal` a year from `day`.
struct EncroachmentOrderSave {
  encroachment: uint;
  kind: ubyte;
  day: long;
  kcal: float;
}

// One who saw an encroachment begun (schema 160): its index in the polity's encroachments.
struct EncroachmentSeenSave {
  encroachment: uint;
  person: ulong;
}

// A gift a sponsor's household gave another's before the gathering on the sponsor's law (schema
// 131): the sponsor, the two households, the law, the day, the food in kcal and in days of the
// receiving household's food.
struct PatronGiftSave {
  patron: ulong;
  giver: ulong;
  client: ulong;
  law: ulong;
  day: long;
  kcal: float;
  days: float;
}

// A council seat held (schema 121): its number, its holder, from and until which day, and the
// election that seated them.
struct SeatSave {
  seat: ubyte;
  holder: ulong;
  since: long;
  until: long;
  election: uint;
}

// One who stood in an election (schema 121), and the day they put their name in.
struct CandidateSave {
  person: ulong;
  day: long;
}

// One who came to poll (schema 121) and whom they named, first choice first.
table BallotSave {
  voter: ulong (id: 0);
  named: [ulong] (id: 1);
}

// Where a candidate said they stand on one question (schema 122, M7a slice BP).
struct StoodSave {
  candidate: ulong;
  policy: ushort;
  x: float;
}

// A faction's slate in an election (schema 122): the members its organizer endorsed.
table SlateSave {
  faction: ulong (id: 0);
  named: [ulong] (id: 1);
}

// A district's seats where a council's seats are shared among settlements (schema 123, M7a
// slice BQ).
struct DistrictSave {
  settlement: ulong;
  seats: ubyte;
}

// An electoral alliance (schema 124, M7a slice BQ): the two factions, in id order, and the
// package they agreed (0 a common slate, 1 the first backs the second's, 2 the second the first's).
struct AllianceSave {
  first: ulong;
  second: ulong;
  package: ubyte;
}

// A candidate's count (schema 121).
struct VoteSave {
  person: ulong;
  votes: uint;
}

// An election (schema 121, ADR-0024 §3): why it was called (0 the custom became a council, 1 the
// term ending), the seats it fills (packed as `PolitySave.seats`), its days, its stage (0
// standing, 1 polling, 2 installed, 3 no candidates, 4 no voters, 5 tied, 6 abandoned), who chose
// whether to stand, who stood, the ballots, the count, those seated, whether a lot settled a
// tie, the day it ended (-1 while it runs) and the day its seats end.
table ElectionSave {
  id: uint (id: 0);
  why: ubyte (id: 1);
  seats: ulong (id: 2);
  called: long (id: 3);
  stand_until: long (id: 4);
  poll_day: long (id: 5);
  stage: ubyte (id: 6);
  considered: [ulong] (id: 7);
  candidates: [CandidateSave] (id: 8);
  ballots: [BallotSave] (id: 9);
  totals: [VoteSave] (id: 10);
  winners: [ulong] (id: 11);
  by_lot: bool (id: 12);
  ended: long = -1 (id: 13);
  until: long (id: 14);
  positions: [StoodSave] (id: 15);
  endorsements: [SlateSave] (id: 16);
  districts: [DistrictSave] (id: 17);
  // Each candidate's district, in candidate order; 0 for seats of the whole polity (schema 123).
  candidate_districts: [ulong] (id: 18);
  alliances: [AllianceSave] (id: 19);
}

// An office law's term (schema 120).
struct TermSave {
  law: ulong;
  until: long;
  pool: uint;
}

// A settlement a polity holds besides its seat (schema 118): since the day, how (0 annexed,
// 1 merged) and the polity that held it before.
table HeldSettlementSave {
  settlement: ulong (id: 0);
  since: long (id: 1);
  how: ubyte (id: 2);
  from: ulong (id: 3);
}

// Where a law would clear a passing place (schema 150, M8b slice CQ, third part): the cell at
// the middle of the single-cart stretch, the hours clearing it would take, and its way once begun
// (0 before).
table WaySiteSave {
  law: ulong (id: 0);
  cell: uint (id: 1);
  labour_h: double (id: 2);
  work: ulong (id: 3);
}

// Where a law would raise a palisade (schema 114, M6c slice BK): the point its ring is drawn
// round, metres, its radius, its gates, the homes it took in, the work it would take, and its
// enclosure once begun (0 before).
table EnclosureSiteSave {
  law: ulong (id: 0);
  x: float (id: 1);
  y: float (id: 2);
  radius_m: float (id: 3);
  gates: ubyte (id: 4);
  inside: ushort (id: 5);
  labour_h: float (id: 6);
  work: ulong (id: 7);
}

// Where a law would build a flood bank (schema 102, M6b slice BG): the reach whose water it keeps
// out, its crest line in metres from the map's corner, its section, the ground it and its borrow
// pit take, the work it would take, and its earthwork once begun (0 before).
// An irrigation ditch (schema 105, M6b slice BG): its earthwork, the reach its intake takes from,
// the field it waters, its line from intake to field in metres, its section, the fall of its bed,
// its weeds (0-1) and silt, whether its intake is open, and the water it has moved, m³.
struct DitchRecord {
  work: ulong;
  reach: uint;
  field: ulong;
  ax: double;
  ay: double;
  bx: double;
  by: double;
  bottom_m: double;
  depth_m: double;
  side_run: double;
  drop_m: double;
  weeds: double;
  silt_m: double;
  open: bool;
  taken_m3: double;
  kept_m3: double;
  seeped_m3: double;
  returned_m3: double;
}

// Today's change to a reach's flow from the ditches, passed on down the river, m³/s (schema 105).
struct DitchFlowRecord {
  reach: uint;
  m3s: float;
}

// A law keeping a flood bank and the law that built it (schema 104, M6b slice BG).
struct BankKeepRecord {
  law: ulong;
  built: ulong;
}

table BankSiteSave {
  law: ulong (id: 0);
  reach: uint (id: 1);
  ax: double (id: 2);
  ay: double (id: 3);
  bx: double (id: 4);
  by: double (id: 5);
  height_m: double (id: 6);
  crest_width_m: double (id: 7);
  side_run: double (id: 8);
  compacted_per_bank: double (id: 9);
  env_x_cm: int (id: 10);
  env_y_cm: int (id: 11);
  env_w_cm: int (id: 12);
  env_h_cm: int (id: 13);
  pit_x_cm: int (id: 14);
  pit_y_cm: int (id: 15);
  pit_w_cm: int (id: 16);
  pit_h_cm: int (id: 17);
  labour_h: double (id: 18);
  work: ulong (id: 19);
  // Schema 104: repair hours asked of its households so far, besides building it, and whether
  // they are asked to mend it now.
  upkeep_h: double (id: 20);
  mending: bool (id: 21);
}

// A household's hours against a law's bank (schema 102): reckoned saved a year, or given.
table BankShareSave {
  law: ulong (id: 0);
  household: ulong (id: 1);
  hours: float (id: 2);
}

// Where a law would dig a well (schema 83): its cell and ground, its well system's content id,
// the depth it would be dug to and the work it would take.
table PublicWellSave {
  law: ulong (id: 0);
  cell: uint (id: 1);
  system: string (id: 2);
  x_cm: int (id: 3);
  y_cm: int (id: 4);
  w_cm: int (id: 5);
  h_cm: int (id: 6);
  target_m: float (id: 7);
  labour_h: float (id: 8);
}

// Where a law would build a crossing (schema 70): the river cell, the bridge system's content id,
// the channel's width there and the work it would take.
table CrossingSiteSave {
  law: ulong (id: 0);
  cell: uint (id: 1);
  system: string (id: 2);
  span_m: float (id: 3);
  labour_h: float (id: 4);
}

// A place a law claims (schema 62): `kind` 0 a patch block by its centre patch, 1 a deposit by
// its permanent id; or a source of water a law closes (schema 82), kind 2 by its cell.
struct PlaceClaimSave {
  law: ulong;
  kind: ubyte;
  place: ulong;
}

table Polities {
  polities: [PolitySave] (id: 0);
  // Good content ids at save time.
  goods: [string] (id: 1);
  // Policy content ids at save time.
  policies: [string] (id: 2);
}

// Section "order" (schema 31, ADR-0015): takings as they happened (the truth), what people believe
// of them, what households taken from chose, and what households owe one another.
// `outcome`: 0 taken, 1 turned back, 2 fled when a sleeper woke.
struct TakenGood {
  // By index into `Order.goods`.
  good: ushort;
  amount: float;
}

table IncidentSave {
  id: uint (id: 0);
  // Minutes.
  at: long (id: 1);
  actor: ulong (id: 2);
  actor_household: ulong (id: 3);
  target: ulong (id: 4);
  place: Point (id: 5);
  outcome: ubyte (id: 6);
  goods: [TakenGood] (id: 7);
  kcal: float (id: 8);
  seen_by: [ulong] (id: 9);
  noticed: bool (id: 10);
  // The taker's household's food when they came, in days of its need, and the share of the other
  // households of its settlement that held more, ties counting half (schema 34); NaN when unknown,
  // as in older saves.
  food_days: float = nan (id: 11);
  richer: float = nan (id: 12);
  // The taker's settlement when it is not the store's (schema 109, M6c slice BI); 0 within a
  // settlement and in older saves.
  across: ulong (id: 13);
}

// `taker`, `from` and `origin` are 0 when unknown or none. `source`: 0 saw it, 1 told, 2 found the
// loss, 3 did it (schema 32).
struct BeliefSave {
  holder: ulong;
  taker: ulong;
  from: ulong;
  origin: ulong;
  day: long;
  incident: uint;
  source: ubyte;
}

struct ResponseSave {
  household: ulong;
  by: ulong;
  day: long;
  incident: uint;
  points: float;
  demand: bool;
}

// `standing`: 0 open, 1 met, 2 refused, 3 unpaid when due, 4 lapsed. `answer`: 0 not yet, 1 means
// to pay, 2 refused; `answer_points` its receipt.
struct ObligationSave {
  debtor: ulong;
  beneficiary: ulong;
  made: long;
  due: long;
  id: uint;
  incident: uint;
  kcal: float;
  paid_kcal: float;
  answer_points: float;
  standing: ubyte;
  answer: ubyte;
}

// Schema 32: what a household knows of the food an incident moved: what it found missing from its
// store (`lost`), or what a member brought home.
struct AmountSave {
  household: ulong;
  day: long;
  incident: uint;
  kcal: float;
  lost: bool;
}

// From saves 32 (M4b slice AB), in place of `ResponseSave`. `choice`: 0 let go, 1 demanded, 2
// brought a case; `report_points` counts only when `report_open`.
struct ResponseSave2 {
  household: ulong;
  by: ulong;
  day: long;
  incident: uint;
  points: float;
  report_points: float;
  choice: ubyte;
  report_open: bool;
}

// From saves 32, in place of `ObligationSave`. `kind`: 0 demanded back, 1 restitution, 2
// compensation, 3 a fine (`beneficiary` is then the polity); `case_id` 0 when no case imposed it.
struct ObligationSave2 {
  debtor: ulong;
  beneficiary: ulong;
  made: long;
  due: long;
  id: uint;
  incident: uint;
  case_id: uint;
  kcal: float;
  paid_kcal: float;
  answer_points: float;
  standing: ubyte;
  answer: ubyte;
  kind: ubyte;
}

// `stance`: as in `StanceSave`.
struct CaseStanceSave {
  person: ulong;
  household: ulong;
  stake: float;
  belief: float;
  regard: float;
  stance: ubyte;
}

// From saves 33 (M4b slice AC). `kept`: 0 reported, 1 told, 2 looked away, 3 paid, 4 refused and
// reported; `ask_points` counts only when `ask_open`.
struct SightingSave {
  officer: ulong;
  day: long;
  incident: uint;
  kcal: float;
  report_points: float;
  ask_points: float;
  kept: ubyte;
  ask_open: bool;
}

// `stage`: 0 open, 1 found, 2 not found, 3 unheard, 4 lapsed.
table CaseSave {
  id: uint (id: 0);
  incident: uint (id: 1);
  settlement: ulong (id: 2);
  law: ulong (id: 3);
  accuser: ulong (id: 4);
  by: ulong (id: 5);
  accused: ulong (id: 6);
  accused_household: ulong (id: 7);
  kcal: float (id: 8);
  leads: [ulong] (id: 9);
  opened: long (id: 10);
  stage: ubyte (id: 11);
  heard: bool (id: 12);
  // Minutes, when `heard`.
  heard_at: long (id: 13);
  eligible: uint (id: 14);
  stances: [CaseStanceSave] (id: 15);
  exiled: bool (id: 16);
  // The hear-cases law whose forum is to hear it or heard it, 0 for the gathering (schema 125,
  // M7b slice BR).
  forum: ulong (id: 17);
  // Its fact tags (schema 126, M7b slice BS: bits as `civ_agents::crime::CaseTags`), the finding
  // it departed from (0 for none), and what the findings each who heard it recalled moved them,
  // points, in the order of `stances` (empty before schema 126).
  tags: ubyte (id: 18);
  departed: uint (id: 19);
  stance_precedent: [float] (id: 20);
  // For a challenge (schema 127, M7b slice BT): the limit the law `law` is said to breach; 0 for
  // a taking. A challenge names no incident (`incident` 0).
  challenge: ulong (id: 21);
  // For a debt brought under a law of debts heard (schema 135, M7d slice CB): the loan it is of;
  // 0 for none. A debt names no incident (`incident` 0).
  loan: uint (id: 22);
  // For a case under a plan (schema 160, M8c slice CV): the building begun on ground the plan
  // reserves; 0 for none. It names no incident (`incident` 0).
  building: ulong (id: 23);
}

// How someone met one of the watch come to take what a finding owed: 0 yielded, 1 stood in the
// way, 2 struck (schema 47).
struct MetSave {
  person: ulong;
  met: ubyte;
}

// A blow: who struck whom, the days it kept them from work, and whether it killed them.
struct HarmSave {
  by: ulong;
  to: ulong;
  days: ushort;
  killed: bool;
}

// A band (schema 110, M6c slice BJ, ADR-0023 §3). `purpose`: 0 take, 1 take back. `stage`: 0
// called, 1 out, 2 home, 3 dispersed. `clash` is 0 when it met none. Minutes are from the calendar
// origin; `taken` indexes `Order.goods`.
table BandSave {
  id: uint (id: 0);
  organizer: ulong (id: 1);
  settlement: ulong (id: 2);
  purpose: ubyte (id: 3);
  target: ulong (id: 4);
  place: Point (id: 5);
  called: long (id: 6);
  muster: long (id: 7);
  members: [ulong] (id: 8);
  mustered: [ulong] (id: 9);
  arrived: [ulong] (id: 10);
  home: [ulong] (id: 11);
  stage: ubyte (id: 12);
  since: long (id: 13);
  clash: uint (id: 14);
  taken: [TakenGood] (id: 15);
  taken_kcal: float (id: 16);
  // Schema 111 (step two): who were asked and said no, in id order; none in earlier saves.
  asked: [ulong] (id: 17);
  // Schema 112 (step three): the incident it was recorded as, and the law that sent it; 0 for
  // none.
  incident: uint (id: 18);
  law: ulong (id: 19);
  // Schema 116 (M6c slice BL): where it comes up to the line round the place it goes to, if it
  // does.
  approach: Point (id: 20);
  // Schema 119 (M6c slice BM): the day its people had held the settlement it went to the
  // content's days, or -1; absent before, none.
  held: long = -1 (id: 21);
}

// Someone in an encounter a band met: `side` 0 the band, 1 against it; `holds` 0 hands, 1 an axe,
// 2 a spear; `gave_way` the minute they gave way, or -1.
struct FighterSave {
  person: ulong;
  side: ubyte;
  holds: ubyte;
  will: float;
  regard_leader: float;
  gave_way: int;
  hurt_days: ushort;
  killed: bool;
}

// A blow in an encounter a band met, with the minute it fell.
struct StruckSave {
  minute: ushort;
  by: ulong;
  to: ulong;
  days: ushort;
  killed: bool;
}

// An encounter a band met (schema 110). `ended`: 0 nobody stood, 1 those against it gave way, 2 the
// band gave way, 3 each went its way.
table ClashSave {
  id: uint (id: 0);
  at: long (id: 1);
  place: Point (id: 2);
  band: uint (id: 3);
  fighters: [FighterSave] (id: 4);
  blows: [StruckSave] (id: 5);
  frontage: uint (id: 6);
  minutes: ushort (id: 7);
  ended: ubyte (id: 8);
}

table EncounterSave {
  id: uint (id: 0);
  day: long (id: 1);
  officer: ulong (id: 2);
  household: ulong (id: 3);
  obligation: uint (id: 4);
  owed_kcal: float (id: 5);
  met: [MetSave] (id: 6);
  forced: bool (id: 7);
  taken_kcal: float (id: 8);
  harms: [HarmSave] (id: 9);
}

table Order {
  incidents: [IncidentSave] (id: 0);
  beliefs: [BeliefSave] (id: 1);
  responses: [ResponseSave] (id: 2);
  obligations: [ObligationSave] (id: 3);
  // Good content ids at save time.
  goods: [string] (id: 4);
  amounts: [AmountSave] (id: 5);
  // From saves 32: these replace `responses` and `obligations`, which are then left empty.
  responses2: [ResponseSave2] (id: 6);
  obligations2: [ObligationSave2] (id: 7);
  cases: [CaseSave] (id: 8);
  sightings: [SightingSave] (id: 9);
  // Watchers come to households to take what a refused finding owed (schema 47); absent before.
  encounters: [EncounterSave] (id: 10);
  // Bands called and the encounters they met (schema 110, M6c slice BJ); absent before.
  bands: [BandSave] (id: 11);
  clashes: [ClashSave] (id: 12);
  // Loans in goods between households, oldest first, the last loan number, and the asks made and
  // refused (schema 133, M7d slice CA, ADR-0027 §1); absent before.
  loans: [LoanSave] (id: 13);
  loans_next: uint (id: 14);
  loans_asked: ulong (id: 15);
  loans_refused: ulong (id: 16);
  // Each loan's pledge, answer and remedies, in `loans`' order (schema 134, M7d slice CB);
  // absent before, when a loan had none.
  loan_terms: [LoanTermsSave] (id: 17);
  // Coin issues struck, in the order struck, and every holder's pieces of each issue (schema 136,
  // M7d slice CE, ADR-0027 §6); absent before, when no coin was struck.
  coin_issues: [CoinIssueSave] (id: 18);
  purses: [PurseSave] (id: 19);
  brought: [BroughtSave] (id: 20);
  // Schema 179 (M10b slice DU): the minute the world's first lamp was lit for work, -1 before.
  lamp_first_lit: long = -1 (id: 21);
}

// An issue of coin (schema 136): its number, the polity whose mint struck it, the day, grams a
// piece and its fineness, and the pieces struck and still in being.
struct CoinIssueSave {
  id: uint;
  issuer: ulong;
  day: long;
  mass_g: float;
  fineness: float;
  count: double;
}

// Metal a household brought to a polity's mint and not yet struck (schema 137), in the order
// brought: the polity, the household and the kilograms.
struct BroughtSave {
  polity: ulong;
  household: ulong;
  metal_kg: double;
}

// Pieces of one issue a holder holds (schema 136), by holder and issue.
struct PurseSave {
  holder: ulong;
  issue: uint;
  count: double;
}

// A loan in goods (schema 133): its number, the creditor and debtor households, the good (an
// index into `Order.goods`), kilograms lent, owed and paid, the days made and due, its standing
// (0 open, 1 repaid, 2 defaulted) and its two witnesses.
struct LoanSave {
  id: uint;
  creditor: ulong;
  debtor: ulong;
  good: ushort;
  standing: ubyte;
  lent: float;
  owed: float;
  paid: float;
  made: long;
  due: long;
  witness_a: ulong;
  witness_b: ulong;
}

// A loan's pledge, answer and remedies (schema 134, M7d slice CB): `pledge_kind` 0 none, 1 a
// field's use, 2 a guarantor (`pledge` the field or household); `answer` 0 not yet, 1 meant to
// pay, 2 refused, with its `points`; the asks for time made and granted; the day the pledge was
// taken (`taken`, the least i64 when not); kilograms a guarantor paid; and for a guarantor's claim
// on the debtor, the loan it paid on (0 none). Loan standings gain 3 refused and 4 lapsed.
struct LoanTermsSave {
  pledge_kind: ubyte;
  answer: ubyte;
  asks: ubyte;
  extensions: ubyte;
  points: float;
  pledge: ulong;
  taken: long;
  by_guarantor: float;
  recourse: uint;
}

// Section "word" (schema 35, M4c slice AE, ADR-0016): shared claims, who heard them, and the
// grievances people hold. `kind`: 0 a gathering called, 1 a grievance told. `subject` and the
// ids below are 0 when none. `blamed_kind`: 0 the polity's body, 1 an office (by its law), 2 a
// household, 3 a person; 255 none. `issue`: 0 subsistence, 1 extraction, 2 treatment, 3 a
// collective claim. `wrong`: 0 the store empty when short, 1 found against, 2 not found, 3 unheard,
// 4 left unpaid.
table ClaimSave {
  id: uint (id: 0);
  kind: ubyte (id: 1);
  settlement: ulong (id: 2);
  day: long (id: 3);
  subject: ulong (id: 4);
  blamed_kind: ubyte = 255 (id: 5);
  blamed: ulong (id: 6);
  issue: ubyte (id: 7);
  // A suspicion's source (schema 79, M6a slice BA): its place kind (255 for none) and number, and
  // the counts it was told with (sick at, at, sick elsewhere, elsewhere).
  place_kind: ubyte = 255 (id: 8);
  place: ulong (id: 9);
  counts: [ushort] (id: 10);
  // Schema 99: a found-burning account; 0 for other kinds and earlier saves.
  fire: uint (id: 11);
  // Schema 111: the encounter a raid names, or the band a sighting names; 0 for other kinds.
  event: uint (id: 12);
}

// A source someone suspects (schema 79, M6a slice BA, ADR-0021 §6): held since a day index, by
// the counts of their latest tally.
struct SuspicionSave {
  holder: ulong;
  place: ulong;
  since: long;
  sick_at: ushort;
  at: ushort;
  sick_elsewhere: ushort;
  elsewhere: ushort;
  place_kind: ubyte;
}

struct HeardSave {
  holder: ulong;
  from: ulong;
  origin: ulong;
  first: long;
  last: long;
  claim: uint;
}

struct GrievanceSave {
  holder: ulong;
  blamed: ulong;
  law: ulong;
  raised: long;
  made: long;
  harm_days: float;
  unresolved_days: float;
  activation: float;
  issue: ubyte;
  blamed_kind: ubyte;
  wrong: ubyte;
}

table WordSave {
  claims: [ClaimSave] (id: 0);
  heard: [HeardSave] (id: 1);
  grievances: [GrievanceSave] (id: 2);
  next: uint (id: 3);
  suspicions: [SuspicionSave] (id: 4);
}

// Section "opinion" (schema 37, M4c slice AG, ADR-0016 §4): where each adult stands on the
// questions content names. `policy` indexes `Opinion.policies`; `since` is a day index.
struct PositionSave {
  holder: ulong;
  since: long;
  x: float;
  anchor: float;
  salience: float;
  heard: uint;
  policy: ushort;
}

table OpinionSave {
  positions: [PositionSave] (id: 0);
  // Policy content ids at save time.
  policies: [string] (id: 1);
  told: ulong (id: 2);
  taken: ulong (id: 3);
}

// Section "norms" (schema 38, M4c slice AG, ADR-0016 §4): what each person holds of the norms
// content names, and what each household last did at a levy. `norm` indexes `NormsSave.norms`;
// `day` is a day index.
struct NormStateSave {
  holder: ulong;
  endorse: float;
  expect: float;
  threshold: float;
  heard: uint;
  norm: ushort;
}

struct LevyActSave {
  household: ulong;
  day: long;
  paid: ushort;
  kept: ushort;
}

table NormsSave {
  states: [NormStateSave] (id: 0);
  // Norm content ids at save time.
  norms: [string] (id: 1);
  acts: [LevyActSave] (id: 2);
  told: ulong (id: 3);
  taken: ulong (id: 4);
}

// Section "values" (schema 39, M4c slice AG, ADR-0016 §4): what each person holds of the values
// content names, -1 to 1. `value` indexes `ValuesSave.values`.
struct HeldValueSave {
  holder: ulong;
  v: float;
  value: ushort;
}

table ValuesSave {
  held: [HeldValueSave] (id: 0);
  // Value content ids at save time.
  values: [string] (id: 1);
}

// Section "creeds" (schema 40, M4c slice AG, ADR-0016 §4): who holds which ideology and whom
// they had it from (0: they brought it), the creed laws were proposed under, and the highest
// person id given their start. `ideology` indexes `IdeologiesSave.ideologies`.
struct HoldingSave {
  holder: ulong;
  since: long;
  from: ulong;
  ideology: ushort;
}

struct CreedSave {
  law: ulong;
  ideology: ushort;
}

table IdeologiesSave {
  held: [HoldingSave] (id: 0);
  // Ideology content ids at save time.
  ideologies: [string] (id: 1);
  creeds: [CreedSave] (id: 2);
  told: ulong (id: 3);
  taken: ulong (id: 4);
  seen: ulong (id: 5);
}

// Section "factions" (schema 41, M4c slice AH, ADR-0017 §2): every faction founded, its store and
// history, and who belongs to each, with why as they last reviewed it. `against_kind` is a
// grievance's party kind (0 the body, 1 an office); `ended` counts only with `has_ended`; an
// event's `who` is 0 for none.
struct FactionEventSave {
  at: long;
  who: ulong;
  kind: ubyte;
}

struct MemberSave {
  person: ulong;
  faction: ulong;
  since: long;
  grievance: float;
  organizer: float;
  belong: float;
  dues: float;
  threshold: float;
  known: ushort;
}

table FactionSave {
  id: ulong (id: 0);
  settlement: ulong (id: 1);
  against_kind: ubyte (id: 2);
  against: ulong (id: 3);
  founder: ulong (id: 4);
  organizer: ulong (id: 5);
  // Minutes.
  founded: long (id: 6);
  has_ended: bool (id: 7);
  ended: long (id: 8);
  // By good, in `FactionsSave.goods` order.
  stores: [double] (id: 9);
  stores_at: long (id: 10);
  history: [FactionEventSave] (id: 11);
  // Schema 129 (M7c slice BW, ADR-0026 §2): an organization by stake. `has_stake` marks one;
  // `stake_purpose` is a `GoodUse` code, `stake_admit` and `stake_decides` its rules' codes, and
  // `stake_dues` the share of each threshing its members give. Its `against` names its founder,
  // as a person. History events 3 (admitted) and 4 (turned away) name the applicant.
  has_stake: bool (id: 12);
  stake_purpose: ubyte (id: 13);
  stake_admit: ubyte (id: 14);
  stake_decides: ubyte (id: 15);
  stake_dues: float (id: 16);
}

// A petition (schema 42, M4c slice AH, ADR-0017 §3): `policy` indexes `FactionsSave.policies`;
// `called` is in minutes, `day` a day index; `law` is 0 until it was put to the gathering;
// `nominee` is whom it would name to an office, 0 for a store's share.
table PetitionSave {
  id: ulong (id: 0);
  faction: ulong (id: 1);
  settlement: ulong (id: 2);
  organizer: ulong (id: 3);
  called: long (id: 4);
  day: long (id: 5);
  policy: ushort (id: 6);
  levy_share: float (id: 7);
  ends: ulong (id: 8);
  // Those who came, in id order.
  came: [ulong] (id: 9);
  law: ulong (id: 10);
  answered: bool (id: 11);
  nominee: ulong (id: 12);
}

// A refusal of a levy (schema 43, M4c slice AH, ADR-0017 §3): `called` is in minutes, `until`
// the last day it stands; `kept` those who kept back under it, in id order.
table RefusalSave {
  id: ulong (id: 0);
  faction: ulong (id: 1);
  settlement: ulong (id: 2);
  organizer: ulong (id: 3);
  called: long (id: 4);
  until: long (id: 5);
  law: ulong (id: 6);
  kept: [ulong] (id: 7);
  kept_kg: double (id: 8);
}

// Where one adult stood on a revolt (schema 44): `side` 0 with it, 1 with the gathering, 2
// neither.
struct SideSave {
  person: ulong;
  side: ubyte;
}

// A revolt (schema 44, M4c slice AI, ADR-0017 §4): its program's body as a custom version keeps
// it; `ended` 255 while it stands, else 0 held, 1 failed, at `ended_at` (minutes).
table RevoltSave {
  id: ulong (id: 0);
  faction: ulong (id: 1);
  settlement: ulong (id: 2);
  organizer: ulong (id: 3);
  called: long (id: 4);
  until: long (id: 5);
  members: ubyte (id: 6);
  quorum_share: float (id: 7);
  pass: ubyte (id: 8);
  sides: [SideSave] (id: 9);
  has_held: bool (id: 10);
  held_since: long (id: 11);
  ended: ubyte = 255 (id: 12);
  ended_at: long (id: 13);
  // The council seats of the body it would install, packed as `PolitySave.seats` (schema 121);
  // 0 for a body of all its members, and before.
  seats: ulong (id: 14);
}

table FactionsSave {
  factions: [FactionSave] (id: 0);
  members: [MemberSave] (id: 1);
  // Good content ids at save time.
  goods: [string] (id: 2);
  joined: ulong (id: 3);
  left: ulong (id: 4);
  // Every petition called, oldest first, and policy content ids at save time (schema 42); absent
  // before.
  petitions: [PetitionSave] (id: 5);
  policies: [string] (id: 6);
  // Every refusal of a levy called, oldest first (schema 43); absent before.
  refusals: [RefusalSave] (id: 7);
  // Every revolt called, oldest first (schema 44); absent before.
  revolts: [RevoltSave] (id: 8);
  // Every coup called, oldest first (schema 46), as a revolt with no faction (0) and its
  // challenger as `organizer`; absent before.
  coups: [RevoltSave] (id: 9);
}

// Section "events": the scheduler's pending events.
// Schema 88 (M6b slice BC): FireStep, a minute of every fire burning, pending whenever one burns.
// Schema 89 (M6b slice BD): Ignite, a home's fires in use may escape (`person` holds the
// building's id).
enum EventKind : ubyte { AgentStep = 0, FireStep = 1, Ignite = 2, BandLook = 3, Gates = 4, Pass = 5, Trains = 6, Gas = 7 }

table PendingEvent {
  at: long (id: 0);
  phase: ubyte (id: 1);
  tiebreak: ulong (id: 2);
  seq: ulong (id: 3);
  kind: EventKind (id: 4);
  person: ulong (id: 5);
  version: uint (id: 6);
  // Schema 141: the trip a Pass event belongs to.
  trip: ulong (id: 7);
}

table PendingEvents {
  events: [PendingEvent] (id: 0);
}

// Section "influenc" (schema 48, M4c slice AJ, ADR-0016 §5): the observer's interventions, in
// the order used: each one's number, the minutes it was first and last used, how often, its kind
// (0 a whisper, 1 an ideology told of), whom it reached and what it submitted (a claim's number;
// an ideology's index in `InfluencesSave.ideologies`), and for an ideology the day it was taken
// up (-1: not taken up) and how often it was weighed; for an agitator (schema 49) the newcomer,
// the ideology they hold and the day they came.
table InfluenceSave {
  id: uint (id: 0);
  at: long (id: 1);
  last: long (id: 2);
  uses: uint (id: 3);
  kind: ubyte (id: 4);
  target: ulong (id: 5);
  subject: uint (id: 6);
  taken: long = -1 (id: 7);
  weighed: uint (id: 8);
  // Schema 49 (M4c slice AJ, step two): kinds 2 an agitator, 3 a blessing, 4 a curse; for the
  // last two, the first day it no longer holds, the share of their way it moves a draw, and the
  // deaths and finds it turned.
  until: long (id: 9);
  share: float (id: 10);
  deaths: uint (id: 11);
  finds: uint (id: 12);
}

table InfluencesSave {
  list: [InfluenceSave] (id: 0);
  // Ideology content ids at save time.
  ideologies: [string] (id: 1);
  // Schema 54 (M5a slice AN): the migration waves sent (influence kind 5), in the order sent;
  // absent before.
  waves: [WaveSave] (id: 2);
  // Schema 75 (M6a slice AZ): disease content ids at save time, which a plague's (kind 6)
  // subject indexes; absent before.
  diseases: [string] (id: 3);
}

// Schema 54 (M5a slice AN): a migration wave. `parents` holds two ids for each run of three
// households (mother, father); `settlement` and `band` 0 when none.
table WaveSave {
  record: uint (id: 0);
  at: Point (id: 1);
  edge: Point (id: 2);
  day: long (id: 3);
  households: uint (id: 4);
  days: uint (id: 5);
  provisions_days: uint (id: 6);
  arrived: uint (id: 7);
  came: uint (id: 8);
  next: uint (id: 9);
  settlement: ulong (id: 10);
  band: ulong (id: 11);
  parents: [ulong] (id: 12);
  people: [ulong] (id: 13);
}

// Schema 51 (M5a slice AM, ADR-0018 §4): a place a household knows. `how`: 0 founded alongside,
// 1 seen, 2 kin there, 3 visited, 4 told; `from` 0 when no one; `food` below 0 when unknown.
table KnownPlaceSave {
  household: ulong (id: 0);
  settlement: ulong (id: 1);
  how: ubyte (id: 2);
  from: ulong (id: 3);
  first: long (id: 4);
  last: long (id: 5);
  food: float = -1 (id: 6);
  // Schema 52: the day a member was last there (-1: never).
  visited: long = -1 (id: 7);
}

// Schema 52 (M5a slice AM, visits): what passed in a year (from 0) between people of `from` and
// the settlement `to`: visits to its hearth, the minutes spent there, marriages into it.
table ContactSave {
  year: long (id: 0);
  from: ulong (id: 1);
  to: ulong (id: 2);
  visits: uint (id: 3);
  minutes: ulong (id: 4);
  marriages: uint (id: 5);
  // Schema 53 (M5a slice AN): people who moved from `from` to live in `to` with their household.
  moved: uint (id: 6);
  // Schema 56 (M5b slice AP): purchases people of `from` made at sellers' doors in `to`, and
  // their trips there that bought nothing, by why (sold out, terms, payment).
  bought: uint (id: 7);
  missed: [uint] (id: 8);
}

// Schema 56 (M5b slice AP, ADR-0019 §1): what `household` believes `seller` (a workshop if
// `firm`) of `market` offers of `good`, asked in `payment` at `price` a unit, as seen or told on
// `day`. `good` and `payment` index PlacesSave.goods; `how`: 0 seen, 1 told; `from` 0 when seen.
table PriceReportSave {
  household: ulong (id: 0);
  market: ulong (id: 1);
  seller: ulong (id: 2);
  firm: bool (id: 3);
  good: uint (id: 4);
  payment: uint (id: 5);
  price: float (id: 6);
  ask_h: float (id: 7);
  units: float (id: 8);
  day: long (id: 9);
  how: ubyte (id: 10);
  from: ulong (id: 11);
}

// Schema 53 (M5a slice AN, ADR-0018 §5): a household's leaning toward moving to `settlement`,
// which has won `reviews` of its reviews running, the last on `day`.
table LeaningSave {
  household: ulong (id: 0);
  settlement: ulong (id: 1);
  reviews: uint (id: 2);
  day: long (id: 3);
}

// Schema 52: someone unpartnered who looked for a partner at home and found nobody, and the day.
table UnmatchedSave {
  person: ulong (id: 0);
  day: long (id: 1);
}

// Schema 51: every household's known places, by household and then settlement; from schema 52
// the contacts between settlements, by year, from and to, and the failed searches, by person.
table PlacesSave {
  list: [KnownPlaceSave] (id: 0);
  contacts: [ContactSave] (id: 1);
  unmatched: [UnmatchedSave] (id: 2);
  // Schema 53: households' leanings toward moving, by household, and those an event prompted to
  // review where they live at the next midnight.
  leanings: [LeaningSave] (id: 3);
  review_due: [ulong] (id: 4);
  // Schema 55 (M5a slice AO): every coalition gathered to found a settlement, in order.
  coalitions: [CoalitionSave] (id: 5);
  // Schema 56 (M5b slice AP): every household's price reports, by household, market and good,
  // and the goods they name, by content id.
  reports: [PriceReportSave] (id: 6);
  goods: [string] (id: 7);
  // Schema 57 (M5b slice AQ, ADR-0019 §7): the convergence record, its goods named in `goods`.
  gaps: [GapSave] (id: 8);
  carried: [CarriedSave] (id: 9);
  // Schema 58 (M5b slice AQ, ADR-0019 §6): households' errands to fetch a good to sell at home,
  // their goods named in `goods`.
  errands: [ErrandSave] (id: 10);
  // Schema 59 (M5b slice AR): the buildings of other settlements people have seen since their
  // household's last taste review, by person.
  seen: [SeenSave] (id: 11);
  // Schema 61 (M5b slice AR, step three): each settlement's way of building when it was founded.
  ways: [WaySave] (id: 12);
  // Schema 62 (M5c slice AT, ADR-0020 §5): the places households' people work, by household and
  // place, and the work logged since the last day's end, in the order done.
  uses: [PlaceUseSave] (id: 13);
  worked: [WorkedSave] (id: 14);
  // Schema 63 (M5c slice AT, step two): who did each piece of work in `worked`, in its order (0
  // when not known).
  worked_by: [ulong] (id: 15);
  // Schema 73 (M6a slice AY, ADR-0021 §1): what has been drawn today at each spring, litres by
  // its patch in patch order, on `draws_day`.
  draws_day: long (id: 16);
  draw_patches: [uint] (id: 17);
  draw_litres: [double] (id: 18);
}

// Section "relation" (schema 63, M5c slice AT, ADR-0020 §3): what each person believes of the
// other polities they have heard of, by person and then polity. `yes` and `no` are the evidence
// for and against in each domain (keeps its word, harms us, helps us), the prior included;
// `reason_act` is 255 when nothing has written it.
table ViewSave {
  person: ulong (id: 0);
  polity: ulong (id: 1);
  day: long (id: 2);
  yes: [float] (id: 3);
  no: [float] (id: 4);
  reason_act: ubyte = 255 (id: 5);
  reason_day: long (id: 6);
  reason_times: ushort (id: 7);
}

// A crossing over water (schema 68, M5c slice AW): `system` the bridge system's content id;
// `bank_a`, `bank_b` the land cells at either end and `cells` the water cells it spans, in order
// from `bank_a`; `owner_kind` 0 a household, 1 a polity; `state` 0 being built (`work_h` done),
// 1 open since `state_day`, 2 failed on `state_day` for `why` (0 its own weight, 1 under someone
// stepping onto it).
table CrossingSave {
  id: ulong (id: 0);
  system: string (id: 1);
  bank_a: uint (id: 2);
  bank_b: uint (id: 3);
  cells: [uint] (id: 4);
  span_m: float (id: 5);
  members: ubyte (id: 6);
  diameter_cm: float (id: 7);
  quality: float (id: 8);
  loss: float (id: 9);
  owner_kind: ubyte (id: 10);
  owner: ulong (id: 11);
  labour_h: float (id: 12);
  begun: long (id: 13);
  state: ubyte (id: 14);
  work_h: float (id: 15);
  state_day: long (id: 16);
  why: ubyte (id: 17);
  // Schema 69 (M5c slice AW, step two): its builders' work so far, each hour weighted by their
  // building skill.
  skill_h: float (id: 18);
  // Schema 70 (M5c slice AW, step three): the hours each household's people worked on a polity's
  // crossing, by household id; absent before and for a household's.
  shares: [CrossingShareSave] (id: 19);
  // Schema 71 (M5c slice AX): the day its latest work began, and how many sessions of work began
  // on it that day; 0 and 0 before.
  crew_day: long (id: 20);
  crew: ubyte (id: 21);
}

// Hours a household's people worked on a crossing (schema 70).
struct CrossingShareSave {
  household: ulong;
  hours: float;
}

// A river cell a household's people wade, and how often, fading (schema 69).
struct WadeSave {
  household: ulong;
  day: long;
  cell: uint;
  wades: float;
}

// A stretch of an enclosure's line (schema 113, M6c slice BK): its ends in metres, its cells,
// its work in hours, its gate (0 none, 1 open, 2 shut) and the share of its posts lost to rot.
table EnclosureSectorSave {
  ax: float (id: 0);
  ay: float (id: 1);
  bx: float (id: 2);
  by: float (id: 3);
  cells: [uint] (id: 4);
  labour_h: float (id: 5);
  gate: ubyte (id: 6);
  loss: float (id: 7);
}

// An enclosure (schema 113, ADR-0023 §6): its polity, law and settlement, the circle it is drawn
// round, its sectors, the work done and given by each household, its latest crew, when it was
// begun (minutes) and the day its last sector stood (-1 while not).
table EnclosureSave {
  id: ulong (id: 0);
  owner: ulong (id: 1);
  law: ulong (id: 2);
  settlement: ulong (id: 3);
  centre: Point (id: 4);
  radius_m: float (id: 5);
  sectors: [EnclosureSectorSave] (id: 6);
  work_h: float (id: 7);
  shares: [CrossingShareSave] (id: 8);
  crew_day: long (id: 9);
  crew: ubyte (id: 10);
  begun: long (id: 11);
  finished: long = -1 (id: 12);
  // Schema 115: the hours of mending its households have been asked since it was raised.
  upkeep_h: float (id: 13);
}

// Every crossing, in the order begun, and the revision of their states (schema 68).
table CrossingsSave {
  list: [CrossingSave] (id: 0);
  revision: uint (id: 1);
  // Schema 69: the river cells households' people wade, by household and cell.
  wades: [WadeSave] (id: 2);
  // Schema 113 (M6c slice BK): every enclosure, in the order begun, and the revision of what
  // bars walking.
  enclosures: [EnclosureSave] (id: 3);
  enclosures_revision: uint (id: 4);
}

// A well (schema 74, M6a slice AY, step three): `system` its well system's content id; its
// ground in integer centimetres from the map's north-west corner as a plot's; `state` 0 being
// dug, 1 open since `state_at`, 2 given up at `state_at`, 3 fallen in at `state_at`; the water in
// its shaft at `level_at`, metres, and what was drawn from it since the day's end, litres; the
// day its latest work began and how many began a session of it that day.
table WellSave {
  id: ulong (id: 0);
  system: string (id: 1);
  cell: uint (id: 2);
  x_cm: int (id: 3);
  y_cm: int (id: 4);
  w_cm: int (id: 5);
  h_cm: int (id: 6);
  household: ulong (id: 7);
  ground_m: float (id: 8);
  depth_m: float (id: 9);
  target_m: float (id: 10);
  work_h: float (id: 11);
  skill_h: float (id: 12);
  quality: float (id: 13);
  loss: float (id: 14);
  mend_h: float (id: 15);
  worth: float (id: 16);
  level_m: double (id: 17);
  level_at: long (id: 18);
  drawn_l: double (id: 19);
  begun: long (id: 20);
  state: ubyte (id: 21);
  state_at: long (id: 22);
  crew_day: long (id: 23);
  crew: ubyte (id: 24);
  // Its lid and curb (schema 81, M6a slice BA): hours of covering owed, and whether it has one.
  cover_h: float (id: 25);
  covered: bool (id: 26);
  // The polity whose gathering agreed to dig it (schema 83, M6a slice BA step four), 0 for a
  // household's; a polity's well holds the polity's id as its household.
  polity: ulong (id: 27);
}

// Hours a household's people gave to a polity's well (schema 83).
struct WellShareSave {
  well: ulong;
  household: ulong;
  hours: float;
}

// Every well, in the order begun (schema 74), and the hours households gave to polities' wells
// (schema 83), by well and then household.
table WellsSave {
  list: [WellSave] (id: 0);
  shares: [WellShareSave] (id: 1);
}

// An infection (schema 75, M6a slice AZ; ADR-0021 §5): `disease` its content id; the day it came
// and how (`acquired` 0 the observer, `source` an influence record's number; 1 a household,
// `source` its id; from schema 76, 2 water drawn at a well, `source` its id, 3 at a river reach,
// `source` its index, and 4 or more water from another place, as `NodeSave` code 4 less); its course in days, half-open (`ill_from` equal to `ill_until` when it brought
// no symptoms); `ended` the day it ended (-1 while it runs) and `outcome` 0 recovered, 1 died,
// 2 gone (died of something else or left the world).
table EpisodeSave {
  id: uint (id: 0);
  person: ulong (id: 1);
  disease: string (id: 2);
  infected: long (id: 3);
  acquired: ubyte (id: 4);
  source: ulong (id: 5);
  shed_from: long (id: 6);
  shed_until: long (id: 7);
  ill_from: long (id: 8);
  ill_until: long (id: 9);
  severe: bool (id: 10);
  immune_until: long (id: 11);
  ended: long = -1 (id: 12);
  outcome: ubyte (id: 13);
  // Schema 77 (step three): the care its bearer was given. The first day someone tended them
  // (-1: nobody yet) and who; the last day they were tended, the hours that day and the least
  // relative risk of dying a treatment a carer that day knew brings; the hours over the illness.
  care_first: long = -1 (id: 14);
  care_by: ulong (id: 15);
  care_day: long (id: 16);
  care_hours: float (id: 17);
  care_rr: float = 1 (id: 18);
  care_total_h: float (id: 19);
  // The outbreak it is part of, by number (0: none; schema 77).
  outbreak: uint (id: 20);
  // The household they lived in when they took it (0: not recorded; schema 85, M6a slice BB).
  household: ulong (id: 21);
}

// An outbreak (schema 77, M6a slice AZ step three; ADR-0015 §8): its number, disease (content
// id), settlement (0: none), the day its first case took it and that case's episode number, and
// the day it ended (-1 while open).
table OutbreakSave {
  id: uint (id: 0);
  disease: string (id: 1);
  settlement: ulong (id: 2);
  began: long (id: 3);
  first: uint (id: 4);
  ended: long = -1 (id: 5);
}

// Every infection, in the order they came (schema 75), and every outbreak, in the order they
// began (schema 77).
// Schema 190 (M10c slice DZ, second part; ADR-0035 §2): a household's call for someone of
// another to tend its ill: the household that called and the one it asked, the food offered a day
// of care, kcal (0 from kin), the day it called and the last day it paid (-1 not yet).
struct CareCallSave {
  caller: ulong;
  carer: ulong;
  fee_kcal: float;
  day: long;
  paid: long;
}

// Schema 191 (M10c slice EA; ADR-0035 §3): the last day someone tended the ill, kept while it
// matters to a birth they attend.
struct TendedSave {
  person: ulong;
  day: long;
}

// Schema 192 (M10c slice EA, second part): a birth someone attended: who, the mother's
// household, the day, and whether she lived.
struct AttendedSave {
  attendant: ulong;
  household: ulong;
  day: long;
  lived: bool;
}

// Schema 197 (M10c slice EC, third part): someone of a household died in the care of a carer it
// paid who knew no treatment of the disease (its content id), and the day.
table UnknowingSave {
  household: ulong;
  disease: string;
  day: long;
}

// Schema 198 (M10c slice ED): two who met in company at the hearth today, and the hours.
struct CompanySave {
  a: ulong;
  b: ulong;
  hours: float;
}

// Schema 200 (M10c slice ED, third part): someone vaccinated against a disease, the day, and the
// last day its protection is whole.
table VaccinatedSave {
  person: ulong;
  disease: string;
  day: long;
  full_until: long;
  // Schema 201 (M10c slice ED, fourth part): who vaccinated them, 0 for nobody known.
  by: ulong;
}

// Schema 203 (M10c slice EE, second part): an entry in a polity's register of the sick: the
// polity, the day, the household, and what was entered (0 sickness heard of, 1 a death of
// disease; schema 204: 2 a home seen on the health officer's round).
struct RegisterSave {
  polity: ulong;
  day: long;
  household: ulong;
  kind: ubyte;
}

// Schema 207 (M10c slice EE, fourth part): someone lying in a sickhouse, and the day admitted;
// someone who tended at one today.
struct AdmittedSave {
  person: ulong;
  building: ulong;
  day: long;
}

struct StaffedSave {
  carer: ulong;
  building: ulong;
}

table SicknessSave {
  episodes: [EpisodeSave] (id: 0);
  outbreaks: [OutbreakSave] (id: 1);
  calls: [CareCallSave] (id: 2);
  tended: [TendedSave] (id: 3);
  // Schema 192: calls to attend a birth due, apart from those to tend the ill; every birth
  // attended.
  birth_calls: [CareCallSave] (id: 4);
  attended: [AttendedSave] (id: 5);
  // Schema 197: deaths in unknowing paid care within the year, oldest first.
  unknowing: [UnknowingSave] (id: 6);
  // Schema 198: today's company at the hearth, kept while a disease passing by company runs.
  met: [CompanySave] (id: 7);
  // Schema 199 (M10c slice ED, second part): calls to inoculate a household's people that stand.
  inoculation_calls: [CareCallSave] (id: 8);
  // Schema 200: everyone vaccinated, in the order vaccinated.
  vaccinated: [VaccinatedSave] (id: 9);
  // Schema 203: the registers of the sick within the year, in the order entered.
  register: [RegisterSave] (id: 10);
  // Schema 207: those lying in sickhouses, in the order admitted, and today's carers there.
  admitted: [AdmittedSave] (id: 11);
  staffed: [StaffedSave] (id: 12);
}

// Section "fires" (schema 88, M6b slice BC; ADR-0022 §13): a building's fire, from its covering
// catching to its burning out. `kindled` 0: the observer (`source` the influence), 1: a burning
// neighbour (`source` its fire, with the gap, the wind, the cosine toward this building from it
// and the fuel's water then); schema 89: 2, a fire in use that escaped (`source` the ignition).
// `episode` 0: none. `ended` -1 while it burns.
table FireSave {
  id: uint (id: 0);
  building: ulong (id: 1);
  household: ulong (id: 2);
  settlement: ulong (id: 3);
  x: float (id: 4);
  y: float (id: 5);
  began: long (id: 6);
  kindled: ubyte (id: 7);
  source: uint (id: 8);
  gap_m: float (id: 9);
  wind_ms: float (id: 10);
  toward: float (id: 11);
  moisture: float (id: 12);
  episode: uint (id: 13);
  ended: long = -1 (id: 14);
  goods_kg: float (id: 15);
  deaths: [ulong] (id: 16);
}

// A conflagration: fires that spread from one building to others. `ended` -1 while any burns.
table ConflagrationSave {
  id: uint (id: 0);
  settlement: ulong (id: 1);
  first: uint (id: 2);
  began: long (id: 3);
  ended: long = -1 (id: 4);
}

// A building's exposure near fires burning now, kW/m².
table ExposureSave {
  building: ulong (id: 0);
  kw: double (id: 1);
}

// A building the spread weighed, by the first fire of its conflagration or the lone fire.
table WeighedSave {
  fire: uint (id: 0);
  building: ulong (id: 1);
  peak_kw: float (id: 2);
  threshold_kw: float (id: 3);
  caught: bool (id: 4);
}

// An unintended ignition of a fire in use (schema 89, M6b slice BD; ADR-0022 §3): `hearth` 0 a
// lit hearth, 1 a banked one, 2 a fire worked at home; `put_out_by` the person who put it out
// at once (0: nobody), `fire` the building's fire it became (0: none).
table IgnitionSave {
  id: uint (id: 0);
  at: long (id: 1);
  building: ulong (id: 2);
  household: ulong (id: 3);
  settlement: ulong (id: 4);
  hearth: ubyte (id: 5);
  moisture: float (id: 6);
  put_out_by: ulong (id: 7);
  fire: uint (id: 8);
  // Schema 90: minutes it grows before the covering, and when it ended (put out, caught or gone
  // out); `ended_set` false while it grows.
  grows_min: float (id: 9);
  ended: long (id: 10);
  ended_set: bool (id: 11);
}

// Someone came to know of a fire (schema 90, M6b slice BD, step two; ADR-0022 §6-§7): `how` 0
// inside, 1 woken by it, 2 saw it, 3 heard the shout.
table KnewSave {
  fire: uint (id: 0);
  person: ulong (id: 1);
  at: long (id: 2);
  how: ubyte (id: 3);
  shouted: bool (id: 4);
}

table FiresSave {
  fires: [FireSave] (id: 0);
  episodes: [ConflagrationSave] (id: 1);
  exposure: [ExposureSave] (id: 2);
  weighed: [WeighedSave] (id: 3);
  // Schema 89.
  ignitions: [IgnitionSave] (id: 4);
  // Schema 90.
  knew: [KnewSave] (id: 5);
  // Schema 91.
  wet: [WetSave] (id: 6);
  thrown: [ThrownSave] (id: 7);
  // Schema 92.
  stripped: [StrippedSave] (id: 8);
  salvaged: [SalvagedSave] (id: 9);
  pulled: [PulledSave] (id: 10);
}

// Schema 98: completed emergency demolition and its actual crew.
table PulledSave {
  fire: uint (id: 0);
  building: ulong (id: 1);
  at: long (id: 2);
  people: [ulong] (id: 3);
  work_h: float (id: 4);
}

// Covering torn from a roof a fire threatened (schema 92, M6b slice BD, step four).
table StrippedSave {
  fire: uint (id: 0);
  building: ulong (id: 1);
  person: ulong (id: 2);
  at: long (id: 3);
  m2: float (id: 4);
}

// Goods carried out from under a roof a fire threatened (schema 92): `good` by index in the
// catalog's goods.
table SalvagedSave {
  fire: uint (id: 0);
  building: ulong (id: 1);
  person: ulong (id: 2);
  at: long (id: 3);
  good: ushort (id: 4);
  kg: float (id: 5);
}

// Water standing on a roof near a fire burning now (schema 91, M6b slice BD, step three).
table WetSave {
  building: ulong (id: 0);
  litres: double (id: 1);
}

// A load of water thrown at a fire (schema 91): `fire` the first of the conflagration (or the lone
// fire) burning then, `from` where it was drawn (a source's cell, or 4294967295 the store).
table ThrownSave {
  fire: uint (id: 0);
  building: ulong (id: 1);
  person: ulong (id: 2);
  at: long (id: 3);
  litres: float (id: 4);
  from: uint (id: 5);
}

// A place a load lies or passes (schema 76, M6a slice AZ, step two; ADR-0021 §4): `code` 0 a
// person shedding it (`id` theirs), 1 a household's heap (`id` the household), 2 a well (`id`
// its), 3 a river reach (`id` its index), 4 a household's stored water (`id` the household).
struct NodeSave {
  code: ubyte;
  id: ulong;
}

// A load of a disease (`disease` its index in `ContagionSave.diseases`) at `at`, doses.
struct LoadSave {
  at: NodeSave;
  disease: ushort;
  amount: double;
}

// The part of a household's stored water's load of a disease drawn at `source`, doses.
struct StoredSave {
  household: ulong;
  source: NodeSave;
  disease: ushort;
  amount: double;
}

// A load soaking through the ground from `from` to `to`, arriving on day `arrives`.
struct TransitSave {
  arrives: long;
  from: NodeSave;
  to: NodeSave;
  disease: ushort;
  amount: double;
}

// One move of a load on `day`: `how` 0 shed, 1 washed off, 2 soaked in, 3 arrived through the
// ground, 4 drawn with water.
struct MoveSave {
  day: long;
  from: NodeSave;
  to: NodeSave;
  disease: ushort;
  how: ubyte;
  amount: double;
}

// What people shed, where it lies and where it went (schema 76): loads by place, stored water's
// loads by where they were drawn, loads on their way through the ground in the order sent, and
// the moves of the last 400 days in the order made.
table ContagionSave {
  // Disease content ids at save time.
  diseases: [string] (id: 0);
  loads: [LoadSave] (id: 1);
  stores: [StoredSave] (id: 2);
  transit: [TransitSave] (id: 3);
  moves: [MoveSave] (id: 4);
}

table RelationsSave {
  views: [ViewSave] (id: 0);
  // Schema 64 (M5c slice AU, ADR-0020 §2): the claims of other polities each household heard of,
  // by household, place and law.
  heard: [HeardClaimSave] (id: 1);
  // Schema 65 (M5c slice AU, ADR-0020 §6): every agreement between polities, in the order made.
  agreements: [AgreementSave] (id: 2);
  // Schema 67 (M5c slice AV, ADR-0020 §7): every payment agreements owe, in the order they fell
  // due, and the goods their clauses and payments name, by content id.
  dues: [DueSave] (id: 3);
  goods: [string] (id: 4);
}

// A payment an agreement owes (schema 67): `good` indexes `RelationsSave.goods`; `state` 0 owed,
// 1 met on `state_day`, 2 missed on `state_day` for `why` (0 the store held none, 1 nobody to
// carry it, 2 nobody carried it); `carrier` 0 for nobody; `held_kg` what it holds, as of minute
// `held_at`.
table DueSave {
  id: ulong (id: 0);
  agreement: ulong (id: 1);
  clause: ubyte (id: 2);
  from_polity: ulong (id: 3);
  to_polity: ulong (id: 4);
  good: ushort (id: 5);
  owed_kg: double (id: 6);
  made: long (id: 7);
  due: long (id: 8);
  set_aside_kg: double (id: 9);
  arrived_kg: double (id: 10);
  carrier: ulong (id: 11);
  state: ubyte (id: 12);
  state_day: long (id: 13);
  why: ubyte (id: 14);
  held_kg: double (id: 15);
  held_at: long (id: 16);
}

// An agreement between two polities (schema 65): side 0 is the polity whose member sought terms.
// `clause_kind` and `clause_side` are its clauses in order (kind 0: side `clause_side` gives the
// other's people leave to use the places it claims). Each side's `law`, `passed` and `heard` is 0,
// or `passed`/`heard` -1, when not yet. `state` 0 offered, 1 in force since `state_day`, 2 failed
// on `state_day` (`why_kind`, `why_side`: 0 no terms, 1 turned down, 2 too few came, 3 never put
// to a gathering, 4 never answered), 3 ended on `state_day` (`by` 255 when its term ran out, else
// the side whose law ended it).
table AgreementSave {
  id: ulong (id: 0);
  polity_a: ulong (id: 1);
  polity_b: ulong (id: 2);
  negotiator_a: ulong (id: 3);
  negotiator_b: ulong (id: 4);
  clause_kind: [ubyte] (id: 5);
  clause_side: [ubyte] (id: 6);
  term_days: uint (id: 7);
  made: long (id: 8);
  law_a: ulong (id: 9);
  law_b: ulong (id: 10);
  passed_a: long = -1 (id: 11);
  passed_b: long = -1 (id: 12);
  heard_a: long = -1 (id: 13);
  heard_b: long = -1 (id: 14);
  state: ubyte (id: 15);
  state_day: long (id: 16);
  why_kind: ubyte (id: 17);
  why_side: ubyte (id: 18);
  by: ubyte = 255 (id: 19);
  // Schema 67 (M5c slice AV): what each clause gives, in `clause_kind` order: the good (indexing
  // `RelationsSave.goods`), kilograms, and days between payments (0 for leave, and a gift's).
  clause_good: [ushort] (id: 20);
  clause_kg: [uint] (id: 21);
  clause_days: [uint] (id: 22);
}

// A place another polity's law claims, as `household` heard of it on `day` from `from` (schema
// 64): `kind` 0 a patch block by its centre patch, 1 a deposit.
table HeardClaimSave {
  household: ulong (id: 0);
  kind: ubyte (id: 1);
  place: ulong (id: 2);
  law: ulong (id: 3);
  polity: ulong (id: 4);
  day: long (id: 5);
  from: ulong (id: 6);
}

// Outsiders a household saw at a place (schema 62): days, fading, and the last day.
struct OutsidersSave {
  settlement: ulong;
  days: float;
  last: long;
}

// Another household seen drawing water at the same source the same day (schema 79): days,
// fading, and the last day.
struct SeenAtSave {
  household: ulong;
  days: float;
  last: long;
}

// What `household` holds of a place its people work (schema 62): `kind` 0 a patch block by its
// centre patch, 1 a deposit by its permanent id; days worked and food got there, kcal, both
// fading, reckoned to `day`; those of other settlements seen there, in settlement order.
table PlaceUseSave {
  household: ulong (id: 0);
  kind: ubyte (id: 1);
  place: ulong (id: 2);
  days: float (id: 3);
  kcal: float (id: 4);
  day: long (id: 5);
  outsiders: [OutsidersSave] (id: 6);
  seen: [SeenAtSave] (id: 7);
  // Which of the last 64 days its people worked there: bit k for day `day - k` (schema 86).
  recent: ulong (id: 8);
}

// Work at a place logged and not yet folded in (schema 62).
struct WorkedSave {
  kind: ubyte;
  place: ulong;
  day: long;
  household: ulong;
  settlement: ulong;
  kcal: float;
}

// A settlement's way of building when it was founded (schema 61): roof pitch in hundredths of a
// degree, height to the eaves and the roof's overhang in centimetres; and its front (schema 169,
// M8d slice DD; 0 before it): openings in thousandths, ornament in tenths of an hour a square
// metre, finish (0 bare, 1 daubed, 2 lime-washed) and symmetry.
table WaySave {
  settlement: ulong (id: 0);
  pitch_centideg: float (id: 1);
  eave_cm: float (id: 2);
  overhang_cm: float (id: 3);
  openings_permille: float (id: 4);
  ornament_dh: float (id: 5);
  finish: float (id: 6);
  symmetry: float (id: 7);
}

// The buildings of other settlements `person` has seen, newest first (schema 59).
table SeenSave {
  person: ulong (id: 0);
  buildings: [ulong] (id: 1);
}

// A household's errand to fetch a good from another settlement to sell at home (schema 58).
table ErrandSave {
  household: ulong (id: 0);
  market: ulong (id: 1);
  seller: ulong (id: 2);
  firm: bool (id: 3);
  // Indices into PlacesSave.goods.
  good: uint (id: 4);
  payment: uint (id: 5);
  // Units it means to buy; what it expects one to fetch at home, hours; the share it keeps.
  units: float (id: 6);
  home_h: float (id: 7);
  share: float (id: 8);
  day: long (id: 9);
  // Schema 143 (M8b slice CO): its way by boat, if any: the boat, the banks it is paddled from
  // and to, the minutes of travel, and of carrying its load to the boat and loading it, and of
  // unloading and carrying it up at home.
  by_boat: bool (id: 10);
  boat: ulong (id: 11);
  boat_from: uint (id: 12);
  boat_to: uint (id: 13);
  travel_min: float (id: 14);
  load_min: float (id: 15);
  unload_min: float (id: 16);
  // Schema 145 (M8b slice CP): its way by cart, if any: the cart (the minutes above are then
  // its travel, its loading at the seller's door and its unloading at home).
  by_cart: bool (id: 17);
  cart: ulong (id: 18);
}

// A good offered in both of a pair of settlements at a month's end (schema 57).
table GapSave {
  month: uint (id: 0);
  a: ulong (id: 1);
  b: ulong (id: 2);
  // Index into PlacesSave.goods.
  good: uint (id: 3);
  // Median asks in each, hours a unit.
  ask_a: float (id: 4);
  ask_b: float (id: 5);
  // What a unit fetched in each that month, hours (-1: none sold).
  paid_a: float = -1 (id: 6);
  paid_b: float = -1 (id: 7);
}

// What people of one settlement carried home from another's market in a month (schema 57).
table CarriedSave {
  month: uint (id: 0);
  from: ulong (id: 1);
  to: ulong (id: 2);
  trips: uint (id: 3);
  walk_h: float (id: 4);
  // Indices into PlacesSave.goods, and the units of each bought.
  goods: [uint] (id: 5);
  units: [float] (id: 6);
}

// Schema 55 (M5a slice AO): households gathered to found a settlement. `lacking`: 0 nothing,
// 1 food, 2 seed; `fate`: 0 gathering, 1 founded, 2 dissolved; `ended` -1 and `settlement` 0
// while none.
table CoalitionSave {
  id: uint (id: 0);
  organizer: ulong (id: 1);
  from: ulong (id: 2);
  site: Point (id: 3);
  formed: long (id: 4);
  reviews: uint (id: 5);
  members: [ulong] (id: 6);
  people: uint (id: 7);
  lacking: ubyte (id: 8);
  fate: ubyte (id: 9);
  ended: long = -1 (id: 10);
  settlement: ulong (id: 11);
  // The person it is named for (0: none).
  named: ulong (id: 12);
}

// Section "floods" (schema 93, M6b slice BF; ADR-0022 §13): high waters, flood episodes,
// storm damages, and storm episodes.
table HighWaterSave {
  id: uint (id: 0);
  reach: ushort (id: 1);
  settlement: ulong (id: 2);
  x: float (id: 3);
  y: float (id: 4);
  began: long (id: 5);
  ended: long = -1 (id: 6);
  peak_discharge: float (id: 7);
  peak_stage: float (id: 8);
  episode: uint (id: 9);
  buildings_flooded: uint (id: 10);
  fields_flooded: uint (id: 11);
  spoiled_kg: float (id: 12);
  scoured_crossings: uint (id: 13);
  // Schema 96: provenance was not recorded in older snapshots.
  origin_known: bool (id: 14);
  observers: [uint] (id: 15);
}

table FloodEpisodeSave {
  id: uint (id: 0);
  settlement: ulong (id: 1);
  first_reach: ushort (id: 2);
  began: long (id: 3);
  ended: long = -1 (id: 4);
  peak_discharge: float (id: 5);
  high_waters: [uint] (id: 6);
  total_spoiled_kg: float (id: 7);
  total_buildings: uint (id: 8);
  total_fields_lost: uint (id: 9);
  // Schema 96: provenance was not recorded in older snapshots.
  origin_known: bool (id: 10);
  observers: [uint] (id: 11);
}

table StormDamageSave {
  id: uint (id: 0);
  building: ulong (id: 1);
  household: ulong (id: 2);
  settlement: ulong (id: 3);
  x: float (id: 4);
  y: float (id: 5);
  time: long (id: 6);
  wind_speed_ms: float (id: 7);
  uplift_pa: float (id: 8);
  episode: uint (id: 9);
  // Schema 96: provenance was not recorded in older snapshots.
  origin_known: bool (id: 10);
  observers: [uint] (id: 11);
}

table StormEpisodeSave {
  id: uint (id: 0);
  settlement: ulong (id: 1);
  began: long (id: 2);
  ended: long = -1 (id: 3);
  peak_wind_speed_ms: float (id: 4);
  damages: [uint] (id: 5);
  // Schema 96: provenance was not recorded in older snapshots.
  origin_known: bool (id: 6);
  observers: [uint] (id: 7);
}

// Schema 95: active observer runoff; older snapshots cannot recover its requested flow.
struct RiverForcingSave {
  reach: uint;
  discharge_m3s: float;
  until_day: long;
  influence: uint;
}

// Schema 96: physical covering evaluations, independently of incident records.
struct StormCheckSave {
  building: ulong;
  group: uint;
  day: long;
  observer: uint;
}

table FloodsSave {
  high_waters: [HighWaterSave] (id: 0);
  flood_episodes: [FloodEpisodeSave] (id: 1);
  storm_damages: [StormDamageSave] (id: 2);
  storm_episodes: [StormEpisodeSave] (id: 3);
  flood_revision: uint = 0 (id: 4);
  reach_discharges: [float] (id: 5);
  river_forcings: [RiverForcingSave] (id: 6);
  storm_checks: [StormCheckSave] (id: 7);
}

// Ways people have worked on (schema 140, M8b slice CM; ADR-0029 §1). A stretch of one: the
// cells it runs through in order along the way; its corridor, built and usable widths, metres;
// `surface` 0 cleared ground, 1 shaped earth, 2 gravel, 3 a timber causeway; `keeper` 0 nobody,
// 1 a household, 2 a polity, `keeper_id` its id; `kept` the day it was last laid or kept.
table WaySegmentSave {
  cells: [uint] (id: 0);
  corridor_m: float (id: 1);
  built_m: float (id: 2);
  usable_m: float (id: 3);
  surface: ubyte (id: 4);
  keeper: ubyte (id: 5);
  keeper_id: ulong (id: 6);
  kept: long (id: 7);
}

// A way: the day work on it began; `modes` bits (1 walking, 2 handcarts, 4 wagons); its trips, faded as of
// `trips_day`; `rank` as last surveyed, 0 a lane, 1 a street, 2 a main way, 3 a way between
// settlements.
table WayLineSave {
  id: ulong (id: 0);
  begun: long (id: 1);
  segments: [WaySegmentSave] (id: 2);
  modes: ubyte (id: 3);
  trips: float (id: 4);
  trips_day: long (id: 5);
  rank: ubyte (id: 6);
  // Schema 180 (M10b slice DV): its track, for a way that serves wagons.
  track: WayTrackSave (id: 7);
}

// A way's track (schema 180, M10b slice DV): the gauge it is laid to, its bed's height at each of
// its way's cells in order, the earth its grading cuts and fills, and the kilograms of its rails'
// good and hours of work laying it takes in all.
table WayTrackSave {
  gauge_m: float (id: 0);
  bed: [float] (id: 1);
  cut_m3: float (id: 2);
  fill_m3: float (id: 3);
  good_kg: float (id: 4);
  labour_h: float (id: 5);
}

table WaysSave {
  list: [WayLineSave] (id: 0);
  revision: uint (id: 1);
}

// Boats (schema 142, M8b slice CO; ADR-0029 §2): each of a vehicle by content id, the household
// it belongs to, the land cell beside the river where it is drawn up, the day it was made and
// the share of its life spent.
table BoatSave {
  id: ulong (id: 0);
  vehicle: string (id: 1);
  owner: ulong (id: 2);
  at: uint (id: 3);
  made: long (id: 4);
  wear: float (id: 5);
  // Schema 144 (M8b slice CO, third part): its labour and the work done on it (a boat saved
  // before has neither: it is made), the hours of walking a year it was expected to save, and
  // the day of the last session begun on it and how many began one then.
  labour_h: float (id: 6);
  work_h: float (id: 7);
  saves_h_year: float (id: 8);
  crew_day: long (id: 9);
  crew: ubyte (id: 10);
}

table BoatsSave {
  list: [BoatSave] (id: 0);
  revision: uint (id: 1);
}

// A line's passing loops (schema 182, M10b slice DW): cell indexes along its way.
table RailLineSave {
  way: ulong (id: 0);
  loops: [uint] (id: 1);
  // Schema 184 (M10b slice DX, second part): whether its ends are stations, the runs a day its
  // timetable sets, and the goods its trains brought since day `freight_since`, kg.
  stations: bool (id: 2);
  runs_a_day: ubyte = 1 (id: 3);
  freight_kg: float (id: 4);
  freight_since: long (id: 5);
  // Schema 185 (M10b slice DX, fourth part): the rides taken since `freight_since`, and the fare
  // a ride costs, kg of its engines' fuel.
  riders: uint (id: 6);
  fare_kg: float (id: 7);
}

// A train run (schema 182): its line and direction, its engine and owner, its legs (each
// section's index along the line and its minutes, in the order run), the leg it is on, where it
// is (0 waiting since `time`, 1 running until `time`, 2 arrived at `time`, minutes) and the goods
// it carries, kg.
table RunSave {
  id: ulong (id: 0);
  way: ulong (id: 1);
  back: bool (id: 2);
  engine: ulong (id: 3);
  owner: ulong (id: 4);
  sections: [ushort] (id: 5);
  minutes: [uint] (id: 6);
  leg: ushort (id: 7);
  state: ubyte (id: 8);
  time: long (id: 9);
  load_kg: float (id: 10);
  // Schema 183 (M10b slice DW, third part): the wagons it pulls.
  cars: [ulong] (id: 11);
}

table RunsSave {
  lines: [RailLineSave] (id: 0);
  list: [RunSave] (id: 1);
  revision: uint (id: 2);
}

// Gas mains and connections (schema 186, M10b slice DY, third part; ADR-0034 §8): each main's
// works household, the cells it runs along, the most gas it carries an hour, kg, and whether it is
// broken; each connection's building, household, main, burners and whether cut off, and its last
// evening: the day checked and the minutes lit from and until (-1 none), and why it lit or not (0
// served, 1 no gas, 2 overloaded, 3 broken, 4 cut off).
table GasMainSave {
  id: ulong (id: 0);
  works: ulong (id: 1);
  cells: [uint] (id: 2);
  capacity_kg_h: float (id: 3);
  broken: bool (id: 4);
  // Schema 187 (M10b slice DY, third part, second step): its length and how much of it is laid,
  // metres; before, both 0, whole.
  length_m: float (id: 5);
  laid_m: float (id: 6);
  // Schema 188 (M10b slice DY, fourth part, second step): the hours a year its works reckoned
  // the homes along it would repay when it began it; before, 0.
  worth_h: float (id: 7);
}

table GasConnectionSave {
  building: ulong (id: 0);
  household: ulong (id: 1);
  main: ulong (id: 2);
  burners: ubyte (id: 3);
  cut_off: bool (id: 4);
  evening: long = -1 (id: 5);
  lit_from: long = -1 (id: 6);
  lit_until: long = -1 (id: 7);
  cause: ubyte (id: 8);
}

// A street lamp a polity set on its ways by law (schema 189, M10b slice DY, fourth part, third
// step): its cell, polity, law, and the minute it burns until once lit (-1 never lit).
table StreetLampSave {
  cell: uint (id: 0);
  polity: ulong (id: 1);
  law: ulong (id: 2);
  lit_until: long = -1 (id: 3);
}

table GasSave {
  mains: [GasMainSave] (id: 0);
  connections: [GasConnectionSave] (id: 1);
  // Schema 189: its street lamps; before, none.
  lamps: [StreetLampSave] (id: 2);
}

// Goods in transit (schema 143, M8b slice CO; ADR-0029 §3): each load's owner household, carrier
// and boat, the settlements it is from and bound for, when it was loaded and when what it holds
// was last brought up to date, and what it holds by good content id.
table ConsignedGoodSave {
  good: string (id: 0);
  amount: double (id: 1);
}

table ConsignmentSave {
  id: ulong (id: 0);
  owner: ulong (id: 1);
  carrier: ulong (id: 2);
  boat: ulong (id: 3);
  from: ulong (id: 4);
  to: ulong (id: 5);
  made: long (id: 6);
  stores_at: long (id: 7);
  goods: [ConsignedGoodSave] (id: 8);
}

// Schema 209 (M10d slice EG, second part; ADR-0027 §4): goods one household keeps for another
// under its roof, the depositor's throughout; `since` and `fee_day` are day indexes.
table KeptSave {
  id: ulong (id: 0);
  depositor: ulong (id: 1);
  keeper: ulong (id: 2);
  since: long (id: 3);
  fee_day: long (id: 4);
  stores_at: long (id: 5);
  goods: [ConsignedGoodSave] (id: 6);
  // Schema 210 (slice EG, third part): the receipt the keeper's household wrote for them, if
  // any: who wrote it (0 for none) and the day.
  receipt_by: ulong (id: 7);
  receipt_day: long (id: 8);
  // Schema 211 (M10d slice EH): its receipt was written as notes, its goods backing them.
  noted: bool (id: 9);
}

// Schema 211 (M10d slice EH): one keeper's notes in one good: its number, its issuer household,
// the good a piece is redeemed in (a content id) and kilograms of it a piece pays, pieces
// outstanding, pieces presented and refused since first written, and the last day one was
// refused (-1 for none).
table NoteIssueSave {
  id: uint (id: 0);
  issuer: ulong (id: 1);
  good: string (id: 2);
  kg: float (id: 3);
  count: double (id: 4);
  presented: double (id: 5);
  refused: double (id: 6);
  refused_day: long = -1 (id: 7);
  // Schema 212 (M10d slice EI): pieces its issuer wrote as loans.
  lent: double (id: 8);
  // Schema 213 (M10d slice EI, second part): the last day a debtor of its loans defaulted, the
  // pieces presented in the week begun on `seen_day`, and the day before which its issuer pays
  // none; -1 for none.
  defaulted_day: long = -1 (id: 9);
  seen: double (id: 10);
  seen_day: long = -1 (id: 11);
  suspended_until: long = -1 (id: 12);
}

table ConsignmentsSave {
  list: [ConsignmentSave] (id: 0);
  // Schema 209: goods kept for others, in the order left.
  kept: [KeptSave] (id: 1);
  // Schema 211: note issues, in the order first written, and the purses holding their pieces, by
  // holder and issue.
  note_issues: [NoteIssueSave] (id: 2);
  note_purses: [PurseSave] (id: 3);
}

// Turn-taking at bottlenecks (schema 141, M8b slice CN; ADR-0029 §4). A facility as in
// `TripAheadSave` (`kind`, `id`, `sector`); a direction of one that has passed someone lately
// and the slots it gave in its memory, seconds from the calendar origin, in order.
table TrafficServerSave {
  kind: ubyte (id: 0);
  id: ulong (id: 1);
  sector: ushort (id: 2);
  dir: ubyte (id: 3);
  slots: [double] (id: 4);
}

// A facility's passages and minutes waited by hour of the day (24 each), fading, as of `day`; the
// walkers who stood short of its approach; its longest wait remembered and the day of it.
table TrafficTallySave {
  kind: ubyte (id: 0);
  id: ulong (id: 1);
  sector: ushort (id: 2);
  day: long (id: 3);
  passages: [float] (id: 4);
  waited_min: [float] (id: 5);
  held_short: float (id: 6);
  longest_min: float (id: 7);
  longest_day: long (id: 8);
}

// What a household holds of its waits at a facility: minutes and times, fading, as of `day`.
struct TrafficWaitSave {
  household: ulong;
  id: ulong;
  day: long;
  minutes: float;
  waits: float;
  sector: ushort;
  kind: ubyte;
}

// A wait worth telling (M8b slice CN): its number, the walker, their household and settlement
// (0 none), the facility (as in `TripAheadSave`), where and when they reached it, minutes from the
// calendar origin, the minutes they waited and the walkers ahead of them.
struct TrafficLongWaitSave {
  person: ulong;
  household: ulong;
  settlement: ulong;
  id: ulong;
  time: long;
  wait_id: uint;
  x: float;
  y: float;
  minutes: float;
  ahead: uint;
  sector: ushort;
  kind: ubyte;
}

// What a household holds of the hours its trips lost at a site of a way (M8b slice CQ): the cell,
// the cause (0 a climb, 1 too narrow for two carts), hours and times, fading, as of `day`.
struct TrafficLossSave {
  household: ulong;
  day: long;
  cell: uint;
  hours: float;
  times: float;
  cause: ubyte;
}

// Travel measured (schema 152, M8b slice CR, first part): trips or waits and their minutes, by
// the code of what they are counted under (a behaviour's for a purpose, a mode's).
struct TravelTallySave {
  minutes: double;
  trips: uint;
  code: ubyte;
}

// A settlement's year of travel: its trips by purpose and by mode, its waits, and its residents'
// days by occupation (4) and band of the day's travel (8), with their minutes by occupation.
table TravelYearSave {
  year: long (id: 0);
  settlement: ulong (id: 1);
  purposes: [TravelTallySave] (id: 2);
  modes: [TravelTallySave] (id: 3);
  waits_trips: uint (id: 4);
  waits_minutes: double (id: 5);
  days: [uint] (id: 6);
  minutes: [double] (id: 7);
}

// Someone's minutes of travel so far today.
struct TravelTodaySave {
  person: ulong;
  minutes: float;
}

// What a household holds of its members' days of travel (schema 153): their minutes and the
// member-days they came to, fading, as of `day`.
struct TravelHouseholdSave {
  minutes: double;
  days: double;
  household: ulong;
  day: long;
}

// Where someone has gone from home (schema 154, M8c slice CS, first part): trips from their
// household's home to a place (a block of map cells), fading, as of `day`; one per place.
struct TravelGoingSave {
  person: ulong;
  day: long;
  place: uint;
  trips: float;
}

// A trip from home set off on today (schema 155): held at midnight.
struct TravelGoingTodaySave {
  person: ulong;
  place: uint;
}

table TrafficSave {
  servers: [TrafficServerSave] (id: 0);
  tallies: [TrafficTallySave] (id: 1);
  waits: [TrafficWaitSave] (id: 2);
  long_waits: [TrafficLongWaitSave] (id: 3);
  // Schema 148.
  losses: [TrafficLossSave] (id: 4);
  // Schema 152 (M8b slice CR, first part): travel measured; absent before.
  travel_years: [TravelYearSave] (id: 5);
  travel_today: [TravelTodaySave] (id: 6);
  // Schema 153 (M8b slice CR, second part); absent before.
  travel_households: [TravelHouseholdSave] (id: 7);
  // Schema 154 (M8c slice CS, first part); absent before.
  travel_goings: [TravelGoingSave] (id: 8);
  // Schema 155 (M8c slice CS, second part); absent before (a save's trips of its day go uncounted).
  travel_going_today: [TravelGoingTodaySave] (id: 9);
}

// Shaking (schema 162, M8d slice DA; ADR-0031 §4): each time the observer shook the ground and
// what every building it reached did. `settlement` 0 for the whole map; `outcome` 0 stood, 1
// cracked, 2 fell; `cracked` the groups that cracked; `z` the building's response draw and `cs`
// the share of its weight it met sideways.
table ShakenSave {
  building: ulong (id: 0);
  household: ulong (id: 1);
  settlement: ulong (id: 2);
  z: float (id: 3);
  cs: float (id: 4);
  outcome: ubyte (id: 5);
  cracked: [uint] (id: 6);
  deaths: ushort (id: 7);
}

table QuakeSave {
  id: uint (id: 0);
  influence: uint (id: 1);
  at: long (id: 2);
  strength: float (id: 3);
  settlement: ulong (id: 4);
  origin_known: bool (id: 5);
  observers: [uint] (id: 6);
  shaken: [ShakenSave] (id: 7);
}

table QuakesSave {
  quakes: [QuakeSave] (id: 0);
}
