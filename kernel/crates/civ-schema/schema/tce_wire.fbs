// The Civilization Engine boundary schema: payloads of commons-wire frames (ADR-0001).
//
// The root table of a payload is chosen by the frame kind:
//   Hello -> Hello, Welcome -> Welcome, Snapshot -> Snapshot, Events -> Events,
//   Command -> Command, Query -> Query, Response -> Response, Error -> ErrorInfo.
//
// Evolution rules (ADR-0001): every field has an explicit id; never renumber, reuse, retype or
// remove a field (deprecate it); never reorder enum values or union members; append only.
// Additive changes bump the schema minor (civ-schema WIRE_SCHEMA_MINOR); anything else is a
// major bump and an ADR.

namespace tce.wire;

// Elevation is the ground in use: since wire 1.20 (M3b slice Q, ADR-0010 §3), the generated bed
// plus what earthworks have done to it. Water, drainage and lakes stay as generated.
enum RasterLayer : ubyte { Elevation = 0, Water = 1, DrainageArea = 2, LakeId = 3, FloodDepth = 4 }

enum RasterFormat : ubyte { U8 = 0, U16 = 1, U32 = 2, F32 = 3 }

enum EventKind : ubyte { Info = 0, WorldCreated = 1, Saved = 2, Loaded = 3, Autosaved = 4, Warning = 5, Failure = 6 }

enum ErrorCode : ushort { Unknown = 0, BadRequest = 1, Busy = 2, NoWorld = 3, NotFound = 4, Incompatible = 5, Internal = 6 }

enum Sex : ubyte { Female = 0, Male = 1 }

// Wire 1.23 (M3c slice S, ADR-0011): how the kernel advances. Detailed (1x-10x) lives every event
// as it falls; Accelerated (60x, 600x, Max) a day at a time, its frames standing at midnight with
// nobody on a trip, so observers must not carry walkers along between frames.
enum ClockMode : ubyte { Detailed = 0, Accelerated = 1 }

// Where a field is in its year (M1 slice C).
enum FieldStage : ubyte { Fallow = 0, Prepared = 1, Sown = 2, Reaped = 3 }

struct Vec2 {
  x: float;
  y: float;
}

// ---- Handshake ---------------------------------------------------------------------------

table Hello {
  client: string (id: 0);
}

table PresetInfo {
  id: string (id: 0);
  name: string (id: 1);
  description: string (id: 2);
  is_default: bool (id: 3);
}

// An authored activity, in the order PersonBrief.activity and decisions index.
table ActivityInfo {
  id: string (id: 0);
  // "Gather plants".
  name: string (id: 1);
  // "gathering wild plants".
  doing: string (id: 2);
}

// A good people carry and keep (M1 slice B). Stores and loads refer to goods by their index in
// Welcome.goods.
table GoodInfo {
  id: string (id: 0);
  // "Meat".
  name: string (id: 1);
  // "food", "fuel", "material" or "tool" (M3a).
  purpose: string (id: 2);
  // Food energy, kcal per kilogram (0 for fuel).
  kcal_per_kg: float (id: 3);
  // M3a: how it is eaten: "raw", "cooked" or "never" (a recipe must make it food first).
  eaten: string (id: 4);
  // M3a: for a tool, the hours of use a standard tool lasts (stores count tools in standard
  // tools); 0 for other goods, which stores count in kilograms.
  tool_life_h: float (id: 5);
}

// A skill people get better at with practice (M3a). PersonInfo.skills refers to skills by their
// index in Welcome.skills.
table SkillInfo {
  id: string (id: 0);
  // "Milling".
  name: string (id: 1);
}

// A person's level in a skill, 0-1 (M3a).
struct SkillLine {
  skill: ushort;
  level: float;
}

// A crop people grow (M1 slice C). Fields refer to crops by their index in Welcome.crops.
table CropInfo {
  id: string (id: 0);
  // "Emmer wheat".
  name: string (id: 1);
  // Indexes into Welcome.goods: the grain it yields and the seed it is sown from.
  good: ushort (id: 2);
  seed_good: ushort (id: 3);
}

// A technique people know, learn and can lose (M3b slice M; ADR-0008). PersonInfo.knows and
// Knowledge refer to techniques by their index in Welcome.techniques.
// Wire 1.47 (M4c slice AJ): an ideology content names, for the observer's god tool.
table IdeologyInfo {
  id: string (id: 0);
  // "Common provision".
  name: string (id: 1);
  // Its legitimacy story in words.
  legitimacy: string (id: 2);
}

// Wire 1.62 (M6a slice AZ, step four; ADR-0021 §8): a disease the observer may bring to a
// person: its content id, its name ("Cholera") and the ways it passes, in words ("by water and
// between those who share a home").
table DiseaseInfo {
  id: string (id: 0);
  name: string (id: 1);
  routes: string (id: 2);
}

table TechniqueInfo {
  id: string (id: 0);
  // "Shaping stone".
  name: string (id: 1);
  // What a competent person can do, completing "A competent person can ...".
  can: string (id: 2);
  // Index into Welcome.skills of the skill whose practice it is, or -1.
  domain: int = -1 (id: 3);
  // Its prerequisites in words ("Shaping wood and Knapping, or Quarrying"); empty for none.
  requires: string (id: 4);
  // Hours of work beside someone who knows it that teach it.
  learn_h: float (id: 5);
  // Children brought up in a household that knows it learn it at the work's age.
  upbringing: bool (id: 6);
}

// A consideration or exclusion reason that decision receipts refer to by code.
table ReasonInfo {
  code: ushort (id: 0);
  label: string (id: 1);
}

// A property regime (M3a slice K; ADR-0007): who holds, works, lets and inherits land. Content
// authors the rules; which ground anyone breaks, works or lets is decided at run time.
table RegimeInfo {
  id: string (id: 0);
  name: string (id: 1);
  description: string (id: 2);
  // The regime a new world is made under unless it chooses another.
  is_default: bool (id: 3);
  // Its rules, rendered by the kernel, one sentence each.
  rules: [string] (id: 4);
}

table Welcome {
  host: string (id: 0);
  version: string (id: 1);
  presets: [PresetInfo] (id: 2);
  // Map sizes the host offers, in cells per side.
  map_sizes: [uint] (id: 3);
  cell_size_m: float (id: 4);
  content_fingerprint: string (id: 5);
  // The size the new-world dialog selects first.
  default_map_size: uint (id: 6);
  // Simulated seconds per real second at 1x, and the speeds offered, as multiples of 1x.
  speed_1x: float (id: 7);
  speed_multipliers: [float] (id: 8);
  // The activity catalogue and receipt reasons (M1).
  activities: [ActivityInfo] (id: 9);
  reasons: [ReasonInfo] (id: 10);
  // Founding band sizes the new-world dialog offers.
  band_size_min: uint (id: 11);
  band_size_max: uint (id: 12);
  band_size_default: uint (id: 13);
  // The goods catalogue (M1 slice B).
  goods: [GoodInfo] (id: 14);
  // The crops catalogue (M1 slice C).
  crops: [CropInfo] (id: 15);
  // The skills catalogue (M3a).
  skills: [SkillInfo] (id: 16);
  // The property regimes a new world can be made under (M3a slice K).
  regimes: [RegimeInfo] (id: 17);
  // The techniques (M3b slice M).
  techniques: [TechniqueInfo] (id: 18);
  // Wire 1.23 (M3c slice S): the Accelerated speeds as multiples of 1x, after the Detailed ones in
  // speed_multipliers: 60, 600 and Max, which is infinite.
  accelerated_multipliers: [float] (id: 19);
  // Wire 1.47 (M4c slice AJ): the ideologies, which the observer may tell someone of.
  ideologies: [IdeologyInfo] (id: 20);
  // Wire 1.62 (M6a slice AZ, step four): the diseases, which the observer may bring to someone.
  diseases: [DiseaseInfo] (id: 21);
}

// ---- Snapshot: replaceable host and world state --------------------------------------------

table Clock {
  // Simulation minutes since the calendar origin.
  minute: long (id: 0);
  year: long (id: 1);
  month: ubyte (id: 2);
  day: ubyte (id: 3);
  hour: ubyte (id: 4);
  minute_of_hour: ubyte (id: 5);
  season: string (id: 6);
  paused: bool (id: 7);
  // Simulated seconds per real second while running; infinite for Max (wire 1.23).
  speed: float (id: 8);
  // Wire 1.23: how the kernel advances now. A change of speed that changes it takes effect at the
  // next midnight.
  mode: ClockMode (id: 9);
  // Wire 1.24 (M3c slice U, ADR-0012): today's weather on the valley floor.
  weather: DayWeather (id: 10);
}

// Wire 1.24 (M3c slice U, ADR-0012 §1): today's weather on the valley floor, at the height the
// land profile's normals are for.
table DayWeather {
  // Rain and snow today, mm of water.
  precip_mm: float (id: 0);
  mean_c: float (id: 1);
  min_c: float (id: 2);
  max_c: float (id: 3);
  // Snow lying, mm of water.
  snow_mm: float (id: 4);
  // The soil water under the wild cover, as a share of what the soil holds.
  soil: float (id: 5);
  // In words, rendered by the kernel: "6 °C, light rain; snow lying".
  words: string (id: 6);
  // Wire 1.25: the lowest height at which snow lies, metres (the foot of the lowest 100 m band
  // with 5 mm of water or more lying); infinite when it lies nowhere.
  snow_line_m: float = inf (id: 7);
  // Wire 1.67 (M6b slice BC; ADR-0022 §2): the day's mean wind, m/s, the direction it blows from
  // (degrees clockwise from north, the map's top), its strongest gust, m/s, the water exposed
  // fuel such as thatch holds as a share of its dry mass, and that share on an average day.
  wind_ms: float (id: 8);
  wind_from_deg: float (id: 9);
  gust_ms: float (id: 10);
  fuel_moisture: float (id: 11);
  fuel_usual: float (id: 12);
  // Rendered by the kernel: "a gentle breeze from the west-south-west; thatch drier than usual".
  wind_words: string (id: 13);
}

table WorldInfo {
  world_id: string (id: 0);
  name: string (id: 1);
  seed: ulong (id: 2);
  preset_id: string (id: 3);
  width: uint (id: 4);
  height: uint (id: 5);
  cell_size_m: float (id: 6);
  sea_level_m: float (id: 7);
  min_elevation_m: float (id: 8);
  max_elevation_m: float (id: 9);
  generator_version: uint (id: 10);
  lakes: uint (id: 11);
  reaches: uint (id: 12);
  river_length_km: float (id: 13);
  max_discharge_m3s: float (id: 14);
  gentle_land_fraction: float (id: 15);
  land_fraction: float (id: 16);
  ocean_fraction: float (id: 17);
  // Generation of the last save this world was written to or loaded from (0 = unsaved).
  generation: ulong (id: 18);
  // The world was made with different content than is loaded now.
  content_changed: bool (id: 19);
  created_unix_ms: long (id: 20);
  // The property regime it lives under, fixed when it was made (M3a slice K).
  regime_id: string (id: 21);
  regime_name: string (id: 22);
}

table Task {
  name: string (id: 0);
  stage: string (id: 1);
  fraction: float (id: 2);
  cancellable: bool (id: 3);
}

// Offered after the host stopped unexpectedly: the last good save to resume from.
table Recovery {
  reason: string (id: 0);
  save_file: string (id: 1);
  save_label: string (id: 2);
  sim_minute: long (id: 3);
  world_name: string (id: 4);
}

// One living person, compactly (ADR-0003 §2.3). Trip geometry is fetched with GetTrips when an
// observer sees a trip id or revision it does not have.
table PersonBrief {
  id: ulong (id: 0);
  // Where they are at the snapshot's minute, metres from the map's north-west corner.
  pos: Vec2 (id: 1);
  // Index into Welcome.activities.
  activity: ushort (id: 2);
  // The walk they are on (0 = none) and its revision.
  trip: ulong (id: 3);
  trip_rev: uint (id: 4);
  sex: Sex (id: 5);
  age_years: float (id: 6);
  household: ulong (id: 7);
  asleep: bool (id: 8);
}

table SettlementBrief {
  id: ulong (id: 0);
  name: string (id: 1);
  hearth: Vec2 (id: 2);
  founded_minute: long (id: 3);
  // Living people whose household belongs to it.
  population: uint (id: 4);
  // Days of food in its households' stores at its people's needs (M1 slice B).
  food_days: float (id: 5);
  // Its food has run short and not yet recovered.
  food_short: bool (id: 6);
  // Grain threshed from its fields this harvest, kilograms (M1 slice C).
  harvest_kg: float (id: 7);
  // How it was founded, in words (wire 1.49, ADR-0018 §1): "one of the groups the world began
  // with", "by a family the observer sent".
  founding: string (id: 8);
  // Its accounts over the past year, in words (ADR-0018 §3): "3 born, 1 died, 4 came from beyond
  // the map"; empty when nothing changed.
  year: string (id: 9);
  // When its last resident died or left (-1: it is lived in).
  abandoned_minute: long = -1 (id: 10);
  // Wire 1.51 (M5a slice AM): visits and marriages between it and other settlements last year
  // and this year so far, in words ("in year 2: 12 visits from Ashford, 7 hours at the hearth
  // here; 3 visits to Ashford"); empty when there were none.
  contacts: string (id: 11);
  // Wire 1.53 (M5a slice AO): households of it gathered to found a settlement, still gathering or
  // ended in the past year, each in words ("Ada's household gathers 2 more households, 14
  // people, to found a settlement 3.1 km north, since the spring of year 2; lacks seed").
  coalitions: [string] (id: 12);
  // Wire 1.56 (M5b slice AR): its way of building on the three clocks, in words: how it was
  // founded to build, how its households would build now, how the year's new buildings and its
  // standing buildings were built, and how many of the new follow a building elsewhere.
  style: string (id: 13);
}

// Wire 1.74 (M6c slice BJ, ADR-0023 §11): a band not yet home or dispersed: the settlement it is
// of, its stage (0 called, 1 out), who of it are going (before the muster those who said they
// would, after it those who came and are not yet home), the home it goes to, and in words.
table BandBrief {
  id: uint (id: 0);
  from: ulong (id: 1);
  stage: ubyte (id: 2);
  members: [ulong] (id: 3);
  target: Vec2 (id: 4);
  words: string (id: 5);
}

table Snapshot {
  world: WorldInfo (id: 0);
  clock: Clock (id: 1);
  task: Task (id: 2);
  recovery: Recovery (id: 3);
  last_error: string (id: 4);
  // Unix milliseconds of the last autosave of the current world (0 = none yet).
  last_autosave_unix_ms: long (id: 5);
  // M1: the living, the settlements, and the newest chronicle entry's sequence number (0 = none).
  people: [PersonBrief] (id: 6);
  settlements: [SettlementBrief] (id: 7);
  chronicle_head: ulong (id: 8);
  // M1 slice C: changes whenever a field is marked out or changes stage (0 = no fields). Fetch
  // the fields with GetFields when it differs from the revision last fetched.
  fields_rev: ulong (id: 9);
  // M1 slice D: changes whenever ground is claimed for a building or a building's work moves on
  // (0 = none). Fetch them with GetBuildings when it differs from the revision last fetched.
  buildings_rev: ulong (id: 10);
  // M1 slice F: changes whenever the paths are surveyed, monthly and on load (0 = never). Fetch
  // the worn ground and trails with GetPaths when it differs from the revision last fetched.
  paths_rev: ulong (id: 11);
  // M3a slice I: changes whenever a household posts terms, a trade is made or a want goes unmet
  // (0 = nothing offered or traded yet). Fetch the markets with GetMarkets when it differs from
  // the revision last fetched.
  markets_rev: ulong (id: 12);
  // M3a slice J: changes whenever a workshop opens, closes, makes, sells, pays or is reviewed
  // (0 = no workshop yet). Fetch the workshops with GetFirms, and a workshop's page with GetFirm,
  // when it differs from the revision last fetched.
  firms_rev: ulong (id: 13);
  // M3a slice K: changes at the start of each month, when households form or end and when a
  // year's wealth measures are recorded (0 = no households). Fetch the measures with GetWealth
  // when it differs from the revision last fetched.
  wealth_rev: ulong (id: 14);
  // M3b slice M: changes whenever someone comes to know, learns toward, hears of or loses a
  // technique, and when people arrive, leave or die (0 = no people). Fetch the settlements'
  // knowledge with GetKnowledge when it differs from the revision last fetched.
  knowledge_rev: ulong (id: 15);
  // Wire 1.19 (M3b slice Q): changes whenever a deposit is laid down, found or dug from (0 = no
  // deposits). Fetch the deposits with GetDeposits when it differs from the revision last fetched.
  deposits_rev: ulong (id: 16);
  // Wire 1.20 (M3b slice Q): changes whenever an earthwork is begun or advanced (0 = none). Fetch
  // the earthworks with GetEarthworks when it differs from the revision last fetched.
  earthworks_rev: ulong (id: 17);
  // Wire 1.24 (M3c slice U): changes each day lived (0 = no world). Fetch the weather's record
  // with GetWeather when it differs from the revision last fetched.
  weather_rev: ulong (id: 18);
  // Wire 1.60 (M5c slice AW): changes whenever a crossing is begun, worked on, opens, rots or
  // gives way (0 = none). Fetch the crossings with GetCrossings when it differs from the revision
  // last fetched.
  crossings_rev: ulong (id: 19);
  // Wire 1.61 (M6a slice AY): changes whenever a well is begun, dug deeper, opens, rots, is
  // relined, given up or falls in, and with each day lived while the world has wells or springs
  // (0 = neither). Fetch them with GetWater when it differs from the revision last fetched.
  water_rev: ulong (id: 20);
  // Wire 1.64 (M6a slice BB, ADR-0015 §8): changes whenever an incident or an outbreak opens,
  // moves on or ends, or what people know of one or what a polity did about one changes (0 = no
  // incident yet). Fetch them with GetIncidents when it differs from the revision last fetched.
  incidents_rev: ulong (id: 21);
  // Wire 1.74 (M6c slice BJ): the bands not yet home or dispersed.
  bands: [BandBrief] (id: 22);
}

// ---- Events: ordered log -------------------------------------------------------------------

table Event {
  id: ulong (id: 0);
  sim_minute: long (id: 1);
  unix_ms: long (id: 2);
  kind: EventKind (id: 3);
  text: string (id: 4);
}

table Events {
  events: [Event] (id: 0);
}

// ---- Commands: change state ----------------------------------------------------------------

table NewWorld {
  seed: ulong (id: 0);
  preset_id: string (id: 1);
  size_cells: uint (id: 2);
  name: string (id: 3);
  // People in the founding band; 0 = the content's default.
  band_size: uint (id: 4);
  // The property regime, by content id; empty = the content's default (M3a slice K).
  regime_id: string (id: 5);
  // People in each further founding group, a band of its own placed together with the first
  // (wire 1.49, ADR-0018 §6); 0 = the content's default. At most two.
  neighbours: [uint] (id: 6);
  // Whether the founding groups know where each other camped when they arrive (wire 1.50,
  // ADR-0018 §6); otherwise each finds the others only by contact.
  neighbours_known: bool (id: 7);
}

table SaveWorld {
  label: string (id: 0);
}

table LoadWorld {
  // A file name from SaveList.
  file: string (id: 0);
}

table SetClock {
  paused: bool (id: 0);
  // Simulated seconds per real second: 1x to 600x, or infinite for Max (wire 1.23).
  speed: float (id: 1);
}

table CancelTask {}

table RecoverWorld {
  // true: load the offered save; false: dismiss the offer.
  accept: bool (id: 0);
}

// M1 slice G: the observer sends a family to a point on the map (god tool). It joins the
// settlement there or makes camp on the spot.
table SpawnFamily {
  at: Vec2 (id: 0);
  // M3a slice L: how many families come together (0 = one; the host sends at most 20). The
  // first comes where `at` says, the others around it.
  families: uint (id: 1);
}

// M1 slice G: run ahead to a time, as fast as the machine allows, in full detail. Shown as a
// task; CancelTask stops it. The clock is paused when it arrives.
table RunUntil {
  minute: long (id: 0);
}

// M3b slice M: the observer introduces a technique (god tool, ADR-0008 §6): a living person comes
// to know it, as if they had learnt it elsewhere, or with `aware_only` only hears of it.
table IntroduceTechnique {
  person: ulong (id: 0);
  // Index into Welcome.techniques.
  technique: uint (id: 1);
  aware_only: bool (id: 2);
}

// Wire 1.19 (M3b slice Q): the observer lays down a deposit (god tool, ADR-0010 §1): a disc of
// `radius_m` of `good` (a good's content id) at `at`, showing at the surface or under the cover the
// land profile gives it. Refused off dry land, for an unknown good or a radius outside 1-200 m.
table PlaceDeposit {
  at: Vec2 (id: 0);
  good: string (id: 1);
  radius_m: float (id: 2);
  exposed: bool (id: 3);
}

// Wire 1.47 (M4c slice AJ, ADR-0016 §5): the observer whispers a true claim to a person: one
// their settlement's word holds and they have not heard (PersonInfo.news). A repeat refreshes it.
table Whisper {
  person: ulong (id: 0);
  claim: uint (id: 1);
}

// Wire 1.47 (M4c slice AJ, ADR-0016 §5): the observer tells a person of an ideology (an index
// into Welcome.ideologies); they weigh it as one heard of from no one. A repeat draws nothing new.
table TellOfIdeology {
  person: ulong (id: 0);
  ideology: uint (id: 1);
}

// Wire 1.48 (M4c slice AJ, step two; ADR-0016 §5): the observer sends one adult newcomer holding
// an ideology (an index into Welcome.ideologies), placed as a family is (SpawnFamily).
table SendAgitator {
  at: Vec2 (id: 0);
  ideology: uint (id: 1);
}

// Wire 1.48: the observer blesses a living person, or curses them, for `days` days (1-3650),
// moving their own draws for illness or accident and for finding things out by `share` of their
// way (0.05-0.5). One of the same kind in force is refreshed; one of the other kind ends.
table Bless {
  person: ulong (id: 0);
  curse: bool (id: 1);
  days: uint (id: 2);
  share: float (id: 3);
}

// Wire 1.52 (M5a slice AN, ADR-0016 §5): the observer sends a migration wave: `households`
// households (5-50) of one band come to `at` from the map's edge nearest it over `days` days (1-7),
// each carrying `months` months of food (0-12).
table SendWave {
  at: Vec2 (id: 0);
  households: uint (id: 1);
  days: uint (id: 2);
  months: uint (id: 3);
}

// Wire 1.62 (M6a slice AZ, step four; ADR-0021 §8): the observer brings a disease (an index into
// Welcome.diseases) to a living person, as if they took it elsewhere. Refused while it runs in
// them or one they lived through still protects them.
table Plague {
  person: ulong (id: 0);
  disease: uint (id: 1);
}

// Wire 1.63 (M6a slice BA, step five; ADR-0021 §8): the observer holds back the rain for
// `months` months (3 to 24), the weather's slow anomaly held `depth` standard deviations dry (0
// to 3). A use while one holds makes it end `months` from now.
table Drought {
  months: uint (id: 0);
  depth: float (id: 1);
}

// Wire 1.68 (M6b slice BC, step three; ADR-0022 §14): the observer sets a building's covering
// alight; it burns as any fire does, and what follows is the fire's and people's. Refused for a
// building that is not roofed, already burns, or has no covering left to burn.
table SetFire {
  building: ulong (id: 0);
}

// Wire 1.69 (M6b slice BF; ADR-0022 §14): the observer raises reach runoff for stated days.
table RaiseRiver {
  reach: uint (id: 0);
  discharge_m3s: float (id: 1);
  days: uint (id: 2);
}

// Wire 1.69 (M6b slice BF; ADR-0022 §14): the observer sends a storm today of chosen strength and direction.
table SendStorm {
  wind_speed_ms: float (id: 0);
  direction_deg: float (id: 1);
}

union CommandBody { NewWorld, SaveWorld, LoadWorld, SetClock, CancelTask, RecoverWorld, SpawnFamily, RunUntil, IntroduceTechnique, PlaceDeposit, Whisper, TellOfIdeology, SendAgitator, Bless, SendWave, Plague, Drought, SetFire, RaiseRiver, SendStorm }

table Command {
  body: CommandBody (id: 1);
}

// ---- Queries: read state -------------------------------------------------------------------

table GetRaster {
  layer: RasterLayer (id: 0);
  // Downsampling level: each level halves the resolution.
  level: ubyte (id: 1);
  // Region in cells of the requested level.
  x0: uint (id: 2);
  y0: uint (id: 3);
  width: uint (id: 4);
  height: uint (id: 5);
}

table GetHydrography {
  // Polyline simplification tolerance, metres.
  tolerance_m: float (id: 0);
}

table ListSaves {}

// Trip geometry by trip id.
table GetTrips {
  ids: [ulong] (id: 0);
}

// Everything the inspector shows about one person, living or dead.
table GetPerson {
  id: ulong (id: 0);
  // Decision receipts to include, newest first (at most 64).
  decisions: uint (id: 1);
}

// Chronicle entries with sequence numbers after `after_seq`, oldest first.
table GetChronicle {
  after_seq: ulong (id: 0);
  limit: uint (id: 1);
}

// Every field, with its state (M1 slice C).
table GetFields {}

// Every building, with its state and what its grammar expands it to (M1 slice D).
table GetBuildings {}

// The worn ground and the trails, as last surveyed (M1 slice F).
table GetPaths {}

// Every settlement's market: what is offered and on what terms, what sold, what was wanted and
// found no seller, and the money if there is one (M3a slice I).
table GetMarkets {}

// Every workshop, in brief (M3a slice J).
table GetFirms {}

// One workshop's page: what it holds, its terms, its wage and its books (M3a slice J).
table GetFirm {
  id: ulong (id: 0);
}

// Every settlement's wealth measures: as they stand, each household's, and at the end of each
// year (M3a slice K).
table GetWealth {}

// What each settlement knows: each technique's knowers, learners and history (M3b slice M).
table GetKnowledge {}

// Every deposit in the ground and who knows it (wire 1.19, M3b slice Q).
table GetDeposits {}

// Every earthwork and the tiles of ground they have changed (wire 1.20, M3b slice Q).
table GetEarthworks {}

// Every month's weather on the valley floor, with what each usually brings (wire 1.24, M3c
// slice U).
table GetWeather {}

// Wire 1.26 (M4a slice Y): each settlement's standing as last worked out.
table GetStanding {}

// Every settlement's polity, its laws and their histories (wire 1.27, ADR-0013).
table GetGovernment {}

// Wire 1.30 (M4b slice AA, ADR-0015 §7): takings, with what happened and what people believe in
// separate tables, joined only by an incident's number.
table GetOrder {}
// Wire 1.60 (M5c slice AW): every crossing over water.
table GetCrossings {}

// Wire 1.61 (M6a slice AY): the wells and springs.
table GetWater {}

// Wire 1.64 (M6a slice BB, ADR-0015 §8): where a list of incidents goes on from: the newest
// first, ordered by when each began, then its kind, then its number.
struct IncidentKey {
  minute: long;
  kind: ubyte;
  id: uint;
}

// Wire 1.64: incidents of every kind in one shape, newest first, a page at a time. Kinds: 1 a
// taking (ADR-0015 §1), 2 a case of illness (an infection, ADR-0021 §5), 4 a building's fire
// (wire 1.68, ADR-0022 §13).
table GetIncidents {
  // A settlement's permanent id; 0 for every settlement.
  settlement: ulong (id: 0);
  // 0 for every kind.
  kind: ubyte (id: 1);
  // Absent for the newest; else the `next` of the page before.
  before: IncidentKey (id: 2);
  // 0 for the default of 50; at most 200.
  limit: uint (id: 3);
}

// Wire 1.64: one incident's page: its steps, its links and its three layers.
table GetIncident {
  kind: ubyte (id: 0);
  id: uint (id: 1);
}

// Wire 1.64: one outbreak's page: its counts, its cause, its curve, its sources and its cases.
table GetOutbreak {
  id: uint (id: 0);
  // How many of its cases to list, newest first: 0 for the default of 100; at most 500.
  limit: uint (id: 1);
}

// A lens on the map, read per home (wire 1.66, M6a slice BB, step three): the Water lens's two
// layers, *could reach* and *did come*, for the homes of one settlement (0: every settlement).
table GetCoverage {
  settlement: ulong (id: 0);
  // 1: water; 2: help at a fire.
  lens: ubyte (id: 1);
}

// Wire 1.68 (M6b slice BC, step three; ADR-0022 §13): one conflagration's page: its fires in
// the order they caught, each from which, and the buildings its heat reached that held.
table GetConflagration {
  id: uint (id: 0);
}

// Wire 1.69 (M6b slice BF; ADR-0022 §13): one flood episode's page.
table GetFlood {
  id: uint (id: 0);
}

// Wire 1.69 (M6b slice BF; ADR-0022 §13): one storm episode's page.
table GetStorm {
  id: uint (id: 0);
}

union QueryBody { GetRaster, GetHydrography, ListSaves, GetTrips, GetPerson, GetChronicle, GetFields, GetBuildings, GetPaths, GetMarkets, GetFirms, GetFirm, GetWealth, GetKnowledge, GetDeposits, GetEarthworks, GetWeather, GetStanding, GetGovernment, GetOrder, GetCrossings, GetWater, GetIncidents, GetIncident, GetOutbreak, GetCoverage, GetConflagration, GetFlood, GetStorm }

table Query {
  body: QueryBody (id: 1);
}

// ---- Responses -----------------------------------------------------------------------------

table Ack {
  message: string (id: 0);
}

table RasterTile {
  layer: RasterLayer (id: 0);
  level: ubyte (id: 1);
  x0: uint (id: 2);
  y0: uint (id: 3);
  width: uint (id: 4);
  height: uint (id: 5);
  format: RasterFormat (id: 6);
  // value = raw * scale + offset (for quantised formats).
  scale: float (id: 7);
  offset: float (id: 8);
  // Little-endian samples, row-major.
  data: [ubyte] (id: 9);
  // Size of the whole layer at this level.
  full_width: uint (id: 10);
  full_height: uint (id: 11);
}

table Reach {
  id: uint (id: 0);
  order: ubyte (id: 1);
  discharge_m3s: float (id: 2);
  width_m: float (id: 3);
  // Reach this one flows into at a confluence, or -1.
  downstream: int (id: 4);
  // Metres from the map's north-west corner.
  points: [Vec2] (id: 5);
}

table LakeInfo {
  id: uint (id: 0);
  level_m: float (id: 1);
  area_m2: float (id: 2);
  closed: bool (id: 3);
  centroid: Vec2 (id: 4);
}

table Hydrography {
  reaches: [Reach] (id: 0);
  lakes: [LakeInfo] (id: 1);
}

table SaveEntry {
  file: string (id: 0);
  world_name: string (id: 1);
  label: string (id: 2);
  // "manual", "auto" or "crash".
  kind: string (id: 3);
  generation: ulong (id: 4);
  created_unix_ms: long (id: 5);
  sim_minute: long (id: 6);
  size_bytes: ulong (id: 7);
  // This build can load it.
  compatible: bool (id: 8);
  // It was written with different content than is loaded now.
  content_changed: bool (id: 9);
  note: string (id: 10);
  world_id: string (id: 11);
}

table SaveList {
  saves: [SaveEntry] (id: 0);
}

table TripInfo {
  id: ulong (id: 0);
  rev: uint (id: 1);
  person: ulong (id: 2);
  // Departure, simulation minutes since the calendar origin.
  depart_minute: long (id: 3);
  // Route vertices, metres, and minutes after departure at each.
  points: [Vec2] (id: 4);
  minutes: [float] (id: 5);
}

table Trips {
  // The trips that are still under way; ids not listed have ended.
  trips: [TripInfo] (id: 0);
}

// Firm: M3a slice J, a link to a workshop's page.
enum SpanKind : ubyte { Text = 0, Person = 1, Settlement = 2, Firm = 3 }

// A piece of kernel-rendered text: plain, or a link to a person, settlement or workshop.
table Span {
  kind: SpanKind (id: 0);
  text: string (id: 1);
  id: ulong (id: 2);
}

table ChronicleEntry {
  seq: ulong (id: 0);
  minute: long (id: 1);
  spans: [Span] (id: 2);
  // Wire 1.65 (M6a slice BB, ADR-0015 §8): the incident or outbreak the entry tells of, for its
  // page (1 a taking, 2 a case of illness, 3 an outbreak; wire 1.68: 4 a building's fire, 5 a
  // conflagration; 0 none), found from the records, never from nearness in time; and where it
  // happened, metres (absent when the entry names no place).
  incident_kind: ubyte (id: 3);
  incident: uint (id: 4);
  at: Vec2 (id: 5);
}

table Chronicle {
  entries: [ChronicleEntry] (id: 0);
  // The newest entry's sequence number.
  head: ulong (id: 1);
}

// One consideration's contribution to an option, in utility points.
struct Term {
  reason: ushort;
  points: float;
}

struct Exclusion {
  activity: ushort;
  reason: ushort;
}

table ScoredOption {
  // Index into Welcome.activities; 65535 = an activity the content no longer has.
  activity: ushort (id: 0);
  // What it was aimed at, rendered by the kernel ("home", "the hearth", "a patch 600 m east").
  target: string (id: 1);
  total: float (id: 2);
  terms: [Term] (id: 3);
}

// Why a person chose what they did, recorded when they chose it (ADR-0003 §3).
table Decision {
  minute: long (id: 0);
  chosen: ScoredOption (id: 1);
  runner_up: ScoredOption (id: 2);
  // Further options, totals only.
  others: [ScoredOption] (id: 3);
  excluded: [Exclusion] (id: 4);
  probability: float (id: 5);
  temperature: float (id: 6);
  // Hunger, sleep drive, loneliness (0-1 scales), and the household's days of food and water.
  needs: [float] (id: 7);
}

table KinLink {
  id: ulong (id: 0);
  name: string (id: 1);
  // "mother", "father", "son", "daughter", "brother", "sister", "partner", "former partner".
  relation: string (id: 2);
  alive: bool (id: 3);
  // M1 slice E: they left the valley alive (`alive` is false).
  left: bool (id: 4);
}

// A good in a household's store.
struct StoreLine {
  good: ushort;
  kg: float;
}

table PersonInfo {
  id: ulong (id: 0);
  name: string (id: 1);
  sex: Sex (id: 2);
  born_minute: long (id: 3);
  age_years: float (id: 4);
  alive: bool (id: 5);
  died_minute: long (id: 6);
  cause: string (id: 7);
  // "one of the founding band", "born here".
  origin: string (id: 8);
  household: ulong (id: 9);
  settlement: ulong (id: 10);
  settlement_name: string (id: 11);
  kin: [KinLink] (id: 12);
  // The living only: what they are doing now, rendered by the kernel.
  activity: ushort (id: 13);
  doing: string (id: 14);
  since_minute: long (id: 15);
  until_minute: long (id: 16);
  hunger: float (id: 17);
  sleep_pressure: float (id: 18);
  loneliness: float (id: 19);
  energy_kcal: float (id: 20);
  carry_food_kcal: float (id: 21);
  carry_water_l: float (id: 22);
  household_food_days: float (id: 23);
  household_water_days: float (id: 24);
  // Newest first.
  decisions: [Decision] (id: 25);
  // Openness, conscientiousness, extraversion, agreeableness, neuroticism, risk (standard scores).
  traits: [float] (id: 26);
  pos: Vec2 (id: 27);
  // M1 slice B: the good carried (an index into Welcome.goods, or -1) and how much, kilograms;
  // `carry_food_kcal` is its food energy. The household's goods in store, and its firewood in
  // days of use.
  carry_good: int = -1 (id: 28);
  carry_kg: float (id: 29);
  stores: [StoreLine] (id: 30);
  household_fuel_days: float (id: 31);
  // M1 slice E: their partner (0 = none), and their family life in sentences rendered by the
  // kernel ("Expecting a child, due in about 3 months.", "Nursing Wren.").
  partner: ulong (id: 32);
  family: [string] (id: 33);
  // When they left the valley alive (0 = they did not; `alive` is then false and `died_minute`
  // 0).
  left_minute: long (id: 34);
  // M3a: their skills, and the household's food ready to eat in days (`household_food_days`
  // counts all its food, grain and flour included).
  skills: [SkillLine] (id: 35);
  household_ready_days: float (id: 36);
  // M3b slice M: what they know, are learning or have heard of.
  knows: [KnowLine] (id: 37);
  // Wire 1.22 (M3b slice R): the living only: how their household would build, in words, and
  // the building that moved its taste most ("roofs pitched 48°, walls 1.9 m to the eaves, eaves
  // 0.5 m out; admiring Bo's hut"); and that building (0 for none).
  household_taste: string (id: 38);
  household_admired: ulong (id: 39);
  // Wire 1.26 (M4a slice Y, ADR-0014): the living only: their strongest ties, the most salient
  // first, and their standing in their settlement (absent until it is first worked out, on the
  // first of a month).
  ties: [TieLine] (id: 40);
  standing: StandingLine (id: 41);
  // Wire 1.34 (M4c slice AE, ADR-0016 §2-3): the living only: the grievances they hold, the
  // most keenly felt first, and what they have heard that is still news, the latest first.
  grievances: [GrievanceLine] (id: 42);
  heard: [HeardLine] (id: 43);
  // Wire 1.36 (M4c slice AG, ADR-0016 §4): where they stand on each question content names.
  positions: [PositionLine] (id: 44);
  // Wire 1.37 (M4c slice AG, ADR-0016 §4): what they hold of each norm content names.
  norms: [NormLine] (id: 45);
  // Wire 1.38 (M4c slice AG, ADR-0016 §4): what they hold of each value content names.
  values: [ValueLine] (id: 46);
  // Wire 1.39 (M4c slice AG, ADR-0016 §4): the ideologies they hold.
  ideologies: [IdeologyLine] (id: 47);
  // Wire 1.40 (M4c slice AH, ADR-0017 §2): the faction they belong to, if any.
  faction: FactionLine (id: 48);
  // Wire 1.47 (M4c slice AJ, ADR-0016 §5): the true claims their settlement's word holds that
  // they have not heard, which the observer may whisper to them, newest first.
  news: [NewsLine] (id: 49);
  // Wire 1.47: the observer's interventions that reached them, newest first, with what came of
  // each.
  influences: [InfluenceLine] (id: 50);
  // Where they have lived, oldest first, each in words (wire 1.49, ADR-0018 §2): "Ashford, from
  // the spring of year 1: came with a founding group".
  residence: [string] (id: 51);
  // The other settlements their household knows, each in words (wire 1.50, ADR-0018 §4):
  // "Elmhollow: seen on a walk in the spring of year 1".
  places: [string] (id: 52);
  // What their household believes other settlements' sellers offer, each seller's good in words
  // (wire 1.54, M5b slice AP, ADR-0019 §1): "Sickles at Elmhollow, from Bran's household: 2.3 kg
  // of grain or 3.7 kg of provisions each, 8 to be had; seen 3 days ago".
  reports: [string] (id: 53);
  // The errand their household means to run, in words (wire 1.55, M5b slice AQ, ADR-0019 §6):
  // "Their household means to fetch 3.6 sickles from Bran's household at Elmhollow to sell at
  // home; planned 2 days ago"; empty when it means none.
  errand: string (id: 54);
  // The buildings of other settlements they have seen since their household's last taste review,
  // in words (wire 1.56, M5b slice AR): "At Westford: Cal's hut, Bo's longhouse"; empty when none.
  seen_away: string (id: 55);
  // Where their household drew water today, in words (wire 1.61, M6a slice AY, ADR-0021 §1):
  // "Their household drew 6 loads today at its own well beside home; each of them uses 20 L a
  // day"; "... has drawn no water yet today ...".
  water: string (id: 56);
  // Their infections, in words, the latest first (wire 1.62, M6a slice AZ, step four): the
  // kernel's truth, which no one in the world knows ("Ill with cholera since yesterday, severely,
  // day 2 of 4; took it in the water their household drew at Bo's well; tended 3 hours today, by
  // one who knows fluid replacement; one of 14 cases of the outbreak at Ashford").
  sickness: [string] (id: 57);
  // The sources of water they hold sicken, in words, with the counts of their latest tally (wire
  // 1.63, M6a slice BA, step five): what they believe, beside the truth above ("Holds since 3
  // May of year 2 that the water at Bo's household's well sickens: of 5 households they know
  // that draw there, 3 had sickness lately, against 0 of 6 that draw elsewhere").
  suspicions: [string] (id: 58);
}

// Wire 1.47 (M4c slice AJ): a claim that may be whispered.
table NewsLine {
  claim: uint (id: 0);
  // What it says, in the kernel's words.
  what: string (id: 1);
}

// Wire 1.47 (M4c slice AJ, ADR-0016 §5; research 15-05 §6): one recorded influence and what came
// of it, read from the records people keep.
table InfluenceLine {
  id: uint (id: 0);
  // 0 a whisper, 1 an ideology told of; wire 1.48: 2 an agitator sent, 3 a blessing, 4 a curse;
  // wire 1.52: 5 a migration wave they came with.
  kind: ubyte (id: 1);
  // When it was first used.
  minute: long (id: 2);
  // What it submitted and what came of it, in the kernel's words ("Whispered that Bo holds a
  // grievance against the gathering over a levy: heard; told no one since").
  what: string (id: 3);
}

// The faction someone belongs to (wire 1.40, ADR-0017 §2, §6).
table FactionLine {
  faction: ulong (id: 0);
  // "Mira's faction", and what it stands against ("the gathering").
  name: string (id: 1);
  against: string (id: 2);
  organizer: ulong (id: 3);
  organizer_name: string (id: 4);
  // The start of the day they joined.
  since_minute: long (id: 5);
  // Why they belong, as they last reviewed it, in words rendered by the kernel.
  why: string (id: 6);
}

// An ideology someone holds (wire 1.39, ADR-0016 §4).
table IdeologyLine {
  // What it is called and its legitimacy story, in words ("common provision"; "what the village
  // gathers, the village keeps against a lean year").
  name: string (id: 0);
  legitimacy: string (id: 1);
  // When they took it up, and from whom (0 and empty: they brought it with them).
  since_minute: long (id: 2);
  from: ulong (id: 3);
  from_name: string (id: 4);
  // Wire 1.47 (M4c slice AJ): the observer's intervention they took it up by, having heard of it
  // from no one (0: none).
  influence: uint (id: 5);
}

// What someone holds of a value (wire 1.38, ADR-0016 §4; research 06-04 §1.1).
table ValueLine {
  // The value and what they hold of it, in words rendered by the kernel ("safety from want and
  // harm"; "holds safety from want and harm dear").
  name: string (id: 0);
  words: string (id: 1);
  // -1 (less than most) to 1 (more than most).
  v: float (id: 2);
}

// What someone holds of a norm (wire 1.37, ADR-0016 §4; research 06-05 §1.1): how far they hold
// it themselves, what they believe others do, and how far that moves them.
table NormLine {
  // What it says, how far they hold it, and what they believe others do, in words rendered by
  // the kernel ("what the gathering decides binds everyone"; "holds firmly"; "most households
  // pay what the gathering asks").
  statement: string (id: 0);
  holds: string (id: 1);
  believes: string (id: 2);
  // 0-1: their endorsement; the share of households they believe abide by it; where others'
  // doing it starts to move them; how far it moves them now.
  endorse: float (id: 3);
  expect: float (id: 4);
  threshold: float (id: 5);
  activation: float (id: 6);
  // Accounts of what households did that they have taken in.
  heard: uint (id: 7);
}

// Where someone stands on a question (wire 1.36, ADR-0016 §4).
table PositionLine {
  // The question and where they stand, in words rendered by the kernel ("whether to keep a
  // common store"; "leaning for").
  question: string (id: 0);
  lean: string (id: 1);
  // 0 against to 1 for; what their household's own lot makes of it; and how much it matters to
  // them now, 0-1.
  x: float (id: 2);
  anchor: float (id: 3);
  salience: float (id: 4);
  // What they have heard said of it at the hearth and taken in.
  heard: uint (id: 5);
}

// A grievance a person holds (wire 1.34, ADR-0016 §2).
table GrievanceLine {
  // 0 subsistence, 1 extraction, 2 treatment, 3 a collective claim (codes of saves).
  issue: ubyte (id: 0);
  // What it is over, and whom it is held against, in words rendered by the kernel ("food when
  // their household was short"; "the gathering", "Ada as keeper of the common store").
  over: string (id: 1);
  blamed: string (id: 2);
  // The law whose terms it broke (0 = none).
  law: ulong (id: 3);
  // The harm, and what of it nothing has yet made good, days of their household's food.
  harm_days: float (id: 4);
  unresolved_days: float (id: 5);
  // How keenly it is felt now, 0-1 (it fades, and is raised only by a reminder), and the day it
  // was first held and last raised, as minutes.
  activation: float (id: 6);
  made_minute: long (id: 7);
  raised_minute: long (id: 8);
  // What last raised it, in words rendered by the kernel ("the common store was empty when
  // their household was short").
  reason: string (id: 9);
}

// A claim a person has heard (wire 1.34, ADR-0016 §3).
table HeardLine {
  // 0 gathering, 1 grievance, 2 petition, 3 refusal, 4 revolt, 5 sickness, 6 suspicion.
  // Wire 1.70: 7 a building found burning; the words assert no cause.
  kind: ubyte (id: 0);
  // What it says, in words rendered by the kernel ("a gathering meets on 3 May of year 2 on a
  // common store, taking a tenth of each harvest"; "Bo holds a grievance against the gathering
  // over food when their household was short").
  what: string (id: 1);
  // Who told them (0 = nobody: it began with them), and the one the account began with.
  from: ulong (id: 2);
  from_name: string (id: 3);
  origin: ulong (id: 4);
  first_minute: long (id: 5);
  last_minute: long (id: 6);
  // Wire 1.47 (M4c slice AJ): the observer's intervention that placed it in their hearing (0:
  // none).
  influence: uint (id: 7);
}

// One person's view of another (wire 1.26, ADR-0014 §1).
table TieLine {
  person: ulong (id: 0);
  name: string (id: 1);
  // 0-1 each.
  familiarity: float (id: 2);
  warmth: float (id: 3);
  // Esteem by domain, in Standing.domains' order: good acts remembered less bad ones.
  esteem: [float] (id: 4);
  // Hours of help received from them less help given to them.
  help_h: float (id: 5);
  // Why the tie stands as it does, in words rendered by the kernel ("gave their household food
  // 3 times, last in May of year 4").
  reason: string (id: 6);
  // Whether they hold a tie back.
  mutual: bool (id: 7);
}

// An adult's standing in their settlement (wire 1.26, ADR-0014 §3-4).
table StandingLine {
  person: ulong (id: 0);
  name: string (id: 1);
  household: ulong (id: 2);
  // The esteem the settlement's other adults hold for them, summed, by domain.
  esteem: [float] (id: 3);
  // How many of the settlement's adults count them among those they esteem most.
  influence: uint (id: 4);
  // A notable: someone who considers the settlement's affairs weekly. It grants nothing.
  notable: bool (id: 5);
}

// What a person knows of a technique (M3b slice M).
table KnowLine {
  // Index into Welcome.techniques.
  technique: ushort (id: 0);
  // 0 heard of, 1 learning, 2 known.
  state: ubyte (id: 1);
  // Hours learnt beside someone who knows it, while learning; and the hours that teach it.
  hours: float (id: 2);
  learn_h: float (id: 3);
  since_minute: long (id: 4);
  // How it came, in words rendered by the kernel: "brought it", "brought up with it by Ash",
  // "taught by Wren", "found it", "introduced by the observer".
  source: string (id: 5);
  // Who it came from (0 = nobody).
  source_person: ulong (id: 6);
  // When they last did its work.
  used_minute: long (id: 7);
}

// A field people work (M1 slice C).
table FieldInfo {
  id: ulong (id: 0);
  household: ulong (id: 1);
  settlement: ulong (id: 2);
  // North-west corner and size, metres.
  min: Vec2 (id: 3);
  size: Vec2 (id: 4);
  // Index into Welcome.crops.
  crop: ushort (id: 5);
  stage: FieldStage (id: 6);
  stage_since_minute: long (id: 7);
  // Share of the work of the stage under way that is done, 0-1.
  progress: float (id: 8);
  // Ground not yet broken for a first crop, and whether it is woodland to clear first.
  new_ground: bool (id: 9);
  woodland: bool (id: 10);
  // The grain its crop is expected to give, kilograms (0 when nothing is planned for it).
  expected_kg: float (id: 11);
  // Reaped and not yet threshed, kilograms.
  sheaves_kg: float (id: 12);
  harvests: uint (id: 13);
  // Its state in words, rendered by the kernel: "growing; ripe in about 20 days".
  status: string (id: 14);
  // Sown and ripe, waiting to be reaped.
  ripe: bool (id: 15);
  // Who holds it (M3a slice K; ADR-0007): a household (its id) or else a settlement (its id);
  // `household` above works it.
  holder: ulong (id: 16);
  holder_settlement: ulong (id: 17);
  // When it is let: when the lease's term ends (-1 = not let), and the holder's share of the grain
  // threshed from it.
  lease_until_minute: long = -1 (id: 18);
  lease_share: float (id: 19);
  // Wire 1.24 (ADR-0012 §2): the share of the water its growing crop needed that it has had this
  // season (-1 before it has needed any), and its root zone's water as a share of what the soil
  // holds.
  water_had: float = -1 (id: 20);
  soil_water: float (id: 21);
}

table Fields {
  // The snapshot revision these fields are at.
  rev: ulong (id: 0);
  fields: [FieldInfo] (id: 1);
}

// How one component group of a building stands (wire 1.17, M3b slice P, ADR-0009 §4).
enum GroupState : ubyte { Sound = 0, Symptom = 1, Failed = 2 }

// How a building stands as a whole (wire 1.17).
enum BuildingState : ubyte { Standing = 0, Damaged = 1, Ruin = 2 }

// The condition of one component group of a building (wire 1.17, ADR-0009 §4).
table GroupInfo {
  // Its semantic id in the building's expansion, and its kind in words: "posts", "covering".
  id: uint (id: 0);
  kind: string (id: 1);
  // Its quality: a share of what sound members of its sizes carry, drawn once from its
  // builders' skill.
  quality: float (id: 2);
  // The share of its members' effective section lost, or of a covering worn, 0-1.
  loss: float (id: 3);
  state: GroupState (id: 4);
  installed_minute: long (id: 5);
  repaired_minute: long (id: 6);
}

// A building and the ground it stands on (M1 slice D). Geometry is expanded by the kernel from the
// building's saved design (civ-grammar); the observer only draws it.
table BuildingInfo {
  id: ulong (id: 0);
  household: ulong (id: 1);
  settlement: ulong (id: 2);
  // The program's display name: "Hut".
  program: string (id: 3);
  // Centre and radius of the wall line, and radius of the roof's edge, metres.
  centre: Vec2 (id: 4);
  radius_m: float (id: 5);
  roof_radius_m: float (id: 6);
  // The doorway's middle, metres, and the direction it faces, radians from east toward south.
  door: Vec2 (id: 7);
  door_dir: float (id: 8);
  // The stage under way (0 foundation, 1 frame, 2 walls, 3 roof, 4 finish; 5 once finished),
  // its name, and the share of its work done, 0-1.
  stage: ubyte (id: 9);
  stage_name: string (id: 10);
  progress: float (id: 11);
  roofed: bool (id: 12);
  // The outer face of the walls, metres, going round from the door.
  outline: [Vec2] (id: 13);
  // Where the posts stand, metres.
  posts: [Vec2] (id: 14);
  // The plot it stands on: north-west corner and size, metres.
  plot_min: Vec2 (id: 15);
  plot_size: Vec2 (id: 16);
  // Floor area over every level, square metres, and the people it sleeps.
  floor_m2: float (id: 17);
  sleeps: uint (id: 18);
  started_minute: long (id: 19);
  // Its state in words, rendered by the kernel: "walls going up (40%); waiting for timber".
  status: string (id: 20);
  // Wire 1.14 (M3b slice O, ADR-0009 §8): the grammar that expands it ("hut" or "frame") and
  // what it is for ("dwelling", "store" or "work").
  grammar: string (id: 21);
  purpose: string (id: 22);
  // Its length and width between the wall lines, metres (a hut: its wall line's diameter both
  // ways), and the direction its length runs, radians from east toward south.
  size: Vec2 (id: 23);
  angle: float (id: 24);
  storeys: ubyte (id: 25);
  bays: ubyte (id: 26);
  // The bays floored as a loft, a bit each (bit b for bay b).
  loft_bays: ushort (id: 27);
  // A gabled roof's edge (its corners) and its ridge's two ends, metres; both empty for a hut,
  // whose cone's edge is the circle of roof_radius_m.
  roof_outline: [Vec2] (id: 28);
  ridge: [Vec2] (id: 29);
  // Height of the roof's apex or ridge, metres.
  apex_m: float (id: 30);
  // Floor by use, square metres: living, store and work (floor_m2 is their sum, over every
  // level).
  floor_by_use: [float] (id: 31);
  // Goods it can hold under its roof, kilograms: on a raised store's floor, in lofts, and on
  // other floors.
  storage_kg: [float] (id: 32);
  // Places to work at a craft.
  work_places: uint (id: 33);
  // Wire 1.15 (M3b slice O): what its household keeps in it now, kilograms by kind of room
  // (raised floors, lofts, other floors), and in words: "loft over 1 bay: 1.2 t of 1.9 t, mostly
  // grain".
  stored_kg: [float] (id: 34);
  stored: string (id: 35);
  // Wire 1.16 (M3b slice O): the firm it is the workshop of (0 for none), and its name: "Wren's
  // sickle workshop".
  firm: ulong (id: 36);
  firm_name: string (id: 37);
  // Wire 1.17 (M3b slice P, ADR-0009 §4, §8): how it stands; what it shows, in words, worst
  // first ("the thatch leaks; rot at the posts' foot"; empty while nothing shows); the share of
  // its roof that leaks, 0-1; each of its component groups in place; and the upkeep under way,
  // in words ("mending the covering, 40% done"; empty for none).
  state: BuildingState (id: 38);
  symptoms: string (id: 39);
  leak: float (id: 40);
  groups: [GroupInfo] (id: 41);
  upkeep: string (id: 42);
  // Wire 1.22 (M3b slice R, ADR-0009 §7): how it was built, in words, and the building its
  // household's taste followed when it was begun ("roof pitched 49°, walls 1.9 m to the eaves,
  // after Bo's hut"); and that building (0 for none; it may since be gone).
  style: string (id: 43);
  style_from: ulong (id: 44);
  // Wire 1.68 (M6b slice BC, step three; ADR-0022 §4): its latest fire: 0 none (or its covering
  // since mended), 1 its covering alight, 2 fully involved, 3 burnt out; that fire's number (0 for
  // none), and in words ("fully involved since 02:15, caught from the hut of Bo's household";
  // "burnt out on 3 May of year 2"; empty for none).
  fire: ubyte (id: 45);
  fire_id: uint (id: 46);
  fire_words: string (id: 47);
}

table Buildings {
  // The snapshot revision these buildings are at.
  rev: ulong (id: 0);
  buildings: [BuildingInfo] (id: 1);
}

// Ground worn by walking in one tile of cells (M1 slice F), as last surveyed.
table WornTile {
  // Tile row × tiles per row + tile column.
  index: uint (id: 0);
  // Wear of each cell, row by row, 0-255 for 0-1.
  wear: [ubyte] (id: 1);
  // Whether each cell is trail, one bit per cell, row by row (bit k of word k / 64).
  trail: [ulong] (id: 2);
}

// A trail traced through trail cells, from end to end or junction to junction.
table TrailInfo {
  // Vertices, metres.
  points: [Vec2] (id: 0);
  // Mean wear of the cells it runs through, 0-1.
  wear: float (id: 1);
  length_m: float (id: 2);
}

table Paths {
  // The snapshot revision these paths are at.
  rev: ulong (id: 0);
  // Tiles per row, and cells per tile side.
  tiles_x: uint (id: 1);
  tile_cells: uint (id: 2);
  worn: [WornTile] (id: 3);
  trails: [TrailInfo] (id: 4);
}

// A household's posted terms for a good: so much of a payment good for a unit (M3a slice I).
table OfferInfo {
  household: ulong (id: 0);
  // "Ada's household".
  household_name: string (id: 1);
  // Indexes into Welcome.goods.
  good: ushort (id: 2);
  payment: ushort (id: 3);
  // Units of the payment asked for a unit of the good, and units of the good offered.
  price: float (id: 4);
  units: float (id: 5);
  // M3a slice J: a workshop's terms: `household` is the workshop's id and `household_name` its
  // name ("Wren's sickle workshop").
  firm: bool (id: 6);
}

// A trade a settlement's market remembers (M3a slice I).
table TradeInfo {
  minute: long (id: 0);
  seller: ulong (id: 1);
  buyer: ulong (id: 2);
  // Indexes into Welcome.goods, and how much of each changed hands.
  good: ushort (id: 3);
  units: float (id: 4);
  payment: ushort (id: 5);
  paid: float (id: 6);
  // Paid in the settlement's money (a sale), not goods for goods (barter).
  sale: bool (id: 7);
  // Rendered by the kernel: "Ada's household sold a sickle to Bran's household for 12 kg of
  // grain."
  text: string (id: 8);
  // M3a slice J: the seller was a workshop (`seller` is its id).
  seller_firm: bool (id: 9);
  // Wire 1.54 (M5b slice AP, ADR-0019 §4): the buyer's settlement when it is not this market's
  // own (0: one of its own).
  from: ulong (id: 10);
}

// One good in a settlement's market (M3a slice I). Tallies fade by half every
// MarketInfo.memory_days.
table MarketGood {
  // Index into Welcome.goods.
  good: ushort (id: 0);
  // Units offered, and by how many sellers: households and, from M3a slice J, workshops.
  offered: float (id: 1);
  sellers: ushort (id: 2);
  sold: float (id: 3);
  // Units buyers wanted and found no offer for, and what they would have given for a unit,
  // hours of their own work (recorded demand).
  unmet: float (id: 4);
  unmet_worth_h: float (id: 5);
  // Its share of the worth of the payments made, 0-1 (acceptance).
  acceptance: float (id: 6);
  // The last trade's terms: what it was paid in (an index into Welcome.goods, or -1 when it has
  // not sold) and how much of that for a unit.
  last_payment: int = -1 (id: 7);
  last_price: float (id: 8);
  // M3a slice J: how many of the sellers are workshops.
  workshops: ushort (id: 9);
}

// A month of trade in one good: a line of the price history (M3a slice I).
struct MonthOfTrade {
  // Months since the calendar's origin: (year - 1) * 12 + month - 1.
  month: uint;
  trades: uint;
  units: float;
  // What the payments were worth to the sellers, hours of their own work.
  paid_h: float;
  // Index into Welcome.goods.
  good: ushort;
}

// A settlement's market (M3a slice I).
table MarketInfo {
  settlement: ulong (id: 0);
  settlement_name: string (id: 1);
  // Its money, an index into Welcome.goods, or -1 while it has none and trades by barter.
  money: int = -1 (id: 2);
  // Rendered by the kernel: "Barter: no good settles most payments yet (grain 34%)."
  summary: string (id: 3);
  // Trades remembered, and the half-life of what the market remembers, days.
  trades: float (id: 4);
  memory_days: float (id: 5);
  // The goods offered, sold, wanted or paid in.
  goods: [MarketGood] (id: 6);
  offers: [OfferInfo] (id: 7);
  // Newest first.
  recent: [TradeInfo] (id: 8);
  // Oldest first.
  history: [MonthOfTrade] (id: 9);
  // Wire 1.54 (M5b slice AP): what people of other settlements bought here last year and this
  // year so far, in words ("in year 3 so far: 4 purchases by people of Oakholt"); empty when
  // none did.
  outsiders: string (id: 10);
  // Wire 1.55 (M5b slice AQ, ADR-0019 §7): trade with each other settlement, a line each, from
  // the convergence record: "With Elmhollow last month: a sickle asked 4.2 hours here and 3.1
  // there (a gap of 30 points); people of here carried home 3 sickles from there in 4 trips".
  between: [string] (id: 11);
  // Who is on the road to buy here today, by settlement, those who set out together a caravan:
  // "On the road to buy here today: 3 people of Oakholt, together"; empty when nobody is.
  on_the_way: string (id: 12);
}

table Markets {
  // The snapshot revision these markets are at.
  rev: ulong (id: 0);
  markets: [MarketInfo] (id: 1);
}

// What a line of a workshop's books records (M3a slice J): the kernel's codes.
enum BookKind : ubyte { Unknown = 0, PutIn = 1, Drawn = 2, Made = 3, Used = 4, Sold = 5, Paid = 6, Wages = 7, Lost = 8 }

// A workshop in brief (M3a slice J). In M3a every firm is a household's workshop: the household
// owns it and works for it unpaid, and it keeps its own stores and books.
table FirmBrief {
  id: ulong (id: 0);
  // "Wren's sickle workshop".
  name: string (id: 1);
  // The household that owns it.
  owner: ulong (id: 2);
  owner_name: string (id: 3);
  settlement: ulong (id: 4);
  settlement_name: string (id: 5);
  founded_minute: long (id: 6);
  open: bool (id: 7);
  // When it closed, and why, rendered by the kernel: "it sold nothing for months" (closed
  // workshops only).
  closed_minute: long (id: 8);
  closed_why: string (id: 9);
  // What it makes to sell: indexes into Welcome.goods.
  lines: [ushort] (id: 10);
  // Hours of work it would hire before its next review (0 = it hires no one now).
  hiring_h: float (id: 11);
  // What it made and sold in its life, rendered by the kernel: "Made 3 sickles and sold 2."
  record: string (id: 12);
}

table Firms {
  // The snapshot revision these workshops are at.
  rev: ulong (id: 0);
  // Open workshops first, then closed ones; the newest first within each.
  firms: [FirmBrief] (id: 1);
}

// What a workshop pays for work (M3a slice J).
table WageInfo {
  // The work, an index into Welcome.activities; what it pays in, an index into Welcome.goods;
  // and how much of that for an hour's work.
  activity: ushort (id: 0);
  pay: ushort (id: 1);
  per_hour: float (id: 2);
  // What an hour's pay is worth to its owners, hours of their own work.
  hour_h: float (id: 3);
  // Hours of work it wants before its next review, and the hours taken of those.
  hours: float (id: 4);
  taken: float (id: 5);
  // Rendered by the kernel: "Pays 0.9 kg of grain an hour; wants 6 more hours of work this week."
  text: string (id: 6);
}

// A line of a workshop's books (M3a slice J).
table BookEntryInfo {
  minute: long (id: 0);
  kind: BookKind (id: 1);
  // Index into Welcome.goods, and how much of it, in its unit.
  good: ushort (id: 2);
  amount: float (id: 3);
  // The household on the other side: the buyer, the owners, the worker's (0 = none).
  other: ulong (id: 4);
  // Rendered by the kernel: "Sold a sickle to Bran's household."
  text: string (id: 5);
}

// How much of a good a workshop's books moved in a month, by kind.
struct BookLine {
  amount: float;
  // Index into Welcome.goods.
  good: ushort;
  kind: BookKind;
}

// A month of a workshop's books (M3a slice J). Worth is in hours of its owners' own work: what
// the goods would have cost them to get themselves (a settlement need not have a money).
table MonthStatement {
  // Months since the calendar's origin: (year - 1) * 12 + month - 1.
  month: uint (id: 0);
  lines: [BookLine] (id: 1);
  // Hours worked for it by its owners' household, and by people it hired.
  owner_h: float (id: 2);
  hired_h: float (id: 3);
  // What its payments were worth, and its inputs and wages.
  income_h: float (id: 4);
  costs_h: float (id: 5);
  // Its stock as the month ended (as it stands, for the month under way).
  stock_h: float (id: 6);
}

// A workshop's page (M3a slice J).
table FirmInfo {
  brief: FirmBrief (id: 0);
  // Who set it up, and since when its owners have had it.
  founder: ulong (id: 1);
  founder_name: string (id: 2);
  owner_since_minute: long (id: 3);
  // When it last sold anything (-1 = never).
  last_sale_minute: long = -1 (id: 4);
  // What it holds: its stock and what it was paid.
  stores: [StoreLine] (id: 5);
  // Its posted terms (`firm` set, `household` its id).
  offers: [OfferInfo] (id: 6);
  // What it pays for work (absent if it never hired).
  wage: WageInfo (id: 7);
  // The latest lines of its books, newest first.
  entries: [BookEntryInfo] (id: 8);
  // Every month of its life, oldest first.
  months: [MonthStatement] (id: 9);
}

// How a settlement's wealth measures spread over its people (M3a slice K; ADR-0007 §4). Several
// measures, not one: Ginis of goods, land held and land worked per head are person-weighted (each
// person counts at their household's measure per head); floor area is compared house by house.
// Goods are valued in hours of work at the settlement's prices, the median of what each good costs
// its households in their own work.
table WealthSpread {
  // The year that ended, for a year's record; the year under way, for the measures as they stand.
  year: long (id: 0);
  households: uint (id: 1);
  people: uint (id: 2);
  gini_goods: float (id: 3);
  gini_held: float (id: 4);
  gini_worked: float (id: 5);
  // Over the households with a roof of their own.
  gini_floor: float (id: 6);
  // The share of all goods the richest tenth of people have.
  top_tenth_goods: float (id: 7);
  // The shares of households that hold no land, and that work none.
  holding_none: float (id: 8);
  working_none: float (id: 9);
  goods_h_per_head: float (id: 10);
  worked_ha_per_head: float (id: 11);
  floor_m2_per_house: float (id: 12);
  // Land the settlement itself holds, hectares.
  common_ha: float (id: 13);
  // Wire 1.16 (M3b slice O): floor under every roof a household has (homes, stores, workshops),
  // square metres, and room for goods under them, kilograms, a household.
  roofed_m2_per_house: float (id: 14);
  storage_kg_per_house: float (id: 15);
}

// A household's wealth measures (M3a slice K).
table HouseholdWealth {
  household: ulong (id: 0);
  // "Wren's household".
  name: string (id: 1);
  members: uint (id: 2);
  // Land it holds and land it works, hectares; of those, what it has let to others and what it
  // works on lease from others.
  held_ha: float (id: 3);
  worked_ha: float (id: 4);
  let_ha: float (id: 5);
  rented_ha: float (id: 6);
  // Its goods and its workshops' stock, hours of work at the settlement's prices.
  goods_h: float (id: 7);
  // Floor area of its home, square metres.
  floor_m2: float (id: 8);
  // Wire 1.16 (M3b slice O): floor under all its roofs, homes, stores and workshops, square
  // metres, and room for goods under them, kilograms.
  roofed_m2: float (id: 9);
  storage_kg: float (id: 10);
}

table SettlementWealth {
  settlement: ulong (id: 0);
  name: string (id: 1);
  // As they stand.
  now: WealthSpread (id: 2);
  // Its households, the most goods per head first.
  households: [HouseholdWealth] (id: 3);
  // At the end of each year, oldest first.
  history: [WealthSpread] (id: 4);
  // Wire 1.82 (M7d slice CA, ADR-0027 §1): loans its households owe, open ones first then those
  // closed within a year, newest first, at most twelve, in the kernel's words ("Wren's household
  // owes Mira's household 40 kg of grain, lent on 3 May of year 2, due on 9 September of year
  // 2").
  loans: [string] (id: 5);
}

table Wealth {
  // The snapshot revision these measures are at.
  rev: ulong (id: 0);
  // The world's property regime, by name.
  regime_name: string (id: 1);
  settlements: [SettlementWealth] (id: 2);
}

// Someone named in a knowledge listing.
table PersonRef {
  id: ulong (id: 0);
  name: string (id: 1);
  age_years: float (id: 2);
}

// A technique in one settlement (M3b slice M).
table TechniqueHere {
  // Index into Welcome.techniques.
  technique: ushort (id: 0);
  // Known there now.
  known: bool (id: 1);
  // Who knows it, eldest first; who is learning it; who has only heard of it.
  knowers: [PersonRef] (id: 2);
  learners: [PersonRef] (id: 3);
  heard: [PersonRef] (id: 4);
  // Knowers who did its work in the last year.
  practised_last_year: uint (id: 5);
  // Its state in words, rendered by the kernel: "known by 12", "known by one, aged 61; nobody
  // learning", "lost; two still know of it".
  status: string (id: 6);
  // Its history there, oldest first, in sentences: "Brought by Ash in year 1.", "Lost in year 9
  // with Wren."
  history: [string] (id: 7);
  // Wire 1.18: how many times their usual strength builders there make the joists and posts of
  // its frame buildings after the failures they have seen (1 when they build as usual;
  // ADR-0009 §6), and what they have seen in words, rendered by the kernel: "2 buildings gave
  // way lately in 31 building-years: built 1.4 times as strong"; empty for a technique nothing
  // is built by there.
  caution: float = 1.0 (id: 8);
  trust: string (id: 9);
}

table SettlementKnowledge {
  settlement: ulong (id: 0);
  name: string (id: 1);
  // Every technique known there, ever known there or known of there, and (wire 1.18) any whose
  // buildings its builders remember.
  techniques: [TechniqueHere] (id: 2);
}

table Knowledge {
  // The snapshot revision this is at.
  rev: ulong (id: 0);
  settlements: [SettlementKnowledge] (id: 1);
}

// A deposit in the ground (wire 1.19, M3b slice Q; ADR-0010 §1). The observer sees them all; the
// people of a settlement know only those in `known_by`.
table DepositInfo {
  id: ulong (id: 0);
  // Index into Welcome.goods.
  good: uint (id: 1);
  // Its centre, metres from the map's north-west corner, and its radius.
  x: float (id: 2);
  y: float (id: 3);
  radius_m: float (id: 4);
  // It shows at the surface; otherwise it lies under `cover_m` of ground.
  exposed: bool (id: 5);
  cover_m: float (id: 6);
  thickness_m: float (id: 7);
  // How much of what is dug is fit for use, 0 to 1.
  quality: float (id: 8);
  left_kg: double (id: 9);
  taken_kg: double (id: 10);
  // The settlements that know it, and how each came to, in words, in the same order: "found by Ash
  // of Alderford in year 3".
  known_by: [ulong] (id: 11);
  finds: [string] (id: 12);
}

table Deposits {
  // The snapshot revision this is at.
  rev: ulong (id: 0);
  deposits: [DepositInfo] (id: 1);
}

// An earthwork (wire 1.20, M3b slice Q; ADR-0010 §2): a platform levelling a plot, a pit dug for a
// deposit's goods, or the spoil heap beside a pit.
table EarthworkInfo {
  id: ulong (id: 0);
  // What it is: 0 a platform; wire 1.21: 1 a pit, 2 a spoil heap; wire 1.72: 3 a bank; wire 1.73: 4
  // an irrigation ditch; wire 1.75: 5 a sector of an enclosure's line. Append only.
  kind: ubyte (id: 1);
  // The rectangle it levels, metres from the map's north-west corner.
  x: float (id: 2);
  y: float (id: 3);
  w: float (id: 4);
  h: float (id: 5);
  // The level it is cut and filled to, metres of height, and how far its sides run across for
  // each metre up or down.
  level_m: float (id: 6);
  side_run: float (id: 7);
  // Earth it cuts when done, cubic metres as it lay in the ground, and the share done, 0 to 1.
  cut_m3: float (id: 8);
  done: float (id: 9);
  household: ulong (id: 10);
  // The plot it levels and the building on it (0 for none).
  plot: ulong (id: 11);
  building: ulong (id: 12);
  // In words: "the plot of Ada's hut, being levelled: 40% of 6.4 m³ cut and filled".
  words: string (id: 13);
  // Wire 1.21: for a pit or its heap, the deposit the pit is dug for (0 for none).
  deposit: ulong (id: 14);
  // Wire 1.72: bank centre-line endpoints in metres, and its current height above ground.
  bank_a: Vec2 (id: 15);
  bank_b: Vec2 (id: 16);
  bank_height_m: float (id: 17);
  bank_breached: bool (id: 18);
  // Wire 1.73: an irrigation ditch's line from its intake to its field, metres, and whether its
  // intake is open.
  ditch_a: Vec2 (id: 19);
  ditch_b: Vec2 (id: 20);
  ditch_open: bool (id: 21);
  // Wire 1.75 (M6c slice BK): an enclosure sector's ends, metres, its place round the line, its
  // state (0 not yet built, 1 standing, 2 rotted through, a gap) and its gate (0 none, 1 open,
  // 2 shut). Its `id` is the enclosure's.
  sector_a: Vec2 (id: 22);
  sector_b: Vec2 (id: 23);
  sector_index: uint (id: 24);
  sector_state: ubyte (id: 25);
  sector_gate: ubyte (id: 26);
}


// A crossing over water (wire 1.60, M5c slice AW; ADR-0004 §7, ADR-0009 §9): where it stands, by
// what system, how far along it is, and its condition.
table CrossingInfo {
  id: ulong (id: 0);
  // Its bridge system's name: "Log footbridge".
  system: string (id: 1);
  // Its banks' centres, metres from the map's north-west corner: where it is drawn from and to.
  ax: float (id: 2);
  ay: float (id: 3);
  bx: float (id: 4);
  by: float (id: 5);
  // Clear span, metres; its members side by side and their diameter, centimetres.
  span_m: float (id: 6);
  members: ubyte (id: 7);
  diameter_cm: float (id: 8);
  // 0 being built, 1 open, 2 failed. Append only.
  state: ubyte (id: 9);
  // Labour it takes and done so far, hours.
  labour_h: float (id: 10);
  work_h: float (id: 11);
  // Its members' quality (0 while being built) and the share of their section rot has taken.
  quality: float (id: 12);
  loss: float (id: 13);
  // Its margin over one walker now: below 1 it gives way under the next to step onto it (0 while
  // being built or failed).
  margin: float (id: 14);
  // Who it belongs to: 0 a household, 1 a polity; and which.
  owner_kind: ubyte (id: 15);
  owner: ulong (id: 16);
  // In words: "Ada's household's log footbridge, open since year 2: two 20 cm logs over 2.4 m;
  // rot has taken a tenth of them".
  words: string (id: 17);
  // Its members' length, metres: the span and a bearing on either bank. Drawn this long, centred
  // between the banks' centres.
  length_m: float (id: 18);
}

table Crossings {
  // The snapshot revision this is at.
  rev: ulong (id: 0);
  crossings: [CrossingInfo] (id: 1);
}

// A well (wire 1.61, M6a slice AY, step three; ADR-0021 §3): where it is, by what system, how
// deep it is dug and meant to go, the water standing in it now, and its lining's condition.
table WellInfo {
  id: ulong (id: 0);
  // Its well system's name: "Timber-lined well".
  system: string (id: 1);
  // Its centre, metres from the map's north-west corner, and the radius dug, metres.
  x: float (id: 2);
  y: float (id: 3);
  radius_m: float (id: 4);
  // 0 being dug, 1 open, 2 given up, 3 fallen in. Append only.
  state: ubyte (id: 5);
  // How deep it is dug and lined, and how deep its diggers now mean to take it, metres.
  depth_m: float (id: 6);
  target_m: float (id: 7);
  // While open: the water standing in its shaft, metres deep, and how far below the ground its
  // surface is (0 otherwise).
  water_m: float (id: 8);
  below_m: float (id: 9);
  // Its lining's quality (0 until it opens) and the share rot has taken.
  quality: float (id: 10);
  loss: float (id: 11);
  // The household it is the well of.
  household: ulong (id: 12);
  // In words: "Ada's household's timber-lined well, open since year 2: 4.1 m deep, 1.8 m of
  // water standing 2.3 m down; rot has taken a tenth of its lining".
  words: string (id: 13);
  // What fouls its water, in words (wire 1.62, M6a slice AZ, step four): the kernel's truth,
  // which no one in the world knows ("Its water holds cholera: about 120 doses, a dose in every
  // 14 L"); empty when nothing does.
  fouled: string (id: 14);
}

// A spring today (wire 1.61, M6a slice AY): where it rises, what flows to it in a day, and what
// people drew there today.
struct SpringInfo {
  x: float;
  y: float;
  flow_m3_day: float;
  drawn_l: float;
}

// Where people stood at a river's or lake's edge to draw water today (wire 1.61, M6a slice AY),
// and how many times they came for it there.
struct BankDraw {
  x: float;
  y: float;
  trips: uint;
}

// Where a cell is flooded today (wire 1.69, M6b slice BF; ADR-0022 §13).
struct FloodCell {
  cell: uint;
  depth_m: float;
}

table Water {
  // The snapshot revision this is at.
  rev: ulong (id: 0);
  wells: [WellInfo] (id: 1);
  // Every spring flowing today.
  springs: [SpringInfo] (id: 2);
  // The rivers' flow today against their mean (1 is the mean).
  flow: float (id: 3);
  banks: [BankDraw] (id: 4);
  // Flooded cells today with water depth, metres (wire 1.69).
  flooded: [FloodCell] (id: 5);
}

// A tile of what earthworks have done to the ground, numbered row by row across the map. Its
// revision changes whenever one of its cells does: read the elevation under a tile again when its
// revision differs from the one last seen (the elevation raster serves the ground as changed).
struct GroundTileRev {
  index: uint;
  rev: uint;
}

table Earthworks {
  // The snapshot revision this is at.
  rev: ulong (id: 0);
  works: [EarthworkInfo] (id: 1);
  // Cells a side of a tile of the ground's changes, and tiles across the map.
  tile_cells: uint (id: 2);
  tiles_x: uint (id: 3);
  // Every tile earthworks have changed, by index.
  tiles: [GroundTileRev] (id: 4);
}

// One month's weather on the valley floor as it was, beside what the month usually brings (wire
// 1.24, M3c slice U).
table WeatherMonthInfo {
  // Its year, the world's first being 1, and its month, 0 for January.
  year: long (id: 0);
  month: ubyte (id: 1);
  // Days recorded: fewer than the month has for the month in progress.
  days: ubyte (id: 2);
  // Rain and snow, mm of water, and the long-run mean for the month.
  precip_mm: float (id: 3);
  usual_mm: float (id: 4);
  wet_days: ubyte (id: 5);
  // Its mean temperature and the month's normal, °C.
  mean_c: float (id: 6);
  usual_c: float (id: 7);
  // Its lowest and highest temperature, °C.
  min_c: float (id: 8);
  max_c: float (id: 9);
  frost_days: ubyte (id: 10);
  // Days that ended with snow lying.
  snow_days: ubyte (id: 11);
  // The soil water under the wild cover, on average, as a share of what the soil holds.
  soil: float (id: 12);
  // Wire 1.63: the observer's drought held its weather on one of its days.
  held: bool (id: 13);
}

table WeatherReport {
  // The snapshot revision this is at.
  rev: ulong (id: 0);
  // The height the weather is for, metres, and the landscape's mean annual precipitation, mm.
  height_m: float (id: 1);
  annual_mm: float (id: 2);
  today: DayWeather (id: 3);
  // Every month lived, oldest first; the last is the month in progress.
  months: [WeatherMonthInfo] (id: 4);
  // Today's month, 0 for January.
  month: ubyte (id: 5);
  // Wire 1.63: the observer's drought while it holds, in words ("The observer holds back the
  // rain, 2 standard deviations dry, until 3 May of year 2"); absent when none holds.
  drought: string (id: 6);
}

// A settlement's standing (wire 1.26): its notables first, then those most esteemed, at most
// Standing's limit of rows besides the notables.
table SettlementStanding {
  settlement: ulong (id: 0);
  name: string (id: 1);
  adults: uint (id: 2);
  rows: [StandingLine] (id: 3);
}

// Every settlement's standing as worked out on `minute` (0 before the first time), and how ties
// stand across the world: how many there are and how many have been let go for want of room
// since the counters began.
table Standing {
  minute: long (id: 0);
  // The domains' names, in the order of every `esteem`.
  domains: [string] (id: 1);
  settlements: [SettlementStanding] (id: 2);
  ties: uint (id: 3);
  let_go: ulong (id: 4);
}

// One member's stance at a gathering (wire 1.27, ADR-0013 §3, stage 2): where they stood, what
// moved them in points, and why in the kernel's words.
table StanceLine {
  person: ulong (id: 0);
  name: string (id: 1);
  // 0 for, 1 against, 2 abstained.
  stance: ubyte (id: 2);
  // Their household's forecast of the law, points, and what their regard for its sponsor added.
  gain: float (id: 3);
  regard: float (id: 4);
  // "their household stands to gain, and they think well of the sponsor".
  why: string (id: 5);
  // Wire 1.36 (M4c slice AG): what talk at the hearth had moved them from their household's
  // lot, points.
  opinion: float (id: 6);
  // Wire 1.38 (M4c slice AG): what the law does to what they hold dear, points.
  values: float (id: 7);
}

// A law and its whole history (wire 1.27, ADR-0013 §3): proposal, stances, decision, who knows
// it, and what it asked and gave. The kernel renders every sentence.
table LawLine {
  id: ulong (id: 0);
  // What it is: "a common store, taking a tenth of each harvest".
  what: string (id: 1);
  // Its template's content id.
  policy: string (id: 2);
  levy_share: float (id: 3);
  relief_days: float (id: 4);
  // 0 before the gathering, 1 in force, 2 rejected, 3 lapsed (wire 1.28: the one it named died or
  // left), 4 superseded (wire 1.35: an amendment of the custom a later one replaced; 1.41: any law
  // a later one ended or changed), 5 carried (wire 1.44: a repeal that passed, ending the law it
  // named), 6 struck down (wire 1.78, M7b slice BT: a forum with review found it breaks a limit).
  status: ubyte (id: 5);
  sponsor: ulong (id: 6);
  sponsor_name: string (id: 7);
  proposed_minute: long (id: 8);
  // The issue it answered: "food would not last until the harvest".
  issue: string (id: 9);
  // The start of the day the gathering meets.
  meets_minute: long (id: 10);
  // When it was decided (0 before), how (0 passed, 1 failed, 2 tied, 3 too few came; 255 not
  // yet), and that in words: "agreed: 20 for, 3 against; 23 of 24 adults came, 6 needed".
  decided_minute: long (id: 11);
  outcome: ubyte = 255 (id: 12);
  decision: string (id: 13);
  eligible: uint (id: 14);
  quorum: uint (id: 15);
  stances: [StanceLine] (id: 16);
  // How many living people know it.
  known: uint (id: 17);
  // Levies paid, unpayable, kept back and owed by someone who did not know the law; kilograms
  // paid and withheld; asks the store answered and could not, and kilograms given.
  complied: uint (id: 18);
  could_not: uint (id: 19);
  evaded: uint (id: 20);
  unaware: uint (id: 21);
  levied_kg: float (id: 22);
  withheld_kg: float (id: 23);
  relieved: uint (id: 24);
  relief_kg: float (id: 25);
  unanswered: uint (id: 26);
  // Wire 1.28: the one it names (who keeps the store; 0 for none), and their name.
  holder: ulong (id: 27);
  holder_name: string (id: 28);
  // Wire 1.33: for a prohibition (a curfew), the times someone broke it knowing of it, and not.
  broken: uint (id: 29);
  broken_unaware: uint (id: 30);
  // Wire 1.42 (M4c slice AH): levies kept back openly in a faction's refusal (counted in
  // `withheld_kg`; `evaded` counts only those kept back unannounced).
  refused: uint (id: 31);
  // Wire 1.80 (M7c slice BY, ADR-0026 §4): how those who held it or stood to gain by it acted,
  // in the kernel's words: a keeper's drawing and favour, a collector's payments, and a sponsor's
  // gifts before the gathering; absent when there is nothing to tell.
  conduct: string (id: 32);
}

// A settlement's polity (wire 1.27, ADR-0013): its custom in words, its members, its common
// store, the gathering called if any, and every law proposed there, newest first.
table PolityLine {
  polity: ulong (id: 0);
  settlement: ulong (id: 1);
  name: string (id: 2);
  founded_minute: long (id: 3);
  // "The adults who come to the hearth decide by acclamation: …".
  custom: string (id: 4);
  // Adults living there now.
  members: uint (id: 5);
  // What the store holds in words ("grain 322 kg", "nothing"), and its food in kilograms.
  store: string (id: 6);
  store_kg: float (id: 7);
  laws: [LawLine] (id: 8);
  // The gathering called: its law (0 for none), the start of the day it meets and how many
  // have come so far.
  gathering_law: ulong (id: 9);
  gathering_minute: long (id: 10);
  gathering_present: uint (id: 11);
  // Wire 1.28: its offices and who holds them, in words ("Storekeeper: Ada, since 3 May of year
  // 2"), and those vacant ("Storekeeper: vacant since 9 June of year 5, when Ada died").
  offices: [string] (id: 12);
  // Wire 1.29: what it would be called, worked out afterwards from its history and read by
  // nothing in the world (ADR-0013 §6): a name ("Council community"), what qualifies it ("a
  // storekeeper's office", "its levy mostly paid"), the reasons in sentences, and how much
  // evidence stands behind it (0-1, uncalibrated).
  label: string (id: 13);
  label_modifiers: [string] (id: 14);
  label_why: [string] (id: 15);
  label_confidence: float (id: 16);
  // Wire 1.31: the cases the gathering called is to hear, in words ("the household of Rilla's
  // case against Tam"); a gathering may be called on cases alone (`gathering_law` 0).
  gathering_cases: [string] (id: 17);
  // Wire 1.35 (M4c slice AF, ADR-0017 §1): every version of its custom, oldest first, in words
  // rendered by the kernel ("Since 3 May of year 2, the founding custom: …"; "Since 9 June of
  // year 5, by the amendment Ada proposed: the elders of its households …"), and how many its
  // body admits now (`members` counts every adult).
  custom_history: [string] (id: 18);
  body_members: uint (id: 19);
  // Wire 1.40 (M4c slice AH, ADR-0017 §2): its factions, live first, in words rendered by the
  // kernel ("Mira's faction, against the gathering, since 3 May of year 2: 5 members, organized
  // by Mira; its store holds grain 40 kg").
  factions: [string] (id: 20);
  // Wire 1.41 (M4c slice AH, ADR-0017 §3): its petitions, newest first, in words rendered by the
  // kernel ("Mira's faction petitioned the gathering on 3 May of year 2 for an end to the common
  // store's levy: 9 came; the gathering turned it down").
  petitions: [string] (id: 21);
  // Wire 1.42 (M4c slice AH, ADR-0017 §3): its refusals of a levy, newest first, in words rendered
  // by the kernel ("Mira's faction called on its members on 3 May of year 2 to keep back the levy
  // of a common store, taking a tenth of each harvest, until 3 May of year 3: 6 kept back 240 kg").
  refusals: [string] (id: 22);
  // Wire 1.43 (M4c slice AI, ADR-0017 §4): its revolts, newest first, in words rendered by the
  // kernel ("Mira's faction called on everyone on 3 May of year 2 to stand with it: from now on,
  // the elders of its households decide ...; it held on 20 May of year 2, 14 standing with it, 9
  // with the gathering, 2 with neither").
  revolts: [string] (id: 23);
  // Wire 1.45 (M4c slice AI, step three; ADR-0017 §4): its coups, newest first, in words rendered
  // by the kernel ("Bo called on those who keep the watch on 3 May of year 2 to take the deciding
  // with them; it held on 11 May of year 2, 2 of 3 watchers with it, none with the gathering").
  coups: [string] (id: 24);
  // Wire 1.57 (M5c slice AT, ADR-0020 §1): how it stands toward each other lived-in polity, from
  // its own people's side, worked out afterwards and read by nothing in the world.
  relations: [RelationLine] (id: 25);
  // Wire 1.76 (M6c slice BM, ADR-0023 §9): its settlements with how and when, its seat first, in
  // words rendered by the kernel ("Oakholt, its seat, since 3 May of year 1"; "Ashford, taken in
  // on 9 June of year 12 from the polity seated there, by annexation"); and, for a polity whose
  // deciding closed, how ("taken in by Oakholt's polity on 9 June of year 12, by annexation"), or
  // empty while it still decides.
  settlements: [string] (id: 26);
  ended: string (id: 27);
  // Wire 1.77 (M7a slice BQ, ADR-0024 §3): its council's elections, newest first, at most six.
  elections: [ElectionLine] (id: 28);
  // Wire 1.81 (M7c slice BZ, ADR-0026 §5): who each organization by stake with members among its
  // people has come to hold, in sentences rendered by the kernel, never a percentage ("Mira's
  // organization: 3 of the 4 laws passed since it was founded were proposed by its members; ...").
  capture: [string] (id: 29);
}

// One election of a council (wire 1.77, ADR-0024 §3), in words rendered by the kernel: which, when
// and why it was called and for what seats ("Election 2, called on 3 May of year 2 because the
// seats' term was ending: a council of 5, elected by the adults for 360 days"); where it stands
// ("counted and seated on 12 May of year 2"); who came ("31 of the 52 now of the electorate came
// to poll"); each district's seats; the alliances made for it; and each who stood.
table ElectionLine {
  id: uint (id: 0);
  heading: string (id: 1);
  stage: string (id: 2);
  turnout: string (id: 3);
  districts: [string] (id: 4);
  alliances: [string] (id: 5);
  candidates: [CandidateLine] (id: 6);
}

// One who stood (wire 1.77): their district where seats are shared ("" else), where they said
// they stand ("leans for whether to keep a common store"), who backed them ("backed by Mira's
// faction"), the names counted for them and whether they were seated.
table CandidateLine {
  person: ulong (id: 0);
  name: string (id: 1);
  district: string (id: 2);
  told: string (id: 3);
  backed: string (id: 4);
  votes: uint (id: 5);
  seated: bool (id: 6);
}

// One polity's standing toward another (wire 1.57): the other polity and its settlement's name, a
// label ("unknown", "known", "friendly" or "wary") and the reasons in sentences rendered by the
// kernel ("12 of 40 of its adults hold a view of Ashford's polity: 9 believe its people harm
// theirs, 0 that they help them").
table RelationLine {
  polity: ulong (id: 0);
  name: string (id: 1);
  label: string (id: 2);
  why: [string] (id: 3);
  // Wire 1.58 (M5c slice AU, ADR-0020 §6): the agreements between the two, newest first.
  agreements: [AgreementLine] (id: 4);
}

// One agreement between two polities (wire 1.58), in words rendered by the kernel: its terms
// ("leave for Ashford's people to use the places Oakholt claims, for a year"), where it stands
// ("in force since 3 May of year 12"), and each side's law history, this polity's first ("proposed
// by Pirra on 2 May of year 12; passed on 3 May of year 12, 9 for, 2 against, 14 of 30 came").
table AgreementLine {
  id: ulong (id: 0);
  terms: string (id: 1);
  state: string (id: 2);
  ours: string (id: 3);
  theirs: string (id: 4);
  // Wire 1.59 (M5c slice AV): each payment it owed, oldest first, in words ("400 kg of grain
  // from Oakholt's store, owed from 3 May of year 12: 400 kg set aside, 398 kg arrived; met on
  // 9 May of year 12").
  payments: [string] (id: 5);
}

// A siege (wire 1.76, ADR-0023 §7 and §11): a band camped by a shut line, or holding the
// settlement it went to, and each side's food at current use, worked out afterwards and read by
// nothing in the world. Never a progress measure: the kernel keeps no siege record and no timer.
table SiegeLine {
  // The band, the settlement it is of, and the settlement it camps by or holds.
  band: uint (id: 0);
  from: ulong (id: 1);
  at: ulong (id: 2);
  // 4 camped, 5 holding (the band's stage).
  stage: ubyte (id: 3);
  // The band in words, as the map's band brief has it.
  words: string (id: 4);
  // Inside: the food of the households of the place it camps by or holds, and the common store
  // of the polity deciding for it, in days at what their people eat ("its 12 households hold
  // about 38 days of food for 41 people, and the common store 6 days more"), and the days.
  inside: string (id: 5);
  inside_days: float (id: 6);
  // What still comes in or goes out: water and fields by the line ("no open well inside the
  // line: every walk to water goes out through a gate; 18 of its 23 fields lie outside it").
  comes_in: string (id: 7);
  // The band's own food: what those there carry and what it took, in days for those there, and
  // what their households at home hold ("14 there carry about 2 days of food and took 3 days'
  // more; their households at home hold about 50 days").
  band_food: string (id: 8);
  band_days: float (id: 9);
}

table Government {
  minute: long (id: 0);
  polities: [PolityLine] (id: 1);
  // Wire 1.76 (M6c slice BM): every band camped by a shut line or holding a settlement.
  sieges: [SiegeLine] (id: 2);
}

// What happened (the truth layer, ADR-0015 §1): one attempt to take from a household's store.
table IncidentLine {
  id: uint (id: 0);
  minute: long (id: 1);
  // 0 when the household taken from has none.
  settlement: ulong (id: 2);
  actor: ulong (id: 3);
  actor_name: string (id: 4);
  // The household taken from, named for the one who stands for it ("the household of Rilla").
  target: ulong (id: 5);
  target_name: string (id: 6);
  // 0 taken, 1 turned back (someone was home), 2 fled when a sleeper woke.
  outcome: ubyte (id: 7);
  // In words: what was carried off ("12 kg of grain"), or how it ended.
  what: string (id: 8);
  kcal: float (id: 9);
  // Who saw the taker at it.
  seen_by: [string] (id: 10);
  // Wire 1.32: what the one who keeps the watch did with it, if they saw it, in words ("Bram,
  // keeping watch, saw it and said nothing for 9 kg of grain"), or empty. The truth: nobody in
  // the world reads it.
  watch: string (id: 11);
}

// What people believe of one incident, and what was chosen (the knowledge layer).
table KnownLine {
  incident: uint (id: 0);
  // Living people who believe they know who took, and who know only of a loss.
  know_taker: uint (id: 1);
  know_loss: uint (id: 2);
  // Distinct first-hand accounts behind what they believe (one witness repeated is one).
  sources: uint (id: 3);
  // Someone of the household taken from knows who took.
  victim_knows: bool (id: 4);
  // What the household taken from chose, in words, or empty.
  response: string (id: 5);
  // Where what is owed for it stands, in words, or empty.
  owed: string (id: 6);
  // Wire 1.31: the case brought for it and how the gathering decided, in words, or empty
  // ("Rilla brought it before the gathering on 4 May, on the word of 1 witness; the gathering
  // found that Tam took: 12 for, 3 against, 20 of 41 adults came"). What the polity knows.
  case: string (id: 7);
}

table Order {
  minute: long (id: 0);
  // The most recent incidents, newest first (at most 60), and what is believed of each.
  incidents: [IncidentLine] (id: 1);
  known: [KnownLine] (id: 2);
  // Totals over every incident there has been.
  attempts: uint (id: 3);
  takings: uint (id: 4);
  seen: uint (id: 5);
  known_to_victims: uint (id: 6);
  demands: uint (id: 7);
  met: uint (id: 8);
  refused: uint (id: 9);
  // Asks refused because the giver believed the asker took, since the world was loaded.
  refusals: ulong (id: 10);
  // Wire 1.31: cases brought before the gathering, and how they ended.
  cases: uint (id: 11);
  found: uint (id: 12);
  not_found: uint (id: 13);
  unheard: uint (id: 14);
  // Wire 1.46 (M4c slice AI, step four): watchers come to take what a refused finding owed,
  // newest first, each in words rendered by the kernel: who came, who met them how, what was taken
  // and every blow struck, by whom, to whom, and what it did (research 06-10 §4.C).
  encounters: [string] (id: 15);
  // Wire 1.79 (M7b slice BU, ADR-0025): cases settled and withdrawn, challenges of laws under
  // limits and the laws they struck down, and the latest cases and challenges in the kernel's
  // words, newest first (at most 20): who brought what before whom, how it closed and when.
  settled: uint (id: 16);
  withdrawn: uint (id: 17);
  challenges: uint (id: 18);
  struck_down: uint (id: 19);
  case_lines: [string] (id: 20);
}

// ---- Incidents (wire 1.64, M6a slice BB, ADR-0015 §8) ---------------------------------------
//
// Every kind of incident in one shape, its three layers kept apart and each in the kernel's
// words: what happened (the kernel's truth, which nobody in the world reads), what people know
// (beliefs and word with their sources) and what the polity knows and did (its cases and laws).
// A layer with nothing in it says so; it is never filled from the truth.

table IncidentRow {
  // 1 a taking, 2 a case of illness, 4 a building's fire (wire 1.68).
  kind: ubyte (id: 0);
  // Its number among incidents of its kind.
  id: uint (id: 1);
  // When it began: a taking to the minute, an infection to the day (its midnight).
  minute: long (id: 2);
  // The settlement it belongs to (0 for none).
  settlement: ulong (id: 3);
  // Where it happened, metres: the home taken from, the home of the one who took ill, or the
  // building that burned.
  at: Vec2 (id: 4);
  // Whom the words begin with: the one who went to take, or the one who took ill; for a fire,
  // the building (its permanent id) and its name, "The hut of Wren's household".
  who: ulong (id: 5);
  who_name: string (id: 6);
  // What happened, after the name: "took 12 kg of grain from the household of Rilla on 4 May of
  // year 3; seen by Bram", "took cholera on 3 May of year 2 in water drawn at Bo's household's
  // well; ill 4 days, severely; died on 7 May of year 2".
  happened: string (id: 7);
  // What people know: "5 believe they know who took, from 1 account", "Known to 12 people as
  // sickness in Bo's household, from 1 first-hand account", "Nobody knows of it".
  known: string (id: 8);
  // What the polity knows and did: the case brought for it, or the law that names its source;
  // "No gathering was told of it" when nothing.
  polity: string (id: 9);
  // The observer's influence that started it, by number (0: none): a case of an outbreak whose
  // first case the observer brought counts as the observer's.
  observer: uint (id: 10);
  // The outbreak it is part of, by number (0: none).
  outbreak: uint (id: 11);
  // Whether it still runs: an infection not yet over, a fire still burning.
  open: bool (id: 12);
  // Wire 1.68: the conflagration a fire is part of, by number (0: none).
  conflagration: uint (id: 13);
  // Wire 1.69: the flood episode high water is part of, by number (0: none).
  flood: uint (id: 14);
  // Wire 1.69: the storm episode damage is part of, by number (0: none).
  storm: uint (id: 15);
}

// How many incidents of a kind there are, in the scope asked: all of them (the kernel's truth),
// those someone in the world knows of, those before a polity, and those the observer started.
table IncidentTotal {
  kind: ubyte (id: 0);
  all: uint (id: 1);
  known: uint (id: 2);
  polity: uint (id: 3);
  observer: uint (id: 4);
}

// An outbreak (ADR-0021 §5): the episode its cases are part of.
table OutbreakRow {
  id: uint (id: 0);
  // The disease's name.
  disease: string (id: 1);
  settlement: ulong (id: 2);
  // The day it began and the day it was over, as minutes (ended -1 while it runs).
  began: long (id: 3);
  ended: long (id: 4);
  // Those who took it, those who fell ill and those who died of it.
  took: uint (id: 5);
  ill: uint (id: 6);
  died: uint (id: 7);
  // The observer's influence that began it, by number (0: none).
  observer: uint (id: 8);
  // In words: "Cholera at Hazelford, from 3 May of year 2: 14 took it, 9 fell ill, 2 died; it
  // runs".
  words: string (id: 9);
}

// A conflagration (wire 1.68, ADR-0022 §13): fires caught from one another.
table ConflagrationRow {
  id: uint (id: 0);
  settlement: ulong (id: 1);
  // When its first fire caught, and when its last burnt out, as minutes (ended -1 while it
  // burns).
  began: long (id: 2);
  ended: long (id: 3);
  // The buildings it burned, those who died in it, and the goods it burned, kilograms.
  burned: uint (id: 4);
  died: uint (id: 5);
  goods_kg: float (id: 6);
  // The observer's influence that set its first fire, by number (0: none).
  observer: uint (id: 7);
  // In words: "A fire at Hazelford from 02:14 on 3 May of year 2 to 03:20: it burned 7
  // buildings; Ada died; 340 kg of goods burned".
  words: string (id: 8);
}

// A flood episode (wire 1.69, ADR-0022 §13): reaches above bankfull over buildings or fields.
table FloodRow {
  id: uint (id: 0);
  reach: uint (id: 1);
  settlement: ulong (id: 2);
  began: long (id: 3);
  ended: long (id: 4);
  peak_discharge_m3s: float (id: 5);
  peak_depth_m: float (id: 6);
  buildings_flooded: uint (id: 7);
  fields_submerged: uint (id: 8);
  spoiled_kg: float (id: 9);
  observer: uint (id: 10);
  words: string (id: 11);
}

// A storm episode (wire 1.69, ADR-0022 §13): windstorm damaging buildings.
table StormRow {
  id: uint (id: 0);
  settlement: ulong (id: 1);
  began: long (id: 2);
  ended: long (id: 3);
  peak_wind_speed_ms: float (id: 4);
  buildings_damaged: uint (id: 5);
  observer: uint (id: 6);
  words: string (id: 7);
}

table Incidents {
  minute: long (id: 0);
  // Newest first.
  rows: [IncidentRow] (id: 1);
  // Where the next page begins; absent when this page is the last.
  next: IncidentKey (id: 2);
  // One for each kind, over all time in the scope asked.
  totals: [IncidentTotal] (id: 3);
  // Every outbreak in the scope asked, newest first.
  outbreaks: [OutbreakRow] (id: 4);
  // Wire 1.68: every conflagration in the scope asked, newest first.
  conflagrations: [ConflagrationRow] (id: 5);
  // Wire 1.69: every flood in the scope asked, newest first.
  floods: [FloodRow] (id: 6);
  // Wire 1.69: every storm in the scope asked, newest first.
  storms: [StormRow] (id: 7);
}

// A step in an incident's chain (12-07 §1.1): it began, was seen, was told, was answered, ended.
table IncidentStep {
  // "Took it", "Fell ill", "Seen", "Told", "Before the gathering", "Ended".
  label: string (id: 0);
  // When, as a minute (-1 when not reached or not recorded).
  minute: long (id: 1);
  // 0 reached, 1 not reached, 2 not recorded.
  state: ubyte (id: 2);
  // Known only to the day: the observer shows the day, never an hour.
  by_day: bool (id: 3);
  // What the step was, in words: "by Bram and Ada", "by their household".
  words: string (id: 4);
}

// A typed link, recorded when it happened (15-02 §1.1): never inferred from time.
table IncidentLink {
  // 0 caused_by, 1 part_of, 2 responded_to.
  relation: ubyte (id: 0);
  // What it points at: 0 an influence of the observer, 1 a person, 2 a household, 3 a source of
  // water, 4 an outbreak, 5 a taking, 6 a case of illness; wire 1.68: 7 a building's fire, 8 a
  // conflagration, 9 a building.
  target: ubyte (id: 1);
  id: ulong (id: 2);
  // In words: "brought by the observer (one recorded influence)", "part of the outbreak of
  // cholera at Hazelford", "caught in water drawn at Bo's household's well".
  words: string (id: 3);
}

table IncidentInfo {
  row: IncidentRow (id: 0);
  steps: [IncidentStep] (id: 1);
  links: [IncidentLink] (id: 2);
  // Each layer in lines, kept apart.
  truth: [string] (id: 3);
  knowledge: [string] (id: 4);
  polity: [string] (id: 5);
}

// A source of water an outbreak's cases drank from, or one people suspect, with what the kernel
// recorded beside what people know and what the polity did.
table OutbreakSource {
  // "Bo's household's well", "the river", "the spring near Ada's household's home".
  name: string (id: 0);
  // Cases that took it in water drawn there.
  cases: uint (id: 1);
  // The truth: who drew there and who fell ill among them and among the rest; what fouled it.
  truth: [string] (id: 2);
  // What people hold: who suspects it, since when, on what counts.
  knowledge: [string] (id: 3);
  // What the polity did: the laws that would close it, and how each was decided.
  polity: [string] (id: 4);
}

table OutbreakInfo {
  row: OutbreakRow (id: 0);
  // How it began, in words: "Began with Ada, brought cholera by the observer, as if they took it
  // elsewhere (one recorded influence)".
  cause: string (id: 1);
  // The first case's own link: the observer's influence, a household or a source.
  cause_link: IncidentLink (id: 2);
  // Cases by day from the day it began: those who took it, and those who fell ill.
  start: long (id: 3);
  took: [ushort] (id: 4);
  onset: [ushort] (id: 5);
  // How its cases took it, in words: "9 in water drawn at Bo's household's well", "4 at home",
  // "1 brought by the observer".
  routes: [string] (id: 6);
  sources: [OutbreakSource] (id: 7);
  // Its cases, newest first, at most the limit asked.
  members: [IncidentRow] (id: 8);
  members_total: uint (id: 9);
}

// A conflagration's page (wire 1.68, ADR-0022 §13): how it began, its fires in the order they
// caught (each row's page says what it caught from), and the buildings its heat reached that
// held, with the most heat each stood against what its covering needed.
table ConflagrationInfo {
  row: ConflagrationRow (id: 0);
  // "Began at the hut of Wren's household, set alight by the observer (one recorded influence)".
  cause: string (id: 1);
  cause_link: IncidentLink (id: 2);
  // The day's wind and dryness when it began, in words.
  weather: string (id: 3);
  // Its fires, the first first.
  fires: [IncidentRow] (id: 4);
  // "The hut of Bo's household, 6 m from it: its heat rose to 7 kW/m² against the 11 its thatch
  // needed", the nearest first.
  held: [string] (id: 5);
}

// A flood episode's page (wire 1.69, ADR-0022 §13): peak discharge, reaches, flooded buildings and fields.
table FloodInfo {
  row: FloodRow (id: 0);
  cause: string (id: 1);
  cause_link: IncidentLink (id: 2);
  weather: string (id: 3);
  incidents: [IncidentRow] (id: 4);
  summary: [string] (id: 5);
}

// A storm episode's page (wire 1.69, ADR-0022 §13): wind speed, damaged buildings.
table StormInfo {
  row: StormRow (id: 0);
  cause: string (id: 1);
  cause_link: IncidentLink (id: 2);
  weather: string (id: 3);
  incidents: [IncidentRow] (id: 4);
  summary: [string] (id: 5);
}

// A source of water as one home stands to it (wire 1.66).
table CoverageSource {
  // "Bo's household's well", "a spring", "the water's edge".
  name: string (id: 0);
  at: Vec2 (id: 1);
  // How the home stands to it: 1 its own well, 2 a well its people may draw at by right (their
  // polity's or their kin's), 3 another's well, 4 a spring, 5 the water's edge.
  kind: ubyte (id: 2);
  // Walking minutes from the home on the walking grid; negative when not within the search.
  minutes: float (id: 3);
  // For *did come*: on how many days of the period its people drew there.
  days: ushort (id: 4);
}

// Wire 1.71: one read-only current probe and realized help, never a dispatch order.
table FireHelp {
  adults_now: uint (id: 0);
  nearest_walk_min: float = -1 (id: 1);
  unknown_routes: uint (id: 2);
  water_available: bool (id: 3);
  fire_episodes: uint (id: 4);
  helped_episodes: uint (id: 5);
  helpers: uint (id: 6);
  water_l: float (id: 7);
  first_work_min: float = -1 (id: 8);
  observer_episodes: uint (id: 9);
}

// One home and the water it could reach and did come for.
table CoverageHome {
  household: ulong (id: 0);
  // "Bo's household".
  name: string (id: 1);
  at: Vec2 (id: 2);
  settlement: ulong (id: 3);
  // Could reach: the nearest source of any kind; none when there is none within the search.
  nearest: CoverageSource (id: 4);
  // The nearest its people may draw at by right, when that is not the nearest.
  by_right: CoverageSource (id: 5);
  // Did come: where its people drew water in the period, most days first.
  drew: [CoverageSource] (id: 6);
  // Both, in words.
  words: [string] (id: 7);
  fire_help: FireHelp (id: 8);
}

// A lens's homes, with what the lens shows and over what (15-01 §3.1: title, scope, period,
// denominator), and its counts in words.
table Coverage {
  lens: ubyte (id: 0);
  title: string (id: 1);
  scope: string (id: 2);
  // Each layer's period: *could reach*'s, then *did come*'s.
  periods: [string] (id: 3);
  denominator: string (id: 4);
  homes: [CoverageHome] (id: 5);
  // The search's furthest walk, minutes: beyond it a home's nearest water is unknown.
  limit_min: float (id: 6);
  // The period of *did come*, days.
  days: ushort (id: 7);
  // Each layer's counts in words: "Could reach: of 42 homes, 30 have water within a minute's
  // walk, ...", "Did come: ...".
  summary: [string] (id: 8);
}

union ResponseBody { Ack, RasterTile, Hydrography, SaveList, Trips, PersonInfo, Chronicle, Fields, Buildings, Paths, Markets, Firms, FirmInfo, Wealth, Knowledge, Deposits, Earthworks, WeatherReport, Standing, Government, Order, Crossings, Water, Incidents, IncidentInfo, OutbreakInfo, Coverage, ConflagrationInfo, FloodInfo, StormInfo }

table Response {
  body: ResponseBody (id: 1);
}

table ErrorInfo {
  code: ErrorCode (id: 0);
  message: string (id: 1);
}
